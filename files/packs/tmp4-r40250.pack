# =============================================================
#  PACK PROFILE — [40250] Reference Serverfile by TMP4
#
#  This file is SOURCED by install.sh, so it must contain NOTHING
#  but variable assignments and function definitions. No output,
#  no downloads, no mkdir — the installer sources every pack it
#  finds just to read the metadata below. See PACKS.md.
#
#  What these server files are: a reconstruction of the official
#  Metin2 r40250 files that leaked in early 2014. No added systems,
#  only bug fixes. Server + full C++ source in one tarball, a
#  MariaDB 10.6 data directory, and a 1.29 GB Windows client.
# =============================================================

PACK_ID="tmp4-r40250"
PACK_NAME="[40250] Reference Serverfile (TMP4)"
PACK_DESC="FreeBSD 13.5+ / MariaDB 10.11 — official 2014 r40250 rebuild, 4 channels x 3 cores"
# What players see in the client's server list. PACK_NAME stays the technical
# name of these server files; this is the name of the SERVER built from them.
PACK_SERVER_NAME="Singleplayer Official Metin2"

# No third-party archive is a project default. Operators supply their own
# compatible r40250 package or an explicit URL they are authorised to use.
PACK_URL=""

# The database password these files ship with. It is NOT a secret: it is printed
# in the pack's own Readme and sits inside metin2_mysql.tar.gz, which anyone can
# download. The installer replaces it everywhere with a strong generated one.
# These files ship TWO different factory passwords and it matters which goes here.
# The engine uses PACK_OLD_DB_PASS to log into MySQL as **root** and rotate it, and
# Readme.txt says "MySQL: root/123456789". The word "password" is a different
# thing entirely — it belongs to the 'metin2' account the game cores use, and it
# lives in P_CFG_OLD_PW below. Putting "password" here makes the root rotation fail
# and the panel then cannot reach the database at all.
# NOTE: this value belongs to the shipped DATA DIRECTORY, which pack_deploy_db no
# longer installs (see the long note above pack_deploy_db). On the normal route —
# importing the .sql dumps — MySQL root starts out with NO password at all, and
# pack_deploy_db itself sets it to $DB_PASS before the engine's rotation step
# runs. It is kept here for the documented metin2_mysql.tar.gz fallback, and
# because the engine happily tries it and moves on when it does not fit.
PACK_OLD_DB_PASS="123456789"

# The factory password of the 'metin2' account, as it appears in every CONFIG and
# in db/conf.txt. Only used to check nothing was missed after the rewrite.
P_CFG_OLD_PW="password"

# ---- optional pack settings the engine understands -----------------
# FAQ.txt asks for MariaDB 10.6, because the data directory it ships in
# metin2_mysql.tar.gz is a 10.6 data directory and nothing newer can open it.
# That version is gone from the FreeBSD 14 package repository — it only carries
# 10.11, 11.4, 11.8 and 12.3 (verified on a real 14.4 box, where asking for
# mariadb106 fails with "No packages available").
# This is NOT a problem, because pack_deploy_db no longer uses that data
# directory: it imports metin2_mysql_dump.zip into a data directory that the
# installed MariaDB creates itself, exactly as the dump's own Readme describes.
# The dumps are pure MyISAM, so any modern MariaDB takes them. 10.11 is simply
# the most conservative version pkg still offers.
PACK_DB_PKGS="mariadb1011-server mariadb1011-client"
# make.py (the quest compiler) is Python 2 only — see pack_install_quest.
PACK_PKGS="python27"
# The game cores do not log into MySQL as root. They use a separate account
# called 'metin2' (Readme: "MySQL: root/123456789", CONFIG: user metin2).
PACK_GAME_DB_USER="metin2"
# The name players see on the panel's download button.
PACK_CLIENT_NAME="40250 - Official 2014 Client (15 Languages)"

# ┌───────────────────────────────────────────────────────────────────────────┐
# │  ⚠  NEVER ADD A 'z' TO ANY tar COMMAND IN THIS FILE  ⚠                    │
# │                                                                           │
# │  These archives really are gzip today, but server packs are notorious for │
# │  shipping bzip2 (or zstd) data under a ".tar.gz" name, and the moment a    │
# │  re-upload does that, "tar -xzf" breaks every single install. Plain        │
# │  "tar -xf" lets FreeBSD's bsdtar sniff the real format, so it copes with   │
# │  whatever actually arrives. Leave it as it is — and prefer untar_to,       │
# │  which also creates the destination and reports the real error.           │
# └───────────────────────────────────────────────────────────────────────────┘

# ---------------------------------------------------------------
#  The port map (read out of the CONFIG files themselves)
# ---------------------------------------------------------------
#   auth            PORT 11000   P2P 12000
#   db              BIND_PORT 15000                (db/conf.txt)
#   channel1 first  PORT 13000   P2P 14000   <- the port players connect to
#            game1  PORT 13001   P2P 14001
#            game2  PORT 13002   P2P 14002
#   channel2 first  PORT 13010 … game1 13011 … game2 13012
#   channel3 first  PORT 13020 … game1 13021 … game2 13022
#   channel4 first  PORT 13030 … game1 13031 … game2 13032
#   game99          PORT 13099   P2P 14099        (special-purpose core)
#
#   So: channel N's "first" port is 13000 + (N-1)*10, and the client's own
#   serverinfo.py agrees (PORT_1=13000 PORT_2=13010 PORT_3=13020 PORT_4=13030).
#   Every core talks to the db core on 127.0.0.1:15000.
P_AUTH_PORT=11000
P_DB_PORT=15000
P_GAME99_PORT=13099

# p_ch_port CHANNEL_NUMBER -> the TCP port of that channel's "first" core
p_ch_port() { echo $(( 13000 + ( ${1:-1} - 1 ) * 10 )); }

# ---------------------------------------------------------------
#  Finding the pieces inside the extracted archive
# ---------------------------------------------------------------
# The folder we are handed looks like this:
#   Readme.txt  FAQ.txt  Languages.txt  Changelog.txt
#   Client/Client.zip          <- the Windows client players download (1.29 GB)
#   Client/ClientVS22.zip      <- the client's C++ SOURCE. Players must NEVER get
#                                 this: it is what someone would use to build a
#                                 cheat client against this exact server.
#   Server/metin2_server+src.tar.gz   <- server AND server source in one archive
#   Server/metin2_mysql.tar.gz        <- a ready MariaDB 10.6 data directory
#   Server/metin2_mysql_dump.zip      <- the same database as plain .sql dumps
#   Server/Extensions.zip             <- optional add-ons, not used here
pack_locate() {
    # --- the server ---------------------------------------------------------
    # Note the file is called metin2_server+src.tar.gz. A '+' is a perfectly
    # ordinary character in a shell glob, so a plain wildcard finds it.
    find_or_ask "the server archive (metin2_server+src.tar.gz)" "*server*.tar.gz" "$EX" f \
        && GAME_TGZ="$FOA" || GAME_TGZ=""

    # There is NO separate source archive in this pack: metin2_server+src.tar.gz
    # unpacks BOTH /usr/metin2/server (the runtime) and /usr/metin2/src (the full
    # C++ source). So the source archive IS the game archive, and SOURCE_TGZ is
    # pointed at the very same file.
    #
    # This is not cosmetic. The engine only offers the optional "instant in-game
    # actions" rebuild when SOURCE_TGZ is non-empty, and it is the ONLY thing that
    # ever calls pack_patch_source. This used to be left empty on purpose, back
    # when we believed TMP4's FAQ that the source needs a 32-bit jail. It does not
    # (see the long note above pack_patch_source — the build was done on a real
    # amd64 FreeBSD 14.4 box), so the offer is made again.
    #
    # Nothing unpacks it twice: this pack overrides pack_deploy_game and extracts
    # GAME_TGZ once. SOURCE_TGZ is only ever read by the engine as a yes/no flag
    # for that one question.
    SOURCE_TGZ="$GAME_TGZ"

    # --- the database -------------------------------------------------------
    # The same database ships TWICE, and which copy we use decides whether this
    # install works at all:
    #
    #   metin2_mysql_dump.zip  plain .sql dumps + a Readme describing the import.
    #                          THIS is the one we use. See pack_deploy_db.
    #   metin2_mysql.tar.gz    a snapshot of a running MariaDB 10.6 data
    #                          directory. Documented fallback only — it cannot be
    #                          opened by any MariaDB that FreeBSD 14 still ships.
    #
    # The dump is looked for FIRST so that it is the one a user gets asked about
    # if the download is incomplete.
    find_or_ask "the MariaDB SQL dump (metin2_mysql_dump.zip)" "*mysql*dump*.zip" "$EX" f \
        && MYSQL_DUMP_ZIP="$FOA" || MYSQL_DUMP_ZIP=""

    # CAREFUL: the obvious pattern "mysql*.tar.gz" does NOT match this pack —
    # the file is metin2_mysql.tar.gz, so the name has to be matched loosely.
    # Not being able to find this one is no longer fatal: it is only the fallback.
    MYSQL_TGZ=$(find_one "*mysql*.tar.gz" "$EX" f)

    # --- the client ---------------------------------------------------------
    # The client is shipped as a ready zip, not as a folder full of files, so
    # there is no .exe on disk to point CLIENT_EXE at. We hand the engine the
    # zip itself: all it does with CLIENT_EXE is check whether a client exists
    # at all and print its name, and pack_prepare_client below does the rest.
    # The 'vs22' filter is the important part — ClientVS22.zip is the client
    # SOURCE CODE and must never end up in a player download.
    P_CLIENT_ZIP=$(find "$EX" -type f -iname '*.zip' 2>/dev/null \
                   | grep -iv 'vs22' \
                   | grep -iE '/client[^/]*\.zip$' \
                   | awk -F/ '{print NF "\t" $0}' | sort -n | cut -f2- | head -1)
    if [ -z "$P_CLIENT_ZIP" ]; then
        # second try: any zip that lives in a folder called Client/
        P_CLIENT_ZIP=$(find "$EX" -type f -iname '*.zip' 2>/dev/null \
                       | grep -iv 'vs22' | grep -i '/client/' | head -1)
    fi
    CLIENT_EXE="${P_CLIENT_ZIP:-}"
    CLIENT_DIR=""
    [ -n "$P_CLIENT_ZIP" ] && CLIENT_DIR=$(dirname "$P_CLIENT_ZIP")
    return 0
}

# ---------------------------------------------------------------
#  Preflight — one line per missing REQUIRED piece, non-zero to abort
# ---------------------------------------------------------------
# The client is optional: without it the server runs perfectly, players just
# have to get the client somewhere else. So it only earns a warning.
pack_preflight() {
    p_missing=""
    [ -z "${GAME_TGZ:-}" ]  && p_missing="${p_missing}    • server archive (metin2_server+src.tar.gz)
"
    # Either form of the database will do, so this only counts as missing when
    # BOTH are absent. If only the tarball is here we can still limp along the
    # fallback path, and pack_deploy_db says so loudly at the time.
    if [ -z "${MYSQL_DUMP_ZIP:-}" ] && [ -z "${MYSQL_TGZ:-}" ]; then
        p_missing="${p_missing}    • the database (metin2_mysql_dump.zip, or metin2_mysql.tar.gz)
"
    elif [ -z "${MYSQL_DUMP_ZIP:-}" ]; then
        warn "metin2_mysql_dump.zip was not found — only the old MariaDB 10.6 data"
        warn "directory is available, and that one does not open on FreeBSD 14."
    fi
    if [ -z "${P_CLIENT_ZIP:-}" ]; then
        warn "Client.zip was not found — the server will still run, but the panel"
        warn "will have no ready-to-download client for your players."
    fi
    [ -z "$p_missing" ] && return 0
    printf '%s' "$p_missing"
    return 1
}

# ---------------------------------------------------------------
#  The database  —  metin2_mysql_dump.zip into a native data directory
# ---------------------------------------------------------------
# We import the .sql dumps. We do NOT unpack the shipped data directory, and
# that is the entire point of this hook.
#
# metin2_mysql.tar.gz is a snapshot of a *running* MariaDB 10.6 server, so its
# InnoDB redo log is dirty and only 10.6 or 10.7 is allowed to replay it. Drop it
# into /var/db/mysql on FreeBSD 14 and MariaDB refuses to come up at all:
#
#   [ERROR] InnoDB: Upgrade after a crash is not supported. The redo log was
#           created with MariaDB 10.6.21. You must start up and shut down
#           MariaDB 10.7 or earlier.
#   [ERROR] Unknown/unsupported storage engine: InnoDB
#   [ERROR] Aborting
#
# and there is no way out of that on this OS, because FreeBSD 14 does not package
# MariaDB 10.6 any more — pkg carries 10.11, 11.4, 11.8 and 12.3 and nothing
# older (verified on a real 14.4 box). With no database the whole install then
# collapses: no password rotation, no secured admin accounts, no panel.
#
# The pack's own FAQ has been saying so all along:
#   "Note: metin2_mysql.tar.gz provided but please don't use it, that's
#    unprofessional way. It will only work if you unpack it for MariaDB 10.6.
#    Better to use the provided mysql dump."
#
# So we do what metin2_mysql_dump.zip's own Readme.txt prescribes, in its order:
#   1. create account, common, player, log AND hotbackup
#      ("Yes, don't forget hotbackup, it's needed even if empty..")
#   2. import one .sql file into each
#   3. create the 'metin2' user with all privileges
#   4. sql_mode = NO_ENGINE_SUBSTITUTION, or everything is DATA TRUNCATED
#
# All 72 tables in those dumps are MyISAM — there is no InnoDB anywhere in the
# game schema — so a data directory freshly initialised by ANY modern MariaDB
# holds them perfectly. That is what makes this route version-proof and the data
# directory route a dead end.

# ---- values used by the hook below (assignments only, nothing runs here) -----
# The shipped data directory's db.opt files say latin1 / latin1_swedish_ci for
# all five schemas, and every CREATE TABLE in the dumps carries its own charset,
# so creating the databases with exactly that default keeps new tables (the
# panel's web_admin_* ones) in the same charset as the game's own.
P_DB_CHARSET="DEFAULT CHARACTER SET latin1 COLLATE latin1_swedish_ci"
# Throwaway credentials file for the phase where MySQL root has no password yet.
P_DB_CNF=/root/.m2-r40250-db.cnf

# ---------------------------------------------------------------
#  Talking to a MariaDB whose root password we do not know yet
# ---------------------------------------------------------------
# The engine's db_exec/db_query always log in as root with a password, which is
# the right tool AFTER pack_deploy_db has set one — and everything downstream
# (pack_apply_db_password, pack_secure_admin_accounts, the panel) uses them.
# During the import there is no password yet: a MariaDB that has just created its
# own data directory starts with an EMPTY root password, and on FreeBSD
# root@localhost is usually on the unix_socket plugin as well. PACK_OLD_DB_PASS
# does not apply here at all — it belongs to the shipped data directory we are
# deliberately not using. Hence these few direct mysql calls.
# They are only acceptable because of how they are written: the password (empty
# or not) always goes into a 0600 options file that is deleted immediately, never
# onto a command line where every user on the box could read it out of ps.

p_db_cnf_write() { # p_db_cnf_write PASSWORD -> 0600 [client] file for the socket
    p_db_q=$(printf '%s' "${1:-}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')  # my.cnf quoting
    rm -f "$P_DB_CNF"
    ( umask 077
      printf '[client]\nuser=root\npassword="%s"\nprotocol=socket\n' "$p_db_q" > "$P_DB_CNF" )
}

p_db_sql() { # p_db_sql PASSWORD SQL -> run a statement batch as root, 0 on success
    p_db_cnf_write "$1"
    printf '%s\n' "$2" | "${P_MYSQL:-mysql}" --defaults-extra-file="$P_DB_CNF" >>"$LOG" 2>&1
    p_db_rc=$?; rm -f "$P_DB_CNF"; return $p_db_rc
}

p_db_val() { # p_db_val PASSWORD SQL -> echo the result rows (tab separated)
    p_db_cnf_write "$1"
    printf '%s\n' "$2" | "${P_MYSQL:-mysql}" --defaults-extra-file="$P_DB_CNF" -N -B 2>>"$LOG"
    p_db_rc=$?; rm -f "$P_DB_CNF"; return $p_db_rc
}

p_db_import() { # p_db_import PASSWORD DBNAME FILE -> load one dump file
    # The dump is PIPED from the file. player.sql is 1.2 MB and reading that into
    # a shell variable would mangle every NUL and backslash in it.
    p_db_cnf_write "$1"
    "${P_MYSQL:-mysql}" --defaults-extra-file="$P_DB_CNF" "$2" < "$3" >>"$LOG" 2>&1
    p_db_rc=$?; rm -f "$P_DB_CNF"; return $p_db_rc
}

# p_db_up -> 0 while mariadbd answers on the local socket.
# "Access denied" counts as up on purpose: it proves the server is listening,
# which is the only thing this test is for. We may not know the password.
p_db_up() {
    p_db_out=$("${P_MYSQL:-mysql}" --protocol=socket -u root -N -B -e 'SELECT 1;' 2>&1)
    [ $? -eq 0 ] && return 0
    case "$p_db_out" in
        *"Access denied"*) return 0 ;;
    esac
    return 1
}

p_db_wait_up() { # p_db_wait_up SECONDS -> 0 once the server accepts connections
    p_db_i=0
    while [ "$p_db_i" -lt "${1:-40}" ]; do
        p_db_up && return 0
        sleep 2
        p_db_i=$((p_db_i + 2))
    done
    p_db_up
}

# p_db_find_root_pw -> sets P_DB_ROOTPW to a password that actually logs in.
# Order matters: our own previous run first, then the empty password of a
# freshly initialised server, and only then the pack's factory password (which
# can only ever fit the shipped data directory).
p_db_find_root_pw() {
    P_DB_ROOTPW=""
    for p_db_try in "${DB_PASS:-}" "" "${PACK_OLD_DB_PASS:-}"; do
        if p_db_sql "$p_db_try" "SELECT 1;"; then
            P_DB_ROOTPW="$p_db_try"
            return 0
        fi
    done
    return 1
}

p_db_tables_in() { # p_db_tables_in SCHEMA -> how many tables that schema holds
    p_db_n=$(p_db_val "$P_DB_ROOTPW" \
        "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA='$(sql_escape "$1")';" \
        2>/dev/null)
    case "${p_db_n:-x}" in *[!0-9]*) p_db_n=0 ;; esac
    printf '%s' "$p_db_n"
}

# ---------------------------------------------------------------
#  The my.cnf settings — written BEFORE anything starts
# ---------------------------------------------------------------
# Both FAQ.txt and the dump's own Readme.txt insist on the sql_mode line:
#   "It is highly recommended to modify sql_mode to NO_ENGINE_SUBSTITUTION
#    ... or you will have DATA TRUNCATED errors."
# The r40250 cores write values that the modern STRICT_TRANS_TABLES default
# rejects outright, and the symptom is items and characters silently failing to
# save. FreeBSD's my.cnf ends in "!includedir conf.d/", so the safe way to set it
# is a small extra file — the packaged my.cnf stays as the port shipped it and a
# future pkg upgrade cannot fight us over it.
p_db_tune_cnf() {
    p_cnfdir=/usr/local/etc/mysql/conf.d
    p_maincnf=$(find /usr/local/etc/mysql /usr/local/etc /etc/mysql -maxdepth 1 -type f -name 'my.cnf' 2>/dev/null | head -1)
    if [ -d "$p_cnfdir" ] || mkdir -p "$p_cnfdir" 2>/dev/null; then
        { printf '# written by the Metin2 installer for the [40250] server files\n'
          printf '[mysqld]\n'
          printf 'sql_mode = NO_ENGINE_SUBSTITUTION\n'
        } > "$p_cnfdir/m2-r40250.cnf" 2>>"$LOG" \
            && ok "sql_mode set to NO_ENGINE_SUBSTITUTION (prevents 'DATA TRUNCATED' errors)" \
            || warn "Could not write $p_cnfdir/m2-r40250.cnf — set sql_mode=NO_ENGINE_SUBSTITUTION by hand"
        # If the main my.cnf does not read conf.d at all our file would be ignored,
        # so in that case append the setting straight into it. Repeating a
        # [mysqld] header at the end of an option file is legal and harmless.
        if [ -n "$p_maincnf" ] && ! grep -q 'includedir' "$p_maincnf" 2>/dev/null; then
            grep -q 'sql_mode' "$p_maincnf" 2>/dev/null \
                || printf '\n[mysqld]\nsql_mode = NO_ENGINE_SUBSTITUTION\n' >> "$p_maincnf" 2>>"$LOG"
        fi
    else
        warn "No MariaDB conf.d directory — add 'sql_mode = NO_ENGINE_SUBSTITUTION' to my.cnf yourself"
    fi

    # Keep MariaDB on localhost. The panel and the game cores all connect over
    # 127.0.0.1, so nothing needs the database exposed to the internet.
    CNF=$(find /usr/local/etc/mysql /etc/mysql /usr/local/etc -type f -iname 'server.cnf' 2>/dev/null | head -1)
    [ -n "$CNF" ] && grep -q bind-address "$CNF" && run sed -i '' 's/^bind-address.*/bind-address = 127.0.0.1/' "$CNF"
    return 0
}

# ---------------------------------------------------------------
#  Clearing a data directory MariaDB cannot open — the dangerous step
# ---------------------------------------------------------------
# There is exactly one caller and exactly one situation: we hold the unpacked
# .sql dumps, we are about to import them, and MariaDB has already been asked to
# start and refused. On a retry that is almost always the poisoned 10.6 data
# directory a previous run of this installer unpacked.
#
# Getting this wrong destroys somebody's server, so four rules bound it:
#
#   1. It never runs unless the dumps are unpacked and verified on disk. No
#      dump -> this function is not even reached.
#   2. It never runs while MariaDB is up. If the server starts, the data
#      directory is usable and we import into it as it stands; and if it starts
#      AND the 'player' schema has tables, pack_deploy_db has already returned
#      "already installed" long before here. Those are the two checks that
#      protect a working install: the schema must be there and the server must
#      actually run.
#   3. It DELETES NOTHING. The directory is renamed to <datadir>.broken-<stamp>,
#      which is a rename inside the same filesystem: instant, free, and undone
#      with a single mv if this call was ever wrong.
#   4. If the rename fails for any reason at all, it refuses and changes nothing.
p_db_clear_datadir() {
    [ -d "$DATADIR" ] || return 0     # nothing there; MariaDB will initialise one

    # Show the user why, in their own log. The redo-log line is the fingerprint
    # of the shipped 10.6 data directory and worth quoting when it is there.
    p_db_err=$(ls -t "$DATADIR"/*.err 2>/dev/null | head -1)
    p_db_why=""
    if [ -n "$p_db_err" ] && grep -q 'Upgrade after a crash is not supported' "$p_db_err" 2>/dev/null; then
        p_db_why="yes"
    fi

    warn "──────────────────────────────────────────────────────────────"
    warn "MariaDB will NOT start with what is in $DATADIR right now."
    if [ -n "$p_db_why" ]; then
        warn "Its error log says the redo log was written by MariaDB 10.6, which"
        warn "this FreeBSD release cannot install — so this is the data directory"
        warn "from metin2_mysql.tar.gz, and it can never be opened here."
    else
        warn "Its error log is in $p_db_err"
    fi
    warn "Moving it out of the way so MariaDB can create a fresh one and the"
    warn "shipped .sql dumps can be imported into it."
    warn "NOTHING IS DELETED — the old directory is only renamed."
    warn "──────────────────────────────────────────────────────────────"
    [ -n "$p_db_err" ] && tail -20 "$p_db_err" >>"$LOG" 2>&1

    p_db_stamp=$(date +%Y%m%d-%H%M%S 2>/dev/null)
    [ -n "$p_db_stamp" ] || p_db_stamp="$$"
    p_db_old="$DATADIR.broken-$p_db_stamp"
    [ -e "$p_db_old" ] && p_db_old="$p_db_old.$$"

    if ! run mv "$DATADIR" "$p_db_old"; then
        warn "The old data directory could not be moved aside, so nothing was"
        warn "touched. Look at $DATADIR yourself, then run the installer again."
        return 1
    fi
    ok "Old data directory kept at $p_db_old"
    ok "(delete it with 'rm -rf $p_db_old' once the server works)"
    mkdir -p "$DATADIR" >>"$LOG" 2>&1
    run chown mysql:mysql "$DATADIR"
    return 0
}

# Start MariaDB on an empty/absent data directory. FreeBSD's rc script creates
# the system tables itself when $DATADIR/mysql is missing; the explicit
# install-db call is only there for the rare image where it does not.
p_db_init_datadir() {
    run service mysql-server start
    p_db_wait_up 60 && return 0
    for p_db_c in mariadb-install-db mysql_install_db; do
        command -v "$p_db_c" >/dev/null 2>&1 || continue
        run "$p_db_c" --user=mysql --datadir="$DATADIR"
        break
    done
    run service mysql-server start
    p_db_wait_up 60
}

# ---------------------------------------------------------------
#  Unpacking metin2_mysql_dump.zip
# ---------------------------------------------------------------
# The working copy goes under /root and NEVER under /tmp: on many FreeBSD images
# /tmp is a memory disk, and this is also material that is about to become the
# server's live data, so root-only permissions are the right default.
# Sets P_DB_SQLDIR on success.
p_db_unpack_dump() {
    P_DB_SQLDIR=""
    if ! command -v unzip >/dev/null 2>&1; then
        warn "unzip is not installed, so the SQL dump cannot be unpacked."
        warn "Run: pkg install -y unzip   and start the installer again."
        return 1
    fi
    P_DB_WORK=/root/.m2-r40250-dbdump
    rm -rf "$P_DB_WORK"
    if ! mkdir -p "$P_DB_WORK" 2>>"$LOG"; then
        P_DB_WORK=/var/db/m2-r40250-dbdump
        rm -rf "$P_DB_WORK"
        mkdir -p "$P_DB_WORK" 2>>"$LOG" || {
            warn "Could not create a working folder for the SQL dump — skipped"
            P_DB_WORK=""
            return 1
        }
    fi
    if ! ( cd "$P_DB_WORK" && run unzip -q -o "$MYSQL_DUMP_ZIP" ); then
        warn "$(basename "$MYSQL_DUMP_ZIP") could not be unpacked — see $LOG"
        return 1
    fi
    # A repack may have put the files one folder deeper, so find them rather
    # than assume. player.sql is the biggest and the one that must be there.
    p_db_found=$(find "$P_DB_WORK" -type f -iname 'player.sql' 2>/dev/null | head -1)
    if [ -z "$p_db_found" ]; then
        warn "There is no player.sql inside $(basename "$MYSQL_DUMP_ZIP")"
        return 1
    fi
    P_DB_SQLDIR=$(dirname "$p_db_found")
    ok "SQL dump unpacked ($(ls "$P_DB_SQLDIR"/*.sql 2>/dev/null | wc -l | tr -d ' ') .sql files)"
    return 0
}

p_db_cleanup() {
    rm -f "$P_DB_CNF"
    [ -n "${P_DB_WORK:-}" ] && [ -d "${P_DB_WORK:-}" ] && rm -rf "$P_DB_WORK"
    P_DB_WORK=""
    return 0
}

# ---------------------------------------------------------------
#  Importing the dumps
# ---------------------------------------------------------------
# The dumps carry no CREATE DATABASE and no USE statement — checked, they start
# straight at "DROP TABLE IF EXISTS" — so each database has to exist first and
# the file has to be piped into it by name. That is also exactly the sequence in
# the dump's Readme.txt.
p_db_do_import() {
    # file:database. The engine knows four of these (pack_db_names); hotbackup is
    # the fifth and the Readme is emphatic: "Yes, don't forget hotbackup, it's
    # needed even if empty.." — the db core opens it on startup. Its dump really
    # is empty (0 tables), which is fine; the database itself is what matters.
    P_DB_MAP="account.sql:${DB_ACCOUNT:-account}
common.sql:${DB_COMMON:-common}
player.sql:${DB_PLAYER:-player}
log.sql:${DB_LOG:-log}
hotbackup.sql:hotbackup"

    p_db_create=""
    for p_db_pair in $P_DB_MAP; do
        p_db_create="${p_db_create}CREATE DATABASE IF NOT EXISTS ${p_db_pair#*:} $P_DB_CHARSET;
"
    done
    if ! p_db_sql "$P_DB_ROOTPW" "$p_db_create"; then
        warn "The five databases could not be created — see $LOG"
        return 1
    fi
    ok "Databases created: account, common, player, log, hotbackup"

    p_db_bad=0
    for p_db_pair in $P_DB_MAP; do
        p_db_f="$P_DB_SQLDIR/${p_db_pair%%:*}"
        p_db_name="${p_db_pair#*:}"
        if [ ! -f "$p_db_f" ]; then
            warn "${p_db_pair%%:*} is not in the dump — '$p_db_name' stays empty"
            continue
        fi
        if p_db_import "$P_DB_ROOTPW" "$p_db_name" "$p_db_f"; then
            ok "Imported ${p_db_pair%%:*} → $p_db_name"
        else
            warn "Importing ${p_db_pair%%:*} into '$p_db_name' failed — see $LOG"
            p_db_bad=$((p_db_bad + 1))
        fi
    done
    [ "$p_db_bad" = "0" ] || return 1

    p_db_n=$(p_db_tables_in "${DB_PLAYER:-player}")
    if [ "$p_db_n" -lt 1 ]; then
        warn "The import finished but '${DB_PLAYER:-player}' has no tables — see $LOG"
        return 1
    fi
    ok "Import verified: ${DB_PLAYER:-player} holds $p_db_n tables"
    return 0
}

# ---------------------------------------------------------------
#  Passwords, set here on purpose
# ---------------------------------------------------------------
# THIS IS DELIBERATE, not a duplicate of the engine's work. The engine's next
# step rotates MySQL root's password and pack_apply_db_password rotates
# 'metin2' afterwards — but both of them start from a password that no longer
# exists on this route. A data directory MariaDB has just initialised gives root
# an EMPTY password; PACK_OLD_DB_PASS ("123456789") only ever belonged to the
# shipped 10.6 data directory, and 'metin2' does not exist at all until somebody
# creates it. Left alone, the engine would try the factory password, fail, and
# finish the install with a database nothing can log into.
# So we set both accounts to $DB_PASS right here. Both later steps are written to
# notice that the work is already done: the engine's rotation finds
# "Password already up to date (local and network logins both work)" and
# pack_apply_db_password finds 'metin2' correct and only rewrites the CONFIG
# files. Nothing runs twice, and nothing is left half-done.
p_db_set_passwords() {
    p_db_pw=$(sql_escape "$DB_PASS")
    p_db_user="${PACK_GAME_DB_USER:-metin2}"

    # --- the game account, as the dump's Readme describes it -----------------
    #   CREATE USER 'metin2'@'localhost' IDENTIFIED BY 'password';
    #   GRANT ALL PRIVILEGES ON *.* TO 'metin2'@'localhost' WITH GRANT OPTION;
    #   FLUSH PRIVILEGES;
    # …with the generated password instead of the word "password", and with the
    # 127.0.0.1 twin as well: the cores' CONFIG files say host 127.0.0.1, and
    # MySQL treats that as a different account from localhost.
    # CREATE-then-ALTER so a re-run resets an existing account instead of failing.
    p_db_stmt=""
    for p_db_h in localhost 127.0.0.1; do
        p_db_stmt="${p_db_stmt}CREATE USER IF NOT EXISTS '$p_db_user'@'$p_db_h' IDENTIFIED BY '$p_db_pw';
ALTER USER '$p_db_user'@'$p_db_h' IDENTIFIED BY '$p_db_pw';
GRANT ALL PRIVILEGES ON *.* TO '$p_db_user'@'$p_db_h' WITH GRANT OPTION;
"
    done
    if p_db_sql "$P_DB_ROOTPW" "${p_db_stmt}FLUSH PRIVILEGES;"; then
        ok "MySQL user '$p_db_user' created for localhost and 127.0.0.1"
    else
        warn "The '$p_db_user' MySQL account could not be created — see $LOG"
    fi

    # --- MySQL root -----------------------------------------------------------
    # root@127.0.0.1 is created explicitly because the admin panel logs in over
    # TCP as root, and a fresh install often only has root@localhost.
    # Every existing root account is set to the same value, localhost LAST: the
    # statements all run on one already-authenticated connection, but keeping the
    # socket account for the end means a half-applied batch still leaves us in.
    p_db_hosts=$(p_db_val "$P_DB_ROOTPW" "SELECT Host FROM mysql.user WHERE User='root';" 2>/dev/null)
    p_db_stmt="CREATE USER IF NOT EXISTS 'root'@'127.0.0.1' IDENTIFIED BY '$p_db_pw';
GRANT ALL PRIVILEGES ON *.* TO 'root'@'127.0.0.1' WITH GRANT OPTION;
"
    for p_db_h in $p_db_hosts; do
        [ "$p_db_h" = "localhost" ] && continue
        p_db_stmt="${p_db_stmt}ALTER USER 'root'@'$(sql_escape "$p_db_h")' IDENTIFIED BY '$p_db_pw';
"
    done
    p_db_stmt="${p_db_stmt}ALTER USER 'root'@'127.0.0.1' IDENTIFIED BY '$p_db_pw';
CREATE USER IF NOT EXISTS 'root'@'localhost' IDENTIFIED BY '$p_db_pw';
GRANT ALL PRIVILEGES ON *.* TO 'root'@'localhost' WITH GRANT OPTION;
ALTER USER 'root'@'localhost' IDENTIFIED BY '$p_db_pw';
FLUSH PRIVILEGES;"
    if p_db_sql "$P_DB_ROOTPW" "$p_db_stmt"; then
        P_DB_ROOTPW="$DB_PASS"
        if p_db_sql "$DB_PASS" "SELECT 1;"; then
            ok "MySQL root now uses the installer's password (the next step just confirms it)"
        else
            warn "root's password was changed but the new one does not log in — see $LOG"
        fi
    else
        warn "MySQL root's password could not be set here. The installer's own"
        warn "password step runs next and will try again."
    fi
    return 0
}

# ---------------------------------------------------------------
#  Fallback: the shipped MariaDB 10.6 data directory
# ---------------------------------------------------------------
# Only reached when metin2_mysql_dump.zip is genuinely not there. This is the old
# behaviour, kept so a partial download is not a total loss, and it is NOT the
# normal route: on FreeBSD 14 it will most likely just fail to start (see the
# long note at the top). mariadb-upgrade lives here and only here — it exists to
# drag a foreign data directory onto the installed engine, which is meaningless
# when we import a dump into a data directory MariaDB made itself.
p_db_fallback_datadir() {
    warn "──────────────────────────────────────────────────────────────"
    warn "metin2_mysql_dump.zip is missing, so the only thing left is the"
    warn "shipped MariaDB 10.6 DATA DIRECTORY (metin2_mysql.tar.gz)."
    warn "This works ONLY on MariaDB 10.6/10.7 and will very probably fail"
    warn "on FreeBSD 14, which cannot install those versions any more."
    warn "If MariaDB does not come up after this, get metin2_mysql_dump.zip"
    warn "from the download and run the installer again."
    warn "──────────────────────────────────────────────────────────────"

    run service mysql-server stop
    p_db_parent=$(dirname "$DATADIR"); p_db_name=$(basename "$DATADIR")
    # The archive has a top-level "mysql/" folder, so it is extracted in the data
    # directory's PARENT (/var/db), replacing /var/db/mysql wholesale.
    # tar -xf, NOT tar -xzf — see the warning at the top of this file.
    ( cd "$p_db_parent" && rm -rf "$p_db_name" && tar -xf "$MYSQL_TGZ" && chown -R mysql:mysql "$p_db_name" ) >>"$LOG" 2>&1 \
        && ok "Data directory extracted → $DATADIR" || fail "The data directory could not be extracted"
    run service mysql-server start
    if ! p_db_wait_up 60; then
        warn "MariaDB did not start with the shipped data directory — exactly the"
        warn "failure the .sql dump route avoids. Its error log is in $DATADIR."
        return 0
    fi

    # A foreign data directory needs its system tables migrating once, and
    # skipping that shows up later as strange permission and collation errors.
    p_db_up_cmd=""
    for p_db_c in mariadb-upgrade mysql_upgrade; do
        command -v "$p_db_c" >/dev/null 2>&1 && p_db_up_cmd="$p_db_c" && break
    done
    if [ -n "$p_db_up_cmd" ]; then
        if run env MYSQL_PWD="${PACK_OLD_DB_PASS:-}" "$p_db_up_cmd" -u root --force; then
            ok "Data directory migrated to the installed MariaDB version"
            run service mysql-server restart
        else
            warn "mariadb-upgrade reported problems — see $LOG"
            warn "If you hit odd permission or collation errors later, run"
            warn "    $p_db_up_cmd -u root -p"
        fi
    else
        warn "No mariadb-upgrade command found — skipping the data migration"
    fi
    return 0
}

# ---------------------------------------------------------------
#  The hook itself
# ---------------------------------------------------------------
pack_deploy_db() {
    P_MYSQL=$(command -v mysql 2>/dev/null || command -v mariadb 2>/dev/null || true)
    if [ -z "$P_MYSQL" ]; then
        warn "No mysql/mariadb client on this machine, so the database cannot be"
        warn "set up. Check that ${PACK_DB_PKGS:-the MariaDB packages} installed."
        return 0
    fi

    # Where the data directory is, according to the server itself.
    DATADIR=$( { mysqld --verbose --help 2>/dev/null || mariadbd --verbose --help 2>/dev/null; } \
               | awk '/^datadir/{print $2; exit}')
    # MariaDB prints it WITH a trailing slash ("datadir  /var/db/mysql/"), and
    # that slash is not cosmetic here: "$DATADIR.broken-<stamp>" would become
    # /var/db/mysql/.broken-<stamp>, a hidden entry INSIDE the directory we are
    # trying to move, and the mv would fail. Strip it before anything uses it.
    while :; do
        case "$DATADIR" in
            /|"") break ;;
            */)  DATADIR="${DATADIR%/}" ;;
            *)   break ;;
        esac
    done
    # Accept whatever the server reported as long as it is an absolute path —
    # NOT only when it already exists. On a fresh box the data directory has not
    # been created yet, and testing for -d here would silently swap a custom
    # datadir for /var/db/mysql and then initialise, clear and import in the
    # wrong place. /var/db/mysql stays the fallback for "mysqld told us nothing".
    case "$DATADIR" in
        /?*) ;;
        *)   DATADIR=/var/db/mysql ;;
    esac

    # 1. my.cnf FIRST. sql_mode has to be in force during the import, not after.
    p_db_tune_cnf

    # 2. Start whatever is on disk and find out what we are dealing with. On a
    #    truly fresh box this single call is what creates the data directory.
    run service mysql-server restart || run service mysql-server start
    P_DB_LIVE=0; P_DB_AUTH=0; P_DB_ROOTPW=""
    if p_db_wait_up 40; then
        P_DB_LIVE=1
        p_db_find_root_pw && P_DB_AUTH=1
    fi

    # 3. Is a usable database already here? Both halves have to be true: the
    #    server runs AND 'player' actually has tables. This is what makes a
    #    second run a no-op instead of a data loss, and it is also the guard
    #    that stops p_db_clear_datadir from ever seeing a working install.
    if [ "$P_DB_LIVE" = "1" ] && [ "$P_DB_AUTH" = "1" ]; then
        p_db_have=$(p_db_tables_in "${DB_PLAYER:-player}")
        if [ "$p_db_have" -gt 0 ]; then
            ok "Database already installed (${DB_PLAYER:-player} has $p_db_have tables) — import skipped"
            # cheap and idempotent: the db core needs this schema to exist
            p_db_sql "$P_DB_ROOTPW" "CREATE DATABASE IF NOT EXISTS hotbackup $P_DB_CHARSET;"
            p_db_cleanup
            return 0
        fi
    fi

    # 4. No usable database yet. The supported route is the .sql dump.
    if [ -n "${MYSQL_DUMP_ZIP:-}" ] && [ -f "${MYSQL_DUMP_ZIP:-}" ] && p_db_unpack_dump; then
        # Only now, with the dumps verified on disk, may the data directory be
        # touched — and only if MariaDB could not open it in step 2.
        if [ "$P_DB_LIVE" != "1" ]; then
            if ! p_db_clear_datadir; then
                p_db_cleanup
                return 0
            fi
            p_db_init_datadir && P_DB_LIVE=1
            P_DB_AUTH=0
            [ "$P_DB_LIVE" = "1" ] && { p_db_find_root_pw && P_DB_AUTH=1; }
        fi

        if [ "$P_DB_LIVE" != "1" ]; then
            warn "MariaDB still does not start, so the dumps could not be imported."
            warn "Look at $DATADIR/*.err and at $LOG, then run the installer again."
            p_db_cleanup
            return 0
        fi
        if [ "$P_DB_AUTH" != "1" ]; then
            warn "MariaDB is running but none of the passwords we know are accepted,"
            warn "so nothing was imported and nothing was changed. Log in yourself"
            warn "with 'mysql -u root -p' and re-run the installer."
            p_db_cleanup
            return 0
        fi

        if p_db_do_import; then
            p_db_set_passwords
        else
            warn "The database import did not finish cleanly. The server files are"
            warn "fine — fix the errors in $LOG and run the installer again."
        fi
        p_db_cleanup
        return 0
    fi

    # 5. No dump. Documented fallback, with the warning it deserves.
    if [ -n "${MYSQL_TGZ:-}" ] && [ -f "${MYSQL_TGZ:-}" ]; then
        p_db_fallback_datadir
    else
        warn "Neither metin2_mysql_dump.zip nor metin2_mysql.tar.gz is here —"
        warn "the database was not set up. Add one of them and re-run."
    fi
    p_db_cleanup
    # A failed import is reported but must not abort the run: the panel half of
    # the install still works, and re-running the installer fixes the DB later.
    return 0
}

# ---------------------------------------------------------------
#  Server + source  (-> /usr)
# ---------------------------------------------------------------
# metin2_server+src.tar.gz has a top-level "metin2/" folder, so it is extracted
# into /usr and the result is /usr/metin2/server and /usr/metin2/src. That is
# exactly what the pack's own FAQ tells people to do:
#     cd /usr && tar -xf metin2_server+src.tar.gz
pack_deploy_game() {
    if [ -d /usr/metin2/server ]; then
        ok "Server files already installed, skipped"
    else
        # untar_to creates /usr if needed, always uses tar -xf, and prints the
        # real reason on failure instead of a generic warning.
        untar_to "${GAME_TGZ:-}" /usr "Server + source"
    fi

    GAME_DIR=/usr/metin2/server
    if [ ! -d "$GAME_DIR" ]; then
        # The archive may have been repacked with a different top folder. Find
        # the directory that holds start.sh AND a db folder — that is the root.
        p_start=$(find /usr -maxdepth 4 -type f -name 'start.sh' 2>/dev/null \
                  | while IFS= read -r p_f; do
                        [ -d "$(dirname "$p_f")/db" ] && printf '%s\n' "$p_f"
                    done | head -1)
        [ -n "$p_start" ] && GAME_DIR=$(dirname "$p_start")
    fi
    if [ ! -d "$GAME_DIR" ]; then
        warn "The server folder is not where it should be (/usr/metin2/server)"
        return 1
    fi
    ok "Server runtime dir: $GAME_DIR"

    # The two real programs live in share/bin and every core folder holds a
    # SYMLINK to them (channel1/first/game -> ../../share/bin/game). Making the
    # real files executable therefore covers all fourteen cores at once. The
    # helper scripts need the bit too, since a zip/tar round trip often loses it.
    for p_bin in "$GAME_DIR"/share/bin/game "$GAME_DIR"/share/bin/db; do
        [ -f "$p_bin" ] && chmod +x "$p_bin" 2>/dev/null
    done
    # The quest compiler is a program as well and make.py calls it as ./qc
    p_qc=$(find "$GAME_DIR/share/locale" -maxdepth 3 -type f -name 'qc' 2>/dev/null | head -1)
    [ -n "$p_qc" ] && chmod +x "$p_qc" 2>/dev/null
    find "$GAME_DIR" -maxdepth 3 -type f -name '*.sh' -exec chmod +x {} \; 2>/dev/null
    ok "Server programs made executable"
    return 0
}

# ---------------------------------------------------------------
#  Teaching the database and the game cores the new password
# ---------------------------------------------------------------
# Two separate jobs, and skipping either one leaves a server that starts and
# then cannot log a single player in:
#
#   1. MySQL itself. These files do NOT connect as root — they use a dedicated
#      account called 'metin2' whose factory password is the word "password".
#      The engine has already rotated root's password; this rotates metin2's to
#      the very same value so there is only one password to remember.
#
#   2. The config files. There are TWO formats and they do NOT agree on where
#      the password sits — note also that the key names are the other way round
#      from the Fliege pack (suffix _SQL here, prefix SQL_ there):
#
#        a) the game cores (auth, game99, channelN/first|game1|game2) — CONFIG:
#               PLAYER_SQL: 127.0.0.1 metin2 password player
#               fields:     host      user   password dbname   -> password 3rd
#
#        b) the database core — db/conf.txt, quoted and in a different order:
#               SQL_PLAYER = "127.0.0.1 player metin2 password 0"
#               fields:       host      dbname user   password flags -> 4th
#
# Only the password field may change. Host, user, database name and the trailing
# flags must survive untouched, and running this twice must write the same value
# again rather than eat the next field along.
pack_apply_db_password() {
    p_user="${PACK_GAME_DB_USER:-metin2}"

    # ---------- 1) the MySQL account the game cores use ----------
    # Ask MariaDB which 'metin2' accounts actually exist instead of guessing:
    # one account per host, and changing only the wrong one is a silent failure.
    p_hosts=$(db_query "$DB_PASS" "SELECT Host FROM mysql.user WHERE User='$p_user';" 2>/dev/null)
    p_done=0
    if [ -n "$p_hosts" ]; then
        for p_h in $p_hosts; do
            # ALTER USER is the modern form; SET PASSWORD is the fallback for the
            # older engines these files also run on. Either one succeeding is fine.
            db_exec "$DB_PASS" "ALTER USER '$p_user'@'$p_h' IDENTIFIED BY '$(sql_escape "$DB_PASS")';" \
                || db_exec "$DB_PASS" "SET PASSWORD FOR '$p_user'@'$p_h' = PASSWORD('$(sql_escape "$DB_PASS")');" \
                || { warn "Could not change the password of $p_user@$p_h"; continue; }
            p_done=$((p_done + 1))
        done
    else
        # No such account at all. That happens when somebody imported the .sql
        # dumps by hand instead of using the shipped data directory — the dump's
        # own Readme tells them to create this user themselves and they forgot.
        # Without it NOTHING starts, so create it rather than just complaining.
        warn "There is no MySQL user called '$p_user' yet — creating it now"
        for p_h in localhost 127.0.0.1; do
            db_exec "$DB_PASS" "CREATE USER IF NOT EXISTS '$p_user'@'$p_h' IDENTIFIED BY '$(sql_escape "$DB_PASS")';" \
                && db_exec "$DB_PASS" "GRANT ALL PRIVILEGES ON *.* TO '$p_user'@'$p_h';" \
                && p_done=$((p_done + 1))
        done
    fi
    if [ "$p_done" -gt 0 ]; then
        db_exec "$DB_PASS" "FLUSH PRIVILEGES;"
        ok "MySQL user '$p_user' now uses the new password ($p_done account(s))"
    else
        warn "The MySQL user '$p_user' could not be updated. The cores log in as that"
        warn "user, so if the server does not start, check it by hand:"
        warn "    SELECT User, Host FROM mysql.user WHERE User='$p_user';"
    fi

    # ---------- 2) the config files ----------
    # the password becomes part of a sed replacement, so \ & / must be escaped
    DB_PASS_SED=$(printf '%s' "$DB_PASS" | sed -e 's,[\&/],\\&,g')
    CFG_N=0
    P_TOUCHED=""

    # -- format (a): CONFIG, key ends in _SQL:, password is the 3rd value --
    # The cores sit one level deep (auth, game99) and two levels deep
    # (channel1/first, channel1/game1, …), so both depths are listed.
    for CFG in "$GAME_DIR"/CONFIG "$GAME_DIR"/*/CONFIG "$GAME_DIR"/*/*/CONFIG; do
        [ -f "$CFG" ] || continue
        grep -q '_SQL:' "$CFG" 2>/dev/null || continue
        if sed -i '' \
            "s/^\([A-Z0-9_]*_SQL:[[:blank:]]*[^[:blank:]]*[[:blank:]]*[^[:blank:]]*[[:blank:]]*\)[^[:blank:]]*\(.*\)$/\1$DB_PASS_SED\2/" \
            "$CFG" >>"$LOG" 2>&1; then
            CFG_N=$((CFG_N + 1)); P_TOUCHED="$P_TOUCHED $CFG"
        else
            warn "Could not update: $CFG"
        fi
    done

    # -- format (b): conf.txt, key starts with SQL_, password is the 4th value --
    # Every field pattern excludes the double quote as well as blanks, so the
    # closing quote and the trailing flags can never be swallowed.
    for CFG in "$GAME_DIR"/conf.txt "$GAME_DIR"/*/conf.txt "$GAME_DIR"/*/*/conf.txt; do
        [ -f "$CFG" ] || continue
        grep -q '^SQL_' "$CFG" 2>/dev/null || continue
        if sed -i '' \
            "s/^\(SQL_[A-Z0-9_]*[[:blank:]]*=[[:blank:]]*\"[^[:blank:]\"]*[[:blank:]]*[^[:blank:]\"]*[[:blank:]]*[^[:blank:]\"]*[[:blank:]]*\)[^[:blank:]\"]*\(.*\)$/\1$DB_PASS_SED\2/" \
            "$CFG" >>"$LOG" 2>&1; then
            CFG_N=$((CFG_N + 1)); P_TOUCHED="$P_TOUCHED $CFG"
        else
            warn "Could not update: $CFG"
        fi
    done

    if [ "$CFG_N" -gt 0 ]; then
        ok "Database password written into $CFG_N config file(s) under $GAME_DIR"
        # Nothing may still carry the factory password, or that core crashes on
        # startup. We check ONLY the config files we just rewrote, not the whole
        # tree: $GAME_DIR/share holds a couple of gigabytes of map and locale
        # data, and this pack's factory password is the plain English word
        # "password", so a recursive grep would be slow AND full of nonsense.
        # NOTE: this looks for the *config* factory password ("password"), not
        # PACK_OLD_DB_PASS — that one is MySQL root's and never appears in here.
        if [ -n "${P_CFG_OLD_PW:-}" ]; then
            p_left=""
            for p_f in $P_TOUCHED; do
                case "$p_f" in *.core) continue ;; esac
                grep -q "$P_CFG_OLD_PW" "$p_f" 2>/dev/null && p_left="$p_left
$p_f"
            done
            if [ -n "$p_left" ]; then
                warn "These files still contain the old password — check them by hand:"
                printf '%s\n' "$p_left" | grep -v '^$' | head -5 | while IFS= read -r p_f; do
                    warn "    $p_f"
                done
            fi
        fi
    else
        warn "No CONFIG/conf.txt files found under $GAME_DIR — set the passwords by hand"
    fi
    return 0
}

# ---------------------------------------------------------------
#  Writing the server IP into the client
# ---------------------------------------------------------------
# The client keeps its server list in serverinfo.py. In THIS client that file is
# not loose on disk — it lives inside pack/root.epk, and there is no tool on
# FreeBSD that can rebuild an .epk. So we put a loose copy on disk instead and
# rely on the client's own file-versus-pack lookup order.
#
# How that lookup works (read out of ClientVS22.zip, this client's own source):
#   • CEterPackManager's constructor sets m_iSearchMode(SEARCH_FILE_FIRST), and
#     in that mode Get()/isExist() look at a real file on disk BEFORE the packs.
#   • The lookup name has no folder in it — system.py does pack.Exist("<name>.py")
#     and EterPackManager::GetFromFile() then simply opens "<name>.py" relative to
#     the client's own folder. So the loose file belongs NEXT TO THE .EXE, and
#     ONLY there.
#
#   We used to drop a second copy into a root/ subfolder as well, on the theory
#   that it costs nothing and that other 40250-derived clients look there. It is
#   not free: this client never reads it, so the two files drift apart the moment
#   somebody edits one — and the root/ copy is the obvious-looking one, so that is
#   the one people edit. Someone changed the IP in root/serverinfo.py, restarted,
#   and of course nothing happened, because the client had been reading the copy
#   next to the .exe the whole time. Writing a file the program does not read is
#   worse than writing no file at all, so now exactly one copy is written.
#
# ⚠ AND THE CATCH, which cost a lot of reading to find:
#   UserInterface.cpp does NOT keep the constructor's default. At startup it
#   calls SetSearchMode(bPackFirst), and in a build with _DISTRIBUTE defined the
#   "use files first" branch is commented out, so bPackFirst stays TRUE →
#   SEARCH_PACK_FIRST → pack/root.epk wins and a loose file is ignored.
#   The client shipped here is Metin2Distribute.exe, and the project file says
#   TargetName = Metin2$(Configuration) with _DISTRIBUTE in the Distribute
#   configuration — so this client IS a pack-first client.
#
# That is why we do one more thing: we move pack/root.eix and pack/root.epk
# aside and put the 90 unpacked originals TMP4 ships in Client/Eternexus/root/
# on disk instead. With no root pack to find, every root file is read from disk
# in either search mode, and our serverinfo.py is the one that counts. The
# unpacked folder is a complete stand-in — root.eix indexes exactly 90 entries
# and Eternexus/root holds exactly 90 files — but if it ever is not, we leave
# the pack alone and only warn, because a broken client is far worse than a
# client that needs its IP typed in.
# p_write_serverinfo TARGET_FILE CHANNEL_COUNT -> writes a complete serverinfo.py
# We generate the file rather than patching the original, because the original
# hard-codes 192.168.0.122 in several places and offers a second "Test" server
# on 127.0.0.1 that no player can ever reach. But EVERY name the original
# defines is kept: other scripts in the client import this module, and one
# missing name is an exception box instead of a login screen.
p_write_serverinfo() {
    p_si="$1"; p_ch="${2:-2}"
    {
        printf '# Written by the Metin2 installer. One server, %s channel(s), all pointing here.\n' "$p_ch"
        printf 'SERVER_NAME       = "%s"\n' "${PACK_SERVER_NAME:-${PACK_NAME:-Metin2}}"
        printf 'SERVER_NAME_TEST  = "%s"\n' "${PACK_SERVER_NAME:-${PACK_NAME:-Metin2}}"
        printf 'SERVER_IP         = "%s"\n' "$PUB_IP"
        printf 'SERVER_IP_TEST    = "%s"\n' "$PUB_IP"
        printf 'CH1_NAME          = "CH1"\n'
        printf 'CH2_NAME          = "CH2"\n'
        printf 'CH3_NAME          = "CH3"\n'
        printf 'CH4_NAME          = "CH4"\n'
        printf 'PORT_1            = %s\n' "$(p_ch_port 1)"
        printf 'PORT_2            = %s\n' "$(p_ch_port 2)"
        printf 'PORT_3            = %s\n' "$(p_ch_port 3)"
        printf 'PORT_4            = %s\n' "$(p_ch_port 4)"
        printf 'PORT_AUTH         = %s\n' "$P_AUTH_PORT"
        printf 'PORT_MARK         = %s\n' "$(p_ch_port 1)"
        printf '\n'
        printf 'STATE_NONE = "..."\n'
        printf 'STATE_DICT = {\n\t0 : "....",\n\t1 : "NORM",\n\t2 : "BUSY",\n\t3 : "FULL"\n}\n'
        printf '\n'
        # Only the channels that are really running are listed. A channel that is
        # not started still shows up in the client and just fails on connect,
        # which looks exactly like a broken server to a player.
        printf 'SERVER01_CHANNEL_DICT = {\n'
        p_i=1
        while [ "$p_i" -le "$p_ch" ]; do
            printf '\t%d:{"key":%d,"name":CH%d_NAME,"ip":SERVER_IP,"tcp_port":%d,"udp_port":%d,"state":STATE_NONE,},\n' \
                   "$p_i" "$((10 + p_i))" "$p_i" "$(p_ch_port "$p_i")" "$(p_ch_port "$p_i")"
            p_i=$((p_i + 1))
        done
        printf '}\n\n'
        # Kept only so that anything importing this name still finds it.
        printf 'SERVER02_CHANNEL_DICT = SERVER01_CHANNEL_DICT\n\n'
        printf 'REGION_NAME_DICT = {\n\t0 : "",\n}\n\n'
        printf 'REGION_AUTH_SERVER_DICT = {\n\t0 : {\n\t\t1 : { "ip":SERVER_IP, "port":PORT_AUTH, },\n\t}\n}\n\n'
        printf 'REGION_DICT = {\n\t0 : {\n\t\t1 : { "name" : SERVER_NAME, "channel" : SERVER01_CHANNEL_DICT, },\n\t},\n}\n\n'
        printf 'MARKADDR_DICT = {\n\t10 : { "ip" : SERVER_IP, "tcp_port" : PORT_MARK, "mark" : "10.tga", "symbol_path" : "10", },\n}\n'
    } > "$p_si" 2>>"$LOG"
}

pack_apply_ip() {
    p_dir="${1:-${CLIENT_WORK:-}}"
    [ -n "$p_dir" ] || return 0
    [ -d "$p_dir" ] || { warn "No client folder to write the IP into"; return 0; }

    # The zip contains a top-level "Client/" folder, so the real client root is
    # wherever the launcher .exe sits — find it rather than assuming a depth.
    p_root=""
    p_exe=$(find "$p_dir" -maxdepth 3 -type f -iname 'metin2*.exe' 2>/dev/null \
            | grep -ivE 'eternexus|dump_proto|vcredist|config\.exe' \
            | awk -F/ '{print NF "\t" $0}' | sort -n | cut -f2- | head -1)
    [ -n "$p_exe" ] && p_root=$(dirname "$p_exe")
    [ -d "$p_root" ] || p_root="$p_dir"

    p_chn=${CHANNELS:-2}
    case "$p_chn" in 1|2|3|4) : ;; *) p_chn=2 ;; esac

    # Have a look at the shipped file first, purely so the log says where the
    # structure we are reproducing came from.
    p_orig=$(find "$p_dir" -type f -iname 'serverinfo.py' 2>/dev/null | head -1)
    if [ -n "$p_orig" ]; then
        ok "Shipped serverinfo.py found (${p_orig#$p_dir/}) — matching its names and layout"
    else
        warn "No serverinfo.py in this client — writing a complete one from scratch"
    fi

    # ---- STEP 1: make sure a loose file can win at all (see the long note) ---
    # This has to happen BEFORE our serverinfo.py is written: it copies ~90
    # files into the client root and one of them is the original serverinfo.py.
    p_epk="$p_root/pack/root.epk"
    p_eix="$p_root/pack/root.eix"
    p_unpacked=$(find "$p_dir" -type d -name 'root' 2>/dev/null | grep -i 'eternexus' | head -1)
    if [ ! -f "$p_epk" ] || [ ! -f "$p_eix" ]; then
        ok "This client has no packed root — a loose serverinfo.py is used as it is"
    elif [ -z "$p_unpacked" ] || [ ! -d "$p_unpacked" ]; then
        warn "The launcher reads its scripts from pack/root.epk first, and the unpacked"
        warn "originals (Client/Eternexus/root) are not in this download — so the packed"
        warn "copy of serverinfo.py stays in charge and players will have to be told the"
        warn "server address themselves: $PUB_IP"
    else
        # sanity: the unpacked folder has to be a full stand-in, not a few samples
        p_cnt=$(find "$p_unpacked" -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')
        case "${p_cnt:-x}" in *[!0-9]*) p_cnt=0 ;; esac
        p_ok=1
        for p_need in system.py prototype.py game.py; do
            [ -f "$p_unpacked/$p_need" ] || p_ok=0
        done
        if [ "$p_ok" != "1" ] || [ "$p_cnt" -lt 60 ]; then
            warn "The unpacked client scripts look incomplete ($p_cnt files) — pack/root.epk"
            warn "is left exactly as it is. Nothing is broken, but players may have to enter"
            warn "the server address $PUB_IP by hand."
        elif cp "$p_unpacked"/* "$p_root"/ >>"$LOG" 2>&1 \
             && mv "$p_eix" "$p_eix.packed-original" >>"$LOG" 2>&1 \
             && mv "$p_epk" "$p_epk.packed-original" >>"$LOG" 2>&1; then
            ok "Client scripts put on disk ($p_cnt files) so the new address really takes effect"
        else
            warn "Could not swap the packed client scripts for the unpacked ones — see $LOG."
            warn "The client still works; players may just have to type in $PUB_IP themselves."
        fi
    fi

    # ---- STEP 2: the server list itself -------------------------------------
    # ONE file, next to the .exe. Deliberately no second copy in root/ — the
    # client's own system.py opens "serverinfo.py" relative to the client folder,
    # so a root/serverinfo.py is never read, and a file that looks authoritative
    # but is ignored only sends the next person editing it down a blind alley.
    # See the note above this hook.
    if p_write_serverinfo "$p_root/serverinfo.py" "$p_chn"; then
        ok "Server address written into the client: $PUB_IP (1 server, $p_chn channel(s))"
        ok "It is the serverinfo.py NEXT TO the .exe — that is the only one this client reads"
    else
        warn "serverinfo.py could not be written — players will have to set the IP themselves"
        return 0
    fi
    return 0
}

# ---------------------------------------------------------------
#  The panel quest
# ---------------------------------------------------------------
# Languages.txt: the locale folder gets RENAMED when somebody switches the
# server language ("rename english to your locale like germany/hungary/france").
# So the quest folder is searched for, never assumed to be .../english/quest.
pack_install_quest() {
    p_quest="${QUEST_FILE:-web_admin.quest}"
    QDIR=$(find "$GAME_DIR/share/locale" -maxdepth 2 -type d -name quest 2>/dev/null | head -1)
    [ -n "$QDIR" ] || QDIR=$(find "$GAME_DIR" -type d -name quest 2>/dev/null | head -1)
    if [ -z "$QDIR" ]; then
        warn "Quest folder not found (were the server files extracted?)"
        return 0
    fi
    if ! cp "$p_quest" "$QDIR/" 2>>"$LOG"; then
        warn "Could not copy $p_quest into $QDIR"
        return 0
    fi

    # In these files the list make.py reads is called locale_list, one file name
    # per line. If the file does not end in a newline our entry would be glued
    # onto the last one and BOTH quests would then fail to compile.
    QLIST=""
    for L in locale_list quest_list quest_list.txt; do
        [ -f "$QDIR/$L" ] && QLIST="$QDIR/$L" && break
    done
    if [ -n "$QLIST" ]; then
        if grep -q "^${p_quest}[[:space:]]*$" "$QLIST" 2>/dev/null; then
            ok "Quest already listed in $(basename "$QLIST")"
        else
            [ -n "$(tail -c 1 "$QLIST" 2>/dev/null)" ] && printf '\n' >> "$QLIST"
            printf '%s\n' "$p_quest" >> "$QLIST"
            ok "Quest added to the list ($QLIST)"
        fi
    else
        warn "No locale_list found — add the line '$p_quest' to the list file in $QDIR yourself"
    fi

    # ---- the quest compiler's own list of legal function names ------------
    # qc does not just compile, it VALIDATES: every name a quest calls has to
    # appear in share/locale/<lang>/quest/quest_functions (585 entries in these
    # files), and anything not on the list is rejected outright with
    #     Calls undeclared function!
    # …which does not say which name it means. web_admin.quest calls
    # mysql_direct_query, and that name is not in the shipped list, so without
    # this the quest simply never compiles and the panel's in-game actions stay
    # dead — with a compiler error nobody can interpret.
    #
    # This is done whether or not the core is patched later. Listing a name the
    # core does not implement is harmless: the quest checks for it at runtime
    # ("if mysql_direct_query == nil then") and quietly does nothing. The reverse
    # — patching the core but not the list — leaves the quest uncompilable.
    #
    # The file is a flat list, one name per line, and its tail is not sorted, so
    # appending is correct. A missing final newline would glue our name onto the
    # last entry and break BOTH, hence the same newline guard as above.
    QFUNC="$QDIR/quest_functions"
    if [ ! -f "$QFUNC" ]; then
        warn "There is no quest_functions list in $QDIR — the quest compiler cannot be"
        warn "told about mysql_direct_query, so web_admin.quest may fail to compile with"
        warn "'Calls undeclared function!'. Add the line 'mysql_direct_query' to that file."
    elif grep -q '^mysql_direct_query[[:space:]]*$' "$QFUNC" 2>/dev/null; then
        ok "mysql_direct_query is already known to the quest compiler"
    else
        [ -n "$(tail -c 1 "$QFUNC" 2>/dev/null)" ] && printf '\n' >> "$QFUNC"
        if printf 'mysql_direct_query\n' >> "$QFUNC" 2>>"$LOG"; then
            ok "mysql_direct_query registered with the quest compiler ($QFUNC)"
        else
            warn "Could not add mysql_direct_query to $QFUNC — web_admin.quest may not compile"
        fi
    fi

    # ---- compiling -------------------------------------------------------
    # make.py rebuilds EVERY quest (it deletes and recreates object/), which is
    # normal and is exactly what the pack's own "questcompile" alias does.
    # It is PYTHON 2 code — "print 'x'", "file('locale_list')" — so python3
    # cannot run it. FAQ.txt says: pkg install python27, then python2.7 make.py.
    if [ ! -f "$QDIR/make.py" ]; then
        warn "make.py not found in $QDIR — compile the quest by hand"
        return 0
    fi
    grep -q '^quest:' /etc/group 2>/dev/null || run pw groupadd quest   # make.py does chgrp quest
    [ -f "$QDIR/qc" ] && chmod +x "$QDIR/qc" 2>/dev/null
    QPY=""
    for p_c in python2.7 python2 python; do
        command -v "$p_c" >/dev/null 2>&1 || continue
        # "python" may well be python3 on a modern box; make sure it is a 2.x
        "$p_c" -c 'import sys; sys.exit(0 if sys.version_info[0] == 2 else 1)' >/dev/null 2>&1 \
            && QPY="$p_c" && break
    done
    if [ -z "$QPY" ]; then
        warn "No Python 2 interpreter on this machine, and this pack's make.py is"
        warn "Python 2 only — python3 cannot run it. The quest was copied and listed"
        warn "but NOT compiled, so the panel's in-game actions stay inactive."
        warn "Fix it with two commands:"
        warn "    pkg install python27"
        warn "    cd $QDIR && python2.7 make.py"
        return 0
    fi
    ( cd "$QDIR" && run "$QPY" make.py ) \
        && ok "Quests compiled ($QPY make.py — all quests rebuilt, same as the questcompile alias)" \
        || warn "make.py reported an error — check $LOG (the quest file may need a function name adjusting)"
    warn "Remember to restart the game server for the quest change to take effect"
    return 0
}

# ---------------------------------------------------------------
#  Server-wide EXP / drop / yang rates
# ---------------------------------------------------------------
# These files have no rate setting: the numbers are baked into the data tables,
# so changing a rate means rewriting the tables. Which is fine, as long as two
# rules are respected, and they are the whole reason this hook looks the way it
# does:
#
#   1. ALWAYS scale from a pristine copy, never from the current file. Setting
#      2x and then 3x must give 3x, not 6x. The first run therefore keeps a
#      <file>.m2orig alongside each table and every later run reads THAT.
#   2. Never leave a half-written table behind. Everything is written to a temp
#      file and only moved into place once awk has finished successfully — a
#      truncated mob_proto.txt stops the whole server from starting.
#
# What gets scaled, and why exactly these fields (all confirmed against the
# server's own parser in src/server/game/src/item_manager_read_tables.cpp):
#   • share/conf/mob_proto.txt   EXP, GOLD_MIN, GOLD_MAX  (columns located by
#     NAME in the header row, not by a fixed number)
#   • locale/<lang>/mob_drop_item.txt   the 4th value on each numbered line, but
#     ONLY in "Type drop" and "Type limit" blocks: in a "Type kill" block that
#     same value is read with str_to_number into an int and used as a share of
#     the group, so scaling it changes nothing and rounding it damages the group.
#   • locale/<lang>/common_drop_item.txt  the 4th column of each of the four
#     PAWN / S_PAWN / KNIGHT / S_KNIGHT blocks
#   • locale/<lang>/etc_drop_item.txt   the single probability after the tab
#
# The rates only take effect when the cores are next started — the tables are
# read once at startup. That is expected and is stated at the end of the hook.

# p_rate_sane VALUE -> a usable percentage. Anything missing, non-numeric, zero
# or absurd becomes 100 (= unchanged), so a bad value can never wreck a table.
p_rate_sane() {
    p_v="${1:-}"
    case "${p_v:-x}" in
        *[!0-9]*|'') echo 100; return 0 ;;
    esac
    [ "$p_v" -lt 1 ]     && { echo 100; return 0; }
    [ "$p_v" -gt 10000 ] && { echo 10000; return 0; }
    echo "$p_v"
}

# p_baseline FILE -> echoes the pristine copy to read from, creating it once.
# Returns non-zero when the file is not usable at all.
p_baseline() {
    [ -f "$1" ] || return 1
    if [ ! -f "$1.m2orig" ]; then
        cp -p "$1" "$1.m2orig" 2>>"$LOG" || return 1
    fi
    printf '%s' "$1.m2orig"
}

# p_install_table TMP TARGET -> move the rewritten table into place, safely
p_install_table() {
    [ -s "$1" ] || { rm -f "$1"; return 1; }
    # A symlink target must be followed, not replaced: db/mob_proto.txt is a
    # symlink to share/conf/mob_proto.txt and a mv would silently turn it into a
    # real file, leaving the db core reading a copy nobody updates any more.
    if [ -h "$2" ]; then
        cat "$1" > "$2" 2>>"$LOG" && rm -f "$1" && return 0
        rm -f "$1"; return 1
    fi
    mv "$1" "$2" 2>>"$LOG"
}

pack_apply_rates() {
    p_gd="${GAME_DIR:-/usr/metin2/server}"
    if [ ! -d "$p_gd" ]; then
        warn "The server folder ($p_gd) is not there — no rates to change"
        return 1
    fi
    p_exp=$(p_rate_sane "${RATE_EXP:-100}")
    p_drop=$(p_rate_sane "${RATE_DROP:-100}")
    p_yang=$(p_rate_sane "${RATE_YANG:-100}")
    p_n=0

    # ---------- monsters: experience and yang ----------
    # There is only ONE real mob_proto.txt in these files. db/mob_proto.txt looks
    # like a second copy but is a symlink to share/conf/mob_proto.txt, so writing
    # the real file updates both the db core and every game core at once.
    p_proto="$p_gd/share/conf/mob_proto.txt"
    [ -f "$p_proto" ] || p_proto=$(find "$p_gd/share" -maxdepth 3 -type f -name 'mob_proto.txt' 2>/dev/null | head -1)
    if [ -n "$p_proto" ] && p_src=$(p_baseline "$p_proto"); then
        p_tmp="$p_proto.m2new.$$"
        if LC_ALL=C awk -v e="$p_exp" -v y="$p_yang" '
            BEGIN { FS = "\t"; OFS = "\t" }
            function scale(v, pct,   r) {
                r = int(v * pct / 100 + 0.5)
                if (r < 1 && v + 0 > 0) r = 1     # never round a reward down to nothing
                if (r < 0) r = 0
                return r
            }
            NR == 1 {
                for (i = 1; i <= NF; i++) {
                    h = $i; gsub(/[ \r]/, "", h)
                    if (h == "EXP")           ce = i
                    else if (h == "GOLD_MIN") cmin = i
                    else if (h == "GOLD_MAX") cmax = i
                }
                width = NF
                print                     # header goes out byte for byte
                next
            }
            {
                # a row of a different shape is not something we understand —
                # pass it through untouched rather than guess
                if (NF != width) { print; next }
                # a rate of 100 means "leave it alone", so the field is not even
                # rewritten — 100% has to give the file back exactly as it was
                if (e != 100 && ce   && $ce   ~ /^[0-9]+$/) $ce   = scale($ce, e)
                if (y != 100 && cmin && $cmin ~ /^[0-9]+$/) $cmin = scale($cmin, y)
                if (y != 100 && cmax && $cmax ~ /^[0-9]+$/) $cmax = scale($cmax, y)
                print
            }
            END { if (!ce || !cmin || !cmax) exit 1 }
        ' "$p_src" > "$p_tmp" 2>>"$LOG" && p_install_table "$p_tmp" "$p_proto"; then
            ok "Monsters: experience ${p_exp}%, yang ${p_yang}%  (mob_proto.txt)"
            p_n=$((p_n + 1))
        else
            rm -f "$p_tmp"
            warn "mob_proto.txt could not be rewritten — it was left exactly as it was"
        fi
    else
        warn "mob_proto.txt not found — experience and yang were not changed"
    fi

    # ---------- drop chances ----------
    p_loc=$(p_locale_dir)
    if [ -z "$p_loc" ]; then
        warn "No locale folder under $p_gd/share/locale — drop chances were not changed"
    else
        # --- mob_drop_item.txt : the per-monster drop lists ---
        # The two extra files next to it (mob_drop_item.txt.edited and
        # mob_drop_item_hector.txt) are somebody's spare copies, are not read by
        # the server, and are deliberately left alone.
        p_mdi="$p_loc/mob_drop_item.txt"
        if [ -f "$p_mdi" ] && p_src=$(p_baseline "$p_mdi"); then
            p_tmp="$p_mdi.m2new.$$"
            if LC_ALL=C awk -v r="$p_drop" '
                BEGIN { FS = "\t"; OFS = "\t" }
                # print a percentage back without turning 0.2 into 0.200000
                function fmt(v,   s) {
                    if (v == int(v)) return sprintf("%d", v)
                    s = sprintf("%.9f", v)
                    sub(/0+$/, "", s); sub(/\.$/, "", s)
                    return s
                }
                # 100% means "unchanged", and unchanged has to mean byte for byte
                r == 100 { print; next }
                /^\{/ { type = ""; print; next }
                /^\}/ { type = ""; print; next }
                # keyword lines: "Type drop" — the spelling varies between blocks
                # (Type/type/"type ") so it is matched loosely and lower-cased.
                tolower($2) ~ /^type *$/ {
                    type = tolower($3); gsub(/[ \r]/, "", type)
                    print; next
                }
                # an item line: <tab> index <tab> vnum <tab> count <tab> percent
                $1 == "" && $2 ~ /^[0-9]+$/ && NF >= 5 {
                    if ((type == "drop" || type == "limit") && $5 ~ /^[0-9]+(\.[0-9]+)?$/) {
                        orig = $5 + 0
                        v = orig * r / 100
                        # a chance may not climb above 100%, but a few entries in
                        # this file already sit above it (a guaranteed drop), and
                        # those must keep their own value as the ceiling instead
                        # of being quietly cut down to 100.
                        lim = (orig > 100 ? orig : 100)
                        if (v > lim) v = lim
                        if (v < 0) v = 0
                        $5 = fmt(v)
                    }
                    print; next
                }
                { print }
            ' "$p_src" > "$p_tmp" 2>>"$LOG" && p_install_table "$p_tmp" "$p_mdi"; then
                ok "Monster drop lists: ${p_drop}%  (mob_drop_item.txt)"
                p_n=$((p_n + 1))
            else
                rm -f "$p_tmp"
                warn "mob_drop_item.txt could not be rewritten — left as it was"
            fi
        fi

        # --- common_drop_item.txt : the generic level-based drops ---
        # Four blocks of six columns (name, minlevel, maxlevel, percent, vnum,
        # count) for PAWN / S_PAWN / KNIGHT / S_KNIGHT, so the percentages are
        # columns 4, 10, 16 and 22. A couple of dozen rows in this file do NOT
        # follow that layout (they carry extra leading tabs and only three
        # blocks); a fixed column number would scale a LEVEL on those rows, so
        # every block is checked for shape first and skipped when it does not fit.
        p_cdi="$p_loc/common_drop_item.txt"
        if [ -f "$p_cdi" ] && p_src=$(p_baseline "$p_cdi"); then
            p_tmp="$p_cdi.m2new.$$"
            if LC_ALL=C awk -v r="$p_drop" '
                BEGIN { FS = "\t"; OFS = "\t" }
                function fmt(v,   s) {
                    if (v == int(v)) return sprintf("%d", v)
                    s = sprintf("%.9f", v)
                    sub(/0+$/, "", s); sub(/\.$/, "", s)
                    return s
                }
                r == 100 { print; next }
                {
                    for (b = 0; b < 4; b++) {
                        base = b * 6
                        if (NF < base + 6) continue
                        # min level, max level and item number must all be whole
                        # numbers, or this is not a block we recognise
                        if ($(base + 2) !~ /^[0-9]+$/) continue
                        if ($(base + 3) !~ /^[0-9]+$/) continue
                        if ($(base + 5) !~ /^[0-9]+$/) continue
                        if ($(base + 4) !~ /^[0-9]+(\.[0-9]+)?$/) continue
                        orig = $(base + 4) + 0
                        v = orig * r / 100
                        lim = (orig > 100 ? orig : 100)
                        if (v > lim) v = lim
                        if (v < 0) v = 0
                        $(base + 4) = fmt(v)
                    }
                    print
                }
            ' "$p_src" > "$p_tmp" 2>>"$LOG" && p_install_table "$p_tmp" "$p_cdi"; then
                ok "Common drops: ${p_drop}%  (common_drop_item.txt)"
                p_n=$((p_n + 1))
            else
                rm -f "$p_tmp"
                warn "common_drop_item.txt could not be rewritten — left as it was"
            fi
        fi

        # --- etc_drop_item.txt : one probability per item, after the last tab ---
        p_edi="$p_loc/etc_drop_item.txt"
        if [ -s "$p_edi" ] && p_src=$(p_baseline "$p_edi"); then
            p_tmp="$p_edi.m2new.$$"
            if LC_ALL=C awk -v r="$p_drop" '
                function fmt(v,   s) {
                    if (v == int(v)) return sprintf("%d", v)
                    s = sprintf("%.9f", v)
                    sub(/0+$/, "", s); sub(/\.$/, "", s)
                    return s
                }
                r == 100 { print; next }
                {
                    # the item name may contain spaces, so split on the LAST tab
                    i = 0
                    for (k = length($0); k >= 1; k--) {
                        if (substr($0, k, 1) == "\t") { i = k; break }
                    }
                    if (i == 0) { print; next }
                    head = substr($0, 1, i)
                    rest = substr($0, i + 1)
                    if (match(rest, /^[0-9]+(\.[0-9]+)?/) == 0) { print; next }
                    num  = substr(rest, 1, RLENGTH)
                    tail = substr(rest, RLENGTH + 1)      # keeps the trailing space
                    orig = num + 0
                    v = orig * r / 100
                    lim = (orig > 100 ? orig : 100)
                    if (v > lim) v = lim
                    if (v < 0) v = 0
                    print head fmt(v) tail
                }
            ' "$p_src" > "$p_tmp" 2>>"$LOG" && p_install_table "$p_tmp" "$p_edi"; then
                ok "Misc drops: ${p_drop}%  (etc_drop_item.txt)"
                p_n=$((p_n + 1))
            else
                rm -f "$p_tmp"
                warn "etc_drop_item.txt could not be rewritten — left as it was"
            fi
        fi

        # --- drop_item_group.txt : empty in these files, so there is nothing to do
        if [ -s "$p_loc/drop_item_group.txt" ]; then
            warn "drop_item_group.txt has content in this download but the installer only"
            warn "knows the empty version that ships with these files — it was NOT changed."
            warn "Adjust it by hand if you use it."
        fi
    fi

    if [ "$p_n" -eq 0 ]; then
        warn "No rate table could be changed — the rates are unchanged"
        return 1
    fi
    ok "Rates applied to $p_n table(s): experience ${p_exp}%, drops ${p_drop}%, yang ${p_yang}%"
    ok "The originals are kept next to each file as *.m2orig, and every change is"
    ok "always worked out from those — so setting 200% and then 300% gives 300%, not 600%."
    warn "The cores read these tables once, at startup: restart the server for the new rates."
    return 0
}

# ---------------------------------------------------------------
#  The downloadable Windows client
# ---------------------------------------------------------------
# The client already IS a zip (Client.zip, 1.29 GB). We still unpack it, because
# the server address has to go in and because two things must NOT reach players:
#   • ClientVS22.zip — the client's C++ source (it is a sibling file, so it is
#     simply never picked up)
#   • the Eternexus folder — the pack-building tool plus every language's raw
#     files. Several hundred MB nobody playing the game needs.
pack_prepare_client() {
    if [ -f /usr/local/m2panel/client.zip ]; then
        ok "Client already prepared, skipped"
        return 0
    fi
    if [ -z "${P_CLIENT_ZIP:-}" ] || [ ! -f "$P_CLIENT_ZIP" ]; then
        warn "Client.zip was not found in the archive — you can add it later and re-run"
        return 0
    fi
    if ! command -v unzip >/dev/null 2>&1 || ! command -v zip >/dev/null 2>&1; then
        warn "zip/unzip are not installed, so the client download cannot be built."
        warn "Run: pkg install -y zip unzip   and start the installer again."
        return 0
    fi
    mkdir -p /usr/local/m2panel

    # ---- room to work ------------------------------------------------------
    # We need the unpacked tree AND the new zip at the same time, so about two
    # and a half times the size of Client.zip. Checking first matters: running
    # out of disk half way through leaves a truncated zip that looks fine to the
    # panel and is broken for every player who downloads it. Everything is in KB,
    # and each number is validated on its own — comparing against an empty
    # operand is a shell error, so an unreadable value simply skips the check.
    p_need=$(du -k "$P_CLIENT_ZIP" 2>/dev/null | awk '{print $1}')
    p_free=$(df -k /usr/local/m2panel 2>/dev/null | awk 'END{print $(NF-2)}')
    case "${p_need:-x}" in *[!0-9]*) p_need="" ;; esac
    case "${p_free:-x}" in *[!0-9]*) p_free="" ;; esac
    if [ -n "$p_need" ] && [ -n "$p_free" ]; then
        p_want=$(( p_need / 2 * 5 ))      # 2.5x, written so it cannot overflow early
        if [ "$p_free" -lt "$p_want" ]; then
            warn "Not enough disk space to build the downloadable client."
            warn "Needed: about $((p_want / 1024)) MB   Free: $((p_free / 1024)) MB"
            warn "The server itself is completely fine — only the client download is skipped."
            warn "Free some space and run the installer again to build it later."
            return 0
        fi
    fi

    # ---- unpack, edit, repack ----------------------------------------------
    # The working copy goes under /usr/local/m2panel and NEVER under /tmp: on
    # many FreeBSD images /tmp is a tmpfs, i.e. RAM, and unpacking 1.3 GB into
    # RAM takes the whole machine down.
    p_work=/usr/local/m2panel/.clientwork
    rm -rf "$p_work"
    if ! mkdir -p "$p_work"; then
        warn "Could not create a working folder for the client — skipped"
        return 0
    fi
    warn "Unpacking the 1.3 GB client. This takes a few minutes — please let it run. ⏳"
    if ! ( cd "$p_work" && run unzip -q -o "$P_CLIENT_ZIP" ); then
        warn "Client.zip could not be unpacked — see $LOG"
        rm -rf "$p_work"
        return 0
    fi

    CLIENT_WORK="$p_work"
    pack_call pack_apply_ip "$p_work"

    # the client root is the folder holding the launcher
    p_exe=$(find "$p_work" -maxdepth 3 -type f -iname 'metin2*.exe' 2>/dev/null \
            | grep -ivE 'eternexus|dump_proto|vcredist|config\.exe' \
            | awk -F/ '{print NF "\t" $0}' | sort -n | cut -f2- | head -1)
    p_root="$p_work"
    [ -n "$p_exe" ] && p_root=$(dirname "$p_exe")
    p_exename="Metin2Distribute.exe"
    [ -n "$p_exe" ] && p_exename=$(basename "$p_exe")

    # the pack-building tool and every language's raw files: not for players
    p_etx=$(find "$p_root" -maxdepth 1 -type d -iname 'eternexus' 2>/dev/null | head -1)
    if [ -n "$p_etx" ] && rm -rf "$p_etx"; then
        ok "Left the Eternexus tool folder out of the player download"
    fi

    cat > "$p_root/README - How to Start the Game.txt" <<READMEEOF
==============================================
  🎮 HOW TO START THE GAME (takes 2 minutes)
==============================================

1) RIGHT-CLICK the downloaded zip -> "Extract All"
   and extract it to your desktop.

2) DOUBLE-CLICK the file  ${p_exename}  inside
   the folder. That is the game.
   (${p_exename} is the game itself. config.exe
   next to it is only for screen settings.)

3) If Windows shows an "unrecognized app" warning:
   click "More info" -> "Run anyway".
   (The game is safe — Windows only asks because it
   doesn't know the app.)

4) If the game won't start or shows a "d3dx9" error:
   search for "DirectX End-User Runtime" on Google,
   download it from Microsoft's website, install it,
   then try again.

5) Enter your username and password on the login screen.
   If you don't have an account yet, create one on the
   server's web page (the same address you downloaded from).

The server address is already set — you don't need to
change anything. Have fun! 🎉
READMEEOF
    ok "Start-here readme added (the game is: ${p_exename})"

    if ( cd "$p_root" && run zip -qr /usr/local/m2panel/client.zip . ); then
        ok "Downloadable client is ready — players can get it from the panel's login page 📥"
    else
        warn "Client could not be packaged — see $LOG"
        rm -f /usr/local/m2panel/client.zip
    fi
    rm -rf "$p_work"
    CLIENT_WORK=""
    return 0
}

# ---------------------------------------------------------------
#  The admin logins that ship inside the database
# ---------------------------------------------------------------
# Readme.txt states them in plain sight: "Ingame: admin/123456789". The password
# hash is inside metin2_mysql.tar.gz, which anyone on the internet can download,
# so left alone ANY stranger could log into this server as an implementor.
# The shipped database has two accounts, 'admin' and 'test', and they share that
# one hash — so 'test' is just as dangerous and gets blocked.
# (For the record: MySQL's own root password ships as 123456789 too. The engine
# has already rotated that one before this hook runs.)
pack_secure_admin_accounts() {
    if ! db_login_ok "$DB_PASS"; then
        warn "No database access — the built-in admin accounts were left untouched."
        warn "Change the 'admin' password yourself before opening the server!"
        return 0
    fi
    p_acc="${DB_ACCOUNT:-account}"
    ADMIN_PASS_SQL=$(sql_escape "$ADMIN_PASS")
    # MariaDB computes the hash itself: PASSWORD() = '*' + hex(SHA1(SHA1(pw))),
    # which is exactly the format this account table stores.
    if db_exec "$DB_PASS" "UPDATE ${p_acc}.account SET password = PASSWORD('$ADMIN_PASS_SQL') WHERE login = 'admin';"; then
        ok "The in-game 'admin' account got a new password"
        ADMIN_SECURED=1
    else
        warn "The 'admin' account password could not be changed — please change it by"
        warn "hand before opening the server!"
    fi

    # Any other account still on the factory password is just as open. Rather
    # than hard-coding names, ask the database which accounts share the hash of
    # the well-known password and block those (blocking is reversible; deleting
    # somebody's account is not).
    p_extra=$(db_query "$DB_PASS" \
        "SELECT login FROM ${p_acc}.account WHERE password = PASSWORD('123456789') AND login <> 'admin';" 2>/dev/null)
    if [ -n "$p_extra" ]; then
        p_list=""
        for p_a in $p_extra; do
            p_list="${p_list}${p_list:+,}'$(sql_escape "$p_a")'"
        done
        if db_exec "$DB_PASS" "UPDATE ${p_acc}.account SET status = 'BLOCK' WHERE login IN ($p_list);"; then
            ok "Other accounts still on the shipped password were blocked: $(printf '%s' "$p_extra" | tr '\n' ' ')"
        else
            warn "These accounts still use the publicly known password and could not be"
            warn "blocked — deal with them by hand: $(printf '%s' "$p_extra" | tr '\n' ' ')"
        fi
    else
        ok "No other account is still using the shipped password"
    fi
    return 0
}

# =============================================================================
#  Instant in-game actions — the source patch and the rebuild
# =============================================================================
# The panel's teleport and running-speed buttons need one small function added to
# the game core's C++ source (mysql_direct_query, so a quest can read the panel's
# command queue) and the core rebuilt.
#
#  ⚠  THIS HOOK USED TO REFUSE TO BUILD. That refusal was wrong.  ⚠
#
# It quoted TMP4's own FAQ.txt — "Compiling only possible in a x32 system",
# "compiling the source is only possible in 32-bit FreeBSD" — and gave up. The
# whole procedure below was then done by hand on a real FreeBSD 14.4 amd64 box
# and on two live servers, where it builds and runs. What the FAQ describes is
# one way to solve one specific problem, not the only way, and the difference is
# worth spelling out because it is the entire reason this hook exists again:
#
#   • The COMPILER is not the problem. The Makefile already asks for -m32, and
#     FreeBSD 14's base clang (19.1.7) compiles this -std=c++23 -m32 source
#     without complaint. There is no 32-bit compiler to install.
#   • The LINKER is the problem, and only for ONE file. Everything the game core
#     links is either built here as 32-bit (libgame.a, libthecore.a, libsql.a,
#     liblua.a, libpoly.a, libserverkey.a and the two in src/extern/lib) or comes
#     out of /usr/lib32, which FreeBSD installs as part of the base system. The
#     single exception is /usr/local/lib/mysql/libmysqlclient.a, which pkg
#     installed for the host architecture — so on amd64 it is 64-bit and the link
#     fails on that library alone.
#   • FreeBSD publishes i386 packages for the same release. So we fetch the i386
#     build of the MariaDB client, take the one static library out of it, and
#     point the Makefile at that. No jail, no second FreeBSD install, ~4 MB
#     downloaded and nothing installed on the system.
#
# Four things are changed, all of them reversible, all of them idempotent:
#
#   1. a 32-bit libmysqlclient.a is put in src/extern/lib32/
#   2. src/server/game/src/Makefile is retargeted: clang++-devel -> clang++
#      (the -devel compiler is a port nobody has installed; base clang is fine),
#      the MySQL library -> our 32-bit copy, and libz/libssl/libcrypto ->
#      /usr/lib32/
#   3. questlua_global.cpp gains _mysql_direct_query and its table entry
#   4. questlua_pc.cpp gets a one-line NULL check that fixes a real crash (see
#      p_sp_patch_pc — it takes the whole core down, and not only for us)
#
# Everything overwritten is copied to <file>.pre-patch first, backups are never
# overwritten by a later run, and on ANY failure every one of them is put back and
# the hook still returns 0. A failed patch must never abort the install.
# -----------------------------------------------------------------------------

# Where the i386 package is fetched to. Both under /root and NOT under /tmp: /tmp
# is a memory disk on many FreeBSD images, and these are root-only working files.
P_SP_REPOS=/root/i386repos
P_SP_CACHE=/root/i386cache
# Scratch space for the generated C++ snippet.
P_SP_WORK=/root/.m2-r40250-srcpatch

# p_file_newer FILE REFERENCE -> 0 when FILE exists and is newer than REFERENCE
p_file_newer() {
    [ -f "$1" ] || return 1
    [ -f "$2" ] || return 1
    [ -n "$(find "$1" -newer "$2" 2>/dev/null)" ]
}

# p_sp_mkvar NAME DEFAULT -> the value of a plain "NAME = value" line in the
# Makefile. Used for OBJDIR and GAMEDIR rather than hard-coding them, because
# those two decide where the object files and the finished binary end up and a
# wrong guess would make the "did it build?" test lie.
p_sp_mkvar() {
    p_sp_v=$(awk -v n="$1" '
        $0 ~ ("^" n "[ \t]*=") { sub(/^[^=]*=[ \t]*/, ""); sub(/[ \t]+$/, ""); print; exit }
    ' "$P_SP_MK" 2>/dev/null)
    if [ -n "$p_sp_v" ]; then printf '%s' "$p_sp_v"; else printf '%s' "$2"; fi
}

# ---------------------------------------------------------------
#  The 32-bit MySQL client library
# ---------------------------------------------------------------
# p_sp_i386_pkg -> the package to fetch, WORKED OUT FROM $PACK_DB_PKGS rather
# than hard-coded. The library has to match the MariaDB this pack installs, so if
# PACK_DB_PKGS is ever moved to another version this follows it automatically.
p_sp_i386_pkg() {
    for p_sp_w in ${PACK_DB_PKGS:-}; do
        case "$p_sp_w" in *client*) printf '%s' "$p_sp_w"; return 0 ;; esac
    done
    for p_sp_w in ${PACK_DB_PKGS:-}; do
        case "$p_sp_w" in *-server) printf '%s' "${p_sp_w%-server}-client"; return 0 ;; esac
    done
    printf 'mariadb1011-client'
}

# p_sp_i386_abi -> the i386 ABI string for THIS FreeBSD release, e.g.
# "FreeBSD:14:i386". Taken from pkg itself and only the architecture swapped, so
# a FreeBSD 15 box asks for FreeBSD:15:i386 and not for a release that has no
# packages built for it.
p_sp_i386_abi() {
    p_sp_a=$(pkg config ABI 2>/dev/null)
    case "$p_sp_a" in
        FreeBSD:*:*) printf '%s:i386' "${p_sp_a%:*}"; return 0 ;;
    esac
    p_sp_v=$(uname -r 2>/dev/null | sed -e 's/[^0-9].*//')
    case "${p_sp_v:-x}" in ''|*[!0-9]*) p_sp_v=14 ;; esac
    printf 'FreeBSD:%s:i386' "$p_sp_v"
}

# p_sp_get_i386_lib -> 0 once $P_SP_LIB32/libmysqlclient.a is a 32-bit library.
# Nothing is installed on the system: the package is only FETCHED and unpacked,
# and the single .a file we need is copied out.
p_sp_get_i386_lib() {
    if [ -s "$P_SP_LIB32/libmysqlclient.a" ]; then
        ok "The 32-bit MySQL client library is already in place ($P_SP_LIB32)"
        return 0
    fi
    if ! command -v pkg >/dev/null 2>&1; then
        warn "There is no 'pkg' command on this machine, so the 32-bit MySQL library"
        warn "cannot be fetched."
        return 1
    fi
    if ! mkdir -p "$P_SP_LIB32" "$P_SP_REPOS" "$P_SP_CACHE" 2>>"$LOG"; then
        warn "Could not create $P_SP_LIB32 — the rebuild cannot go ahead"
        return 1
    fi

    # ---- why a repository list of our own, and not the system one -----------
    # THIS IS THE STEP THAT MAKES IT WORK AT ALL. The stock configuration on a
    # modern FreeBSD also carries a "FreeBSD-kmods" repository, and that one has
    # no i386 build. Asking pkg for i386 packages with the default REPOS_DIR
    # therefore makes it fetch a repository index that does not exist, and the
    # 404 aborts the whole update — including the perfectly healthy main
    # repository. Pointing REPOS_DIR at a directory holding only the main
    # repository sidesteps that completely and touches nothing on the system.
    # ${ABI} below is written literally into the file on purpose: pkg expands it
    # itself, which is why the single quotes must stay single quotes.
    if ! printf 'FreeBSD: { url: "pkg+https://pkg.FreeBSD.org/${ABI}/latest", mirror_type: "srv", enabled: yes }\n' \
         > "$P_SP_REPOS/FreeBSD.conf" 2>>"$LOG"; then
        warn "Could not write $P_SP_REPOS/FreeBSD.conf"
        return 1
    fi

    p_sp_pkg=$(p_sp_i386_pkg)
    p_sp_abi=$(p_sp_i386_abi)
    ok "Fetching the 32-bit $p_sp_pkg package ($p_sp_abi) — a few MB, nothing is installed"
    if ! run env ABI="$p_sp_abi" pkg -o REPOS_DIR="$P_SP_REPOS" -o PKG_CACHEDIR="$P_SP_CACHE" \
              fetch -y -d "$p_sp_pkg"; then
        warn "The i386 package could not be fetched — see $LOG"
        return 1
    fi

    p_sp_file=$(find "$P_SP_CACHE" -type f -name "$p_sp_pkg-*" 2>/dev/null | head -1)
    if [ -z "$p_sp_file" ]; then
        warn "pkg reported success but no $p_sp_pkg package is in $P_SP_CACHE"
        return 1
    fi

    # A .pkg IS a tarball. tar -xf, never -xzf — see the box at the top of this
    # file; which compression pkg uses is pkg's business and it has changed before.
    p_sp_tmp="$P_SP_LIB32/.unpack.$$"
    rm -rf "$p_sp_tmp"
    if ! mkdir -p "$p_sp_tmp" 2>>"$LOG" || ! ( cd "$p_sp_tmp" && run tar -xf "$p_sp_file" ); then
        warn "$(basename "$p_sp_file") could not be unpacked — see $LOG"
        rm -rf "$p_sp_tmp"
        return 1
    fi

    # libmysqlclient.a inside the package is a SYMLINK to libmariadbclient.a, and
    # copying a dangling symlink out of a folder we are about to delete would give
    # us nothing at all. "find -type f" only ever returns the real file, which is
    # exactly what we want; our copy is then named the way the Makefile expects.
    p_sp_a=""
    for p_sp_c in libmariadbclient.a libmysqlclient.a; do
        p_sp_a=$(find "$p_sp_tmp" -type f -name "$p_sp_c" 2>/dev/null | head -1)
        [ -n "$p_sp_a" ] && break
    done
    if [ -z "$p_sp_a" ]; then
        warn "No static MySQL client library inside $(basename "$p_sp_file")"
        rm -rf "$p_sp_tmp"
        return 1
    fi
    if ! cp "$p_sp_a" "$P_SP_LIB32/libmysqlclient.a" 2>>"$LOG"; then
        warn "Could not copy $(basename "$p_sp_a") into $P_SP_LIB32"
        rm -rf "$p_sp_tmp"
        return 1
    fi
    rm -rf "$p_sp_tmp"

    # ---- is it really 32-bit? ----------------------------------------------
    # file(1) on an .a only says "current ar archive", so the honest check is on
    # one of the objects inside it, which must be "ELF 32-bit LSB relocatable,
    # Intel 80386". If ar or file is missing we say so and carry on rather than
    # refuse: the linker would catch a 64-bit library anyway, and a failed link
    # puts everything back.
    p_sp_m=$(ar t "$P_SP_LIB32/libmysqlclient.a" 2>/dev/null | head -1)
    if [ -n "$p_sp_m" ] && command -v file >/dev/null 2>&1; then
        ( cd "$P_SP_LIB32" && ar p libmysqlclient.a "$p_sp_m" > .probe.o ) 2>>"$LOG"
        p_sp_t=$(file -b "$P_SP_LIB32/.probe.o" 2>/dev/null)
        rm -f "$P_SP_LIB32/.probe.o"
        case "$p_sp_t" in
            *32-bit*)
                ok "32-bit MySQL client library ready: $p_sp_t" ;;
            '')
                warn "The library could not be inspected — carrying on, the linker checks it too" ;;
            *)
                warn "The fetched library is not 32-bit ($p_sp_t) — not using it"
                rm -f "$P_SP_LIB32/libmysqlclient.a"
                return 1 ;;
        esac
    else
        ok "32-bit MySQL client library placed in $P_SP_LIB32"
    fi
    return 0
}

# ---------------------------------------------------------------
#  The Makefile
# ---------------------------------------------------------------
# Four substitutions, and every one of them is a replacement of a 64-bit thing by
# its 32-bit twin (all four /usr/lib32 libraries are part of the FreeBSD base
# system and were confirmed present on a stock 14.4 install), plus the compiler
# name. Nothing else in this Makefile is touched — -m32, -std=c++23, the file
# list and the "move the binary" rule all stay as TMP4 wrote them.
p_sp_mk_dirty() { # 0 while the Makefile still points at something 64-bit
    grep -q 'clang++-devel'                         "$1" 2>/dev/null && return 0
    grep -q '/usr/local/lib/mysql/libmysqlclient\.a' "$1" 2>/dev/null && return 0
    grep -q '/usr/lib/libz\.a'                       "$1" 2>/dev/null && return 0
    grep -q '/usr/lib/libssl\.a'                     "$1" 2>/dev/null && return 0
    grep -q '/usr/lib/libcrypto\.a'                  "$1" 2>/dev/null && return 0
    return 1
}

p_sp_patch_makefile() { # p_sp_patch_makefile MAKEFILE LIB32DIR
    # the directory becomes part of a sed replacement, so \ & and the delimiter
    # have to be escaped first
    p_sp_l=$(printf '%s' "$2" | sed -e 's,[\&|],\\&,g')
    sed -i '' \
        -e 's|^CC[[:blank:]]*=[[:blank:]]*clang++-devel[[:blank:]]*$|CC = clang++|' \
        -e "s|/usr/local/lib/mysql/libmysqlclient\\.a|$p_sp_l/libmysqlclient.a|g" \
        -e 's|/usr/lib/libz\.a|/usr/lib32/libz.a|g' \
        -e 's|/usr/lib/libssl\.a|/usr/lib32/libssl.a|g' \
        -e 's|/usr/lib/libcrypto\.a|/usr/lib32/libcrypto.a|g' \
        "$1" >>"$LOG" 2>&1 || return 1
    # running it twice must be a no-op, and it is: none of the five patterns can
    # match the text it was replaced by ("/usr/lib32/libz.a" does not contain
    # "/usr/lib/libz.a"). So "still dirty afterwards" means it genuinely failed.
    p_sp_mk_dirty "$1" && return 1
    return 0
}

# ---------------------------------------------------------------
#  questlua_global.cpp — the function quests call
# ---------------------------------------------------------------
# p_sp_write_func FILE -> writes the C++ to add. This is kept HERE and is
# deliberately NOT read out of ADD_SQL_BINDING.md: that document was written for
# the Fliege source and its version passes the query as a printf argument
# (DirectQuery("%s", q)). What was built and run against THESE files passes the
# query straight through, so that is what goes in. web_admin.quest's own queries
# contain no '%', which is what makes the direct form safe here.
p_sp_write_func() {
    cat > "$1" <<'P_SP_CPPEOF'
	// ---- added by the Metin2 installer -----------------------------------
	// Lets a quest run one SQL statement and get the rows back as a table.
	// SELECT  -> { [1] = { column = value, ... }, ..., n = <row count> }
	// anything else -> the number of affected rows
	// The "n" entry is not decoration: table.getn() in this Lua reads it.
	int _mysql_direct_query(lua_State* L)
	{
		if (!lua_isstring(L, 1)) { lua_pushnumber(L, 0); return 1; }
		const char * c_pszQuery = lua_tostring(L, 1);
		std::unique_ptr<SQLMsg> pmsg(DBManager::instance().DirectQuery(c_pszQuery));
		if (!pmsg.get() || !pmsg->Get()) { lua_pushnumber(L, 0); return 1; }
		if (!pmsg->Get()->pSQLResult) { lua_pushnumber(L, (double) pmsg->Get()->uiAffectedRows); return 1; }
		MYSQL_RES *   pRes    = pmsg->Get()->pSQLResult;
		int           nRows   = (int) pmsg->Get()->uiNumRows;
		int           nFields = (int) mysql_num_fields(pRes);
		MYSQL_FIELD * pFields = mysql_fetch_fields(pRes);
		lua_newtable(L);
		for (int i = 0; i < nRows; ++i) {
			MYSQL_ROW row = mysql_fetch_row(pRes);
			if (!row) break;
			lua_pushnumber(L, i + 1);
			lua_newtable(L);
			for (int j = 0; j < nFields; ++j) {
				lua_pushstring(L, pFields[j].name);
				lua_pushstring(L, row[j] ? row[j] : "");
				lua_settable(L, -3);
			}
			lua_settable(L, -3);
		}
		lua_pushstring(L, "n");   // table.getn() needs this
		lua_pushnumber(L, nRows);
		lua_settable(L, -3);
		return 1;
	}
	// ---- end of the installer's addition ---------------------------------
P_SP_CPPEOF
    [ -s "$1" ]
}

# p_sp_patch_global CPP FUNCFILE -> non-zero if any of the three edits did not fit
#
# Three edits, all anchored on TEXT and never on line numbers, so they still land
# correctly in a source somebody has already edited:
#
#   1) #include "db.h" — after the LAST #include that comes before
#      "namespace quest", which in a stock file is #include "sectree_manager.h".
#
#      THE ORDER OF THIS ONE INCLUDE IS THE WHOLE TRICK, and putting it at the
#      top of the file (the obvious place) breaks the build outright:
#      db.h pulls in AsyncSQL.h, which does "#define QUERY_MAX_LEN 8192", while
#      common/length.h — reached through constants.h — DECLARES an enum constant
#      of exactly that name. Include db.h first and the enum line expands to
#          8192 = 8192,
#      which is a syntax error a hundred lines away from anything we wrote. With
#      db.h last, length.h has long since been read and the macro only ever
#      replaces a name that already means the same number. The awk below refuses
#      to patch at all if the anchor it found is not after constants.h.
#
#   2) the function itself, in the gap in front of RegisterGlobalFunctionTable —
#      which puts it inside "namespace quest", where every other _foo() lives.
#
#   3) the name, straight after the { "warp_all_in_area_to_area", ... } entry;
#      and if that entry is ever renamed, in front of the { NULL, NULL } end
#      marker of the table that holds "get_channel_id", so no other table in the
#      file can be hit by mistake.
p_sp_patch_global() {
    # The caller already skips us when the file is patched, but guard here too:
    # this function is NOT idempotent on its own (it would insert the function a
    # second time and the file would stop compiling), and that is a nasty way for
    # someone calling it directly to lose an afternoon.
    if grep -q 'mysql_direct_query' "$1" 2>/dev/null; then
        return 0
    fi
    awk -v fnfile="$2" -v cppfile="$1" '
        BEGIN {
            while ((getline l < fnfile) > 0) fntext = fntext l "\n"
            close(fnfile)
            rgtext = "\t\t\t{\t\"mysql_direct_query\",\t\t\t_mysql_direct_query\t\t\t},\n"
            if (fntext == "") exit 1
            # find the include anchor by reading the file once first
            n = 0
            while ((getline l < cppfile) > 0) {
                n++
                if (!nsline && l ~ /^[ \t]*namespace[ \t]+quest([ \t]*\{)?[ \t]*$/) nsline = n
                if (!nsline && l ~ /^[ \t]*#[ \t]*include/) lastinc = n
                if (!constline && l ~ /^[ \t]*#[ \t]*include[ \t]*"constants\.h"/) constline = n
            }
            close(cppfile)
            # no anchor, no constants.h, or an anchor that would put db.h BEFORE
            # constants.h: refuse rather than produce a file that cannot compile
            if (!lastinc || !constline || !nsline) exit 1
            if (lastinc < constline) exit 1
        }
        FNR == lastinc { print; print "#include \"db.h\""; inc = 1; next }
        !fn && /^[ \t]*void[ \t]+RegisterGlobalFunctionTable[ \t]*\(/ {
            printf "%s", fntext; print ""; fn = 1; print; next
        }
        index($0, "\"get_channel_id\"") { intable = 1 }
        !rg && index($0, "\"warp_all_in_area_to_area\"") {
            print; printf "%s", rgtext; rg = 1; next
        }
        !rg && intable && /^[ \t]*\{[ \t]*NULL/ {
            printf "%s", rgtext; rg = 1; print; next
        }
        { print }
        END { if (!inc || !fn || !rg) exit 1 }
    ' "$1" > "$1.new" 2>>"$LOG" || { rm -f "$1.new"; return 1; }

    # a look at the result before it replaces a source file that compiles today
    [ -s "$1.new" ] || { rm -f "$1.new"; return 1; }
    [ "$(grep -c 'mysql_direct_query' "$1.new")" -ge 2 ] || { rm -f "$1.new"; return 1; }
    [ "$(wc -l < "$1.new")" -gt "$(wc -l < "$1")" ]      || { rm -f "$1.new"; return 1; }
    mv "$1.new" "$1"
}

# ---------------------------------------------------------------
#  questlua_pc.cpp — a genuine crash in these files
# ---------------------------------------------------------------
# pc_select_vid() is what a quest calls as pc.select(vid). It switches the
# "current player" to another character and returns the VID of the one that was
# current before — and it reads that previous character WITHOUT checking whether
# there was one:
#
#       LPCHARACTER ch = CQuestManager::instance().GetCurrentCharacterPtr();
#       ...
#       lua_pushnumber(L, (DWORD)ch->GetVID());     // ch may be NULL
#
# Inside a server timer there IS no current character, so ch is NULL and the
# core dies with SIGSEGV, taking every player on that channel with it. Confirmed
# from a core dump here: VID::operator unsigned int (this=0x00000100).
#
# This is not our bug and it is not specific to the panel: ANY timer-driven quest
# that calls pc.select() crashes this core, and other Metin2 sources guard the
# same line. One conditional fixes it, and it changes nothing for the normal case
# where a player really is current.
#
# It is written as a plain text substitution rather than an insertion so it is
# idempotent for free: the patched line no longer contains the pattern.
p_sp_patch_pc() {
    grep -q 'ch ? (DWORD)ch->GetVID()' "$1" 2>/dev/null && return 0   # already done
    grep -q 'lua_pushnumber(L, (DWORD)ch->GetVID());' "$1" 2>/dev/null || return 1
    sed -i '' \
        -e 's|lua_pushnumber(L, (DWORD)ch->GetVID());|lua_pushnumber(L, ch ? (DWORD)ch->GetVID() : 0);|' \
        "$1" >>"$LOG" 2>&1 || return 1
    grep -q 'ch ? (DWORD)ch->GetVID()' "$1" 2>/dev/null
}

# ---------------------------------------------------------------
#  Backups and the way back
# ---------------------------------------------------------------
p_sp_backup() { # p_sp_backup FILE -> keep a .pre-patch copy, made ONCE
    [ -f "$1" ] || return 0
    [ -f "$1.pre-patch" ] && return 0        # never overwrite an older way back
    cp "$1" "$1.pre-patch" >>"$LOG" 2>&1
}

p_sp_restore() { # put every original back, and forget the half-built objects
    for p_sp_f in "$P_SP_CPP" "$P_SP_PC" "$P_SP_MK" "$P_SP_BIN"; do
        [ -f "$p_sp_f.pre-patch" ] && cp "$p_sp_f.pre-patch" "$p_sp_f" >>"$LOG" 2>&1
    done
    # An interrupted build leaves object files made from the patched sources
    # behind. Left there, the next attempt would link them against the restored
    # source and produce something that matches neither.
    rm -f "$P_SP_OBJ/questlua_global.o" "$P_SP_OBJ/questlua_pc.o"
    return 0
}

# The honest fallback, kept from the version of this hook that could not build at
# all. It is now only reached when the i386 package genuinely cannot be fetched —
# no network, a release with no i386 packages built, a mirror that is down.
p_sp_jail_note() {
    warn "The 32-bit MySQL client library could not be fetched, and that one library"
    warn "is the only thing standing between this machine and a working build."
    warn ""
    warn "  Nothing was changed — the server files are exactly as they were."
    warn ""
    warn "  What still works, which is nearly everything:"
    warn "  • Items, yang and levels all work from the panel. They arrive through the"
    warn "    panel's database fallback, so it takes a few seconds instead of being"
    warn "    instant, and the player may need to relog to see them."
    warn "  • Accounts, bans, players, the shop and the statistics are unaffected."
    warn "  Only two things are missing: teleporting a player, and changing their"
    warn "  running speed."
    warn ""
    warn "  To try again: check that this machine can reach pkg.FreeBSD.org and re-run"
    warn "  the installer. The command it uses is in $LOG."
    warn "  The other way, which needs no network trick, is TMP4's own route — build"
    warn "  in a 32-bit jail and copy share/bin/game back. The tutorial FAQ.txt links"
    warn "  under \"Can I compile the source in a x64 vps somehow?\":"
    warn "    https://github.com/martysama0134/how-to-general/blob/master/freebsd-tips/how-to-setup-a-quick-32bit-jail.md"
    return 0
}

# ---------------------------------------------------------------
#  Is the binary on disk built from what is on disk now?
# ---------------------------------------------------------------
p_sp_built_ok() {
    [ -s "$P_SP_BIN" ] || return 1
    p_file_newer "$P_SP_BIN" "$P_SP_CPP" || return 1
    p_file_newer "$P_SP_BIN" "$P_SP_PC"  || return 1
    # Newer is not the same as containing our function — a rebuild that failed
    # half way can still leave a fresh timestamp on the old file. The name of a
    # Lua binding survives into the binary as a plain string, so this is a direct
    # question: is the function actually in there?
    command -v strings >/dev/null 2>&1 || return 0
    p_sp_n=$(strings -a "$P_SP_BIN" 2>/dev/null | grep -c 'mysql_direct_query')
    case "${p_sp_n:-x}" in ''|*[!0-9]*) p_sp_n=0 ;; esac
    [ "$p_sp_n" -gt 0 ]
}

# ---------------------------------------------------------------
#  The hook
# ---------------------------------------------------------------
pack_patch_source() {
    # ---- 1. where everything is --------------------------------------------
    P_SP_SRC=/usr/metin2/src/server/game/src
    if [ ! -f "$P_SP_SRC/questlua_global.cpp" ]; then
        p_sp_f=$(find /usr/metin2 -type f -name 'questlua_global.cpp' 2>/dev/null | head -1)
        [ -n "$p_sp_f" ] && P_SP_SRC=$(dirname "$p_sp_f")
    fi
    P_SP_CPP="$P_SP_SRC/questlua_global.cpp"
    P_SP_PC="$P_SP_SRC/questlua_pc.cpp"
    P_SP_MK="$P_SP_SRC/Makefile"
    if [ ! -f "$P_SP_CPP" ] || [ ! -f "$P_SP_PC" ] || [ ! -f "$P_SP_MK" ]; then
        warn "The game source is not on this machine (nothing under /usr/metin2/src that"
        warn "looks like server/game/src), so there is nothing to change. The panel keeps"
        warn "working for items, yang and levels — only teleport and running speed stay"
        warn "unavailable."
        return 0
    fi
    # .../src/server/game/src  ->  .../src  ->  .../src/extern/lib32
    P_SP_LIB32="$(dirname "$(dirname "$(dirname "$P_SP_SRC")")")/extern/lib32"
    # both read out of the Makefile, because both are its decisions, not ours
    P_SP_OBJ="$P_SP_SRC/$(p_sp_mkvar OBJDIR OBJDIR)"
    P_SP_BIN="$(p_sp_mkvar GAMEDIR "${GAME_DIR:-/usr/metin2/server}/share/bin")/game"

    # ---- 2. never while the server is up ------------------------------------
    # FreeBSD refuses to replace a program that is running ("Text file busy"), and
    # this Makefile's very last act is to move the new binary over share/bin/game,
    # which every one of the fourteen cores symlinks to. So a build now would take
    # three minutes and then fail on the last line. Say so instead.
    if p_any_core_running; then
        warn "The game server is running right now, and this system does not allow a"
        warn "program to be replaced while it is in use. Nothing was changed."
        warn "Stop the server first (cd ${GAME_DIR:-/usr/metin2/server} && sh close.sh),"
        warn "then run this installer again to enable teleport and running speed."
        return 0
    fi

    # ---- 3. is there anything left to do at all? ---------------------------
    # "Already patched" is answered by looking at the files themselves, never by a
    # marker file somebody could delete: the function name in questlua_global.cpp,
    # the NULL check in questlua_pc.cpp, no 64-bit target left in the Makefile,
    # and a binary that is newer than both sources AND has the function in it.
    p_sp_cpp_done=0; grep -q 'mysql_direct_query' "$P_SP_CPP" 2>/dev/null && p_sp_cpp_done=1
    p_sp_pc_done=0;  grep -q 'ch ? (DWORD)ch->GetVID()' "$P_SP_PC" 2>/dev/null && p_sp_pc_done=1
    p_sp_mk_done=0;  p_sp_mk_dirty "$P_SP_MK" || p_sp_mk_done=1
    if [ "$p_sp_cpp_done$p_sp_pc_done$p_sp_mk_done" = "111" ] && p_sp_built_ok; then
        ok "The source is already patched and the game program is already built from it"
        ok "— nothing to do. web_admin.quest picks the function up on its own."
        return 0
    fi
    [ "$p_sp_cpp_done" = "1" ] && ok "questlua_global.cpp is already patched — leaving it alone"
    [ "$p_sp_pc_done"  = "1" ] && ok "questlua_pc.cpp is already patched — leaving it alone"
    [ "$p_sp_mk_done"  = "1" ] && ok "The Makefile is already retargeted — leaving it alone"

    # ---- 4. the 32-bit library, BEFORE anything is modified -----------------
    # Deliberately first: if this cannot be done, no backup has been taken and no
    # file has been touched, so "nothing was changed" in the message below is
    # literally true.
    if ! p_sp_get_i386_lib; then
        p_sp_jail_note
        return 0
    fi

    # ---- 5. backups ---------------------------------------------------------
    for p_sp_f in "$P_SP_CPP" "$P_SP_PC" "$P_SP_MK" "$P_SP_BIN"; do
        p_sp_backup "$p_sp_f" || {
            warn "A backup of $(basename "$p_sp_f") could not be made — stopping here to be"
            warn "safe. Nothing was changed. The panel keeps working without this feature."
            return 0
        }
    done

    # ---- 6. the three patches ----------------------------------------------
    if [ "$p_sp_mk_done" != "1" ]; then
        if p_sp_patch_makefile "$P_SP_MK" "$P_SP_LIB32"; then
            ok "Makefile retargeted: base clang, 32-bit MySQL client, /usr/lib32 for z/ssl/crypto"
        else
            warn "The Makefile could not be retargeted — everything was put back. See $LOG."
            p_sp_restore
            return 0
        fi
    fi

    if [ "$p_sp_cpp_done" != "1" ]; then
        rm -rf "$P_SP_WORK"
        if ! mkdir -p "$P_SP_WORK" 2>>"$LOG"; then
            P_SP_WORK="/tmp/m2patch.$$"
            rm -rf "$P_SP_WORK"
            mkdir -p "$P_SP_WORK" 2>>"$LOG" || {
                warn "No working folder could be created — everything was put back."
                p_sp_restore
                return 0
            }
        fi
        if ! p_sp_write_func "$P_SP_WORK/func.cpp" \
           || ! p_sp_patch_global "$P_SP_CPP" "$P_SP_WORK/func.cpp"; then
            warn "The patch did not fit questlua_global.cpp, so it was NOT applied and every"
            warn "file was put back exactly as it was. Nothing is broken; see $LOG."
            warn "The panel keeps working; only teleport and running speed stay unavailable."
            rm -rf "$P_SP_WORK"
            p_sp_restore
            return 0
        fi
        rm -rf "$P_SP_WORK"
        ok "questlua_global.cpp: mysql_direct_query added and registered"
    fi

    if [ "$p_sp_pc_done" != "1" ]; then
        if p_sp_patch_pc "$P_SP_PC"; then
            ok "questlua_pc.cpp: pc.select() no longer crashes the core inside a timer"
        else
            warn "The one-line fix did not fit questlua_pc.cpp, so everything was put back."
            warn "Nothing is broken; see $LOG."
            p_sp_restore
            return 0
        fi
    fi

    # ---- 7. memory ----------------------------------------------------------
    # Compiling ~160 files is cheap; LINKING them plus a dozen static libraries
    # into one 32-bit binary is the step that runs out of RAM on a small VPS, and
    # an out-of-memory kill looks exactly like a compile error in the log. Warn
    # while the user can still do something about it.
    p_sp_ram=$(sysctl -n hw.physmem 2>/dev/null)
    p_sp_swap=$(swapinfo -k 2>/dev/null | awk 'END{print $2}')
    case "${p_sp_ram:-x}"  in ''|*[!0-9]*) p_sp_ram="" ;;  esac
    case "${p_sp_swap:-x}" in ''|*[!0-9]*) p_sp_swap="" ;; esac
    if [ -n "$p_sp_ram" ] && [ "$p_sp_ram" -lt 2000000000 ]; then
        if [ -z "$p_sp_swap" ] || [ "$p_sp_swap" -lt 1000000 ]; then
            warn "This machine has about $((p_sp_ram / 1024 / 1024)) MB of RAM and little or no swap."
            warn "Linking the game program may run out of memory. If it fails, add swap and"
            warn "re-run the installer — 2 GB is plenty. On FreeBSD swap files go through"
            warn "an md(4) device, so it is these four lines and not the Linux ones:"
            warn "    dd if=/dev/zero of=/usr/swap0 bs=1m count=2048"
            warn "    chmod 0600 /usr/swap0"
            warn "    echo 'md99 none swap sw,file=/usr/swap0 0 0' >> /etc/fstab"
            warn "    swapon -aL"
            warn "Nothing breaks if it does fail: the original program is put straight back."
        fi
    fi

    # ---- 8. the build -------------------------------------------------------
    warn "Now rebuilding the game program. About three minutes on two cores, and it will"
    warn "look as if nothing is happening — that is completely normal, please let it run. ⏳"
    # -j2 and not -j$(ncpu): the compile is fast either way and it is the LINK that
    # decides whether a small VPS survives this. Never 'gmake clean' first — these
    # files ship no object files, so a clean build is all there is anyway, and on a
    # re-run the untouched objects are what makes the second attempt quick.
    ( cd "$P_SP_SRC" && run gmake -j2 )

    # ---- 9. did it work? ----------------------------------------------------
    # The Makefile MOVES the finished binary itself — it prints "Moving ../game to
    # /usr/metin2/server/share/bin" — so there is nothing for us to copy anywhere,
    # and all fourteen cores pick it up because each of them is a symlink to it.
    if p_sp_built_ok; then
        ok "Instant in-game actions are enabled 🎉 — teleport and running speed now work,"
        ok "and items, yang and levels arrive the moment you click instead of after ~7 seconds"
        ok "The new game program is $P_SP_BIN, which every core links to"
        ok "The previous one is kept next to it as game.pre-patch"
        ok "web_admin.quest picks the new function up automatically — nothing else to change"
        return 0
    fi

    p_sp_restore
    warn "The rebuild did not finish, so everything was put back exactly as it was — the"
    warn "original program, the original Makefile and the original sources are all in place"
    warn "and nothing is broken."
    warn "The reason is at the end of $LOG."
    warn "The panel keeps working fully for items, yang and levels; only teleport and running"
    warn "speed stay unavailable. You can try again later by re-running the installer."
    return 0
}

# ---------------------------------------------------------------
#  Starting the server — what start.sh does, without the menu
# ---------------------------------------------------------------
p_running() { # p_running NAME -> 0 when a process with exactly that name is running
    command -v pgrep >/dev/null 2>&1 || return 1
    pgrep -x "$1" >/dev/null 2>&1
}

# p_locale_dir -> the share/locale/<language> folder actually in use, or empty.
# Languages.txt says this folder is renamed when the server language changes
# (english -> germany / turkey / …), so it is found by looking for the quest
# folder inside it rather than by name.
p_locale_dir() {
    p_q=$(find "${GAME_DIR:-/usr/metin2/server}/share/locale" -maxdepth 2 -type d -name quest 2>/dev/null | head -1)
    [ -n "$p_q" ] && dirname "$p_q"
}

# start.sh starts every core with a plain '&', which ties it to the shell that
# started it — the cores could then die together with the installer. daemon(8)
# (or nohup as a fallback) detaches them properly so they survive.
# Each core MUST be started from its OWN folder: CONFIG, data, share and log are
# all resolved relatively, and started from anywhere else it finds none of them.
p_launch() { # p_launch DIR PROGRAM LABEL
    p_dir="$1"; p_prog="$2"; p_name="${3:-$(basename "$1")}"
    if [ ! -d "$p_dir" ]; then
        warn "Skipping $p_name — there is no such folder in these server files"
        return 1
    fi
    if [ ! -f "$p_dir/$p_prog" ]; then
        warn "Skipping $p_name — no '$p_prog' program inside it"
        return 1
    fi
    chmod +x "$p_dir/$p_prog" 2>/dev/null

    # ---- why this is not just "daemon -f" -------------------------------
    # The game cores read console commands from standard input. daemon(8)'s -f
    # points stdin at /dev/null, so the core reads EOF the instant it finishes
    # starting and shuts itself down CLEANLY: no crash, no core dump, nothing in
    # syserr — just "started" and then a process that is gone.
    # That is exactly what it looked like, and it cost a long debugging session.
    # start.sh gets away with a plain '&' only because a human runs it with a
    # terminal attached, so stdin never reaches EOF.
    # The fix: a FIFO opened READ-WRITE (<>). The core holds both ends itself, so
    # the read blocks forever instead of hitting EOF, and — unlike piping from
    # `tail -f /dev/null` — it costs no extra helper process.
    p_fifo="/var/run/m2in.$p_name"
    [ -p "$p_fifo" ] || { rm -f "$p_fifo"; mkfifo "$p_fifo" 2>/dev/null; }
    p_pidf="/var/run/m2core.$p_name.pid"
    p_out="$p_dir/log/stdout"
    [ -d "$p_dir/log" ] || p_out=/dev/null

    if [ -p "$p_fifo" ] && command -v daemon >/dev/null 2>&1; then
        # The trailing >/dev/null matters too: without it daemon keeps hold of the
        # installer's own output and the install appears to hang.
        ( cd "$p_dir" && daemon -o "$p_out" -p "$p_pidf" "./$p_prog" <> "$p_fifo" ) >/dev/null 2>&1 \
            && { ok "Started: $p_name"; return 0; }
    fi
    # Fallback if mkfifo or daemon is unavailable: a pipe that never closes does
    # the same job, at the cost of one tiny helper process per core.
    ( cd "$p_dir" && tail -f /dev/null | nohup "./$p_prog" >>"$LOG" 2>&1 & ) \
        && { ok "Started: $p_name (fallback launcher)"; return 0; }
    warn "$p_name could not be started — see $LOG"
    return 1
}

# The order below is start.sh's own: db, auth, then per channel game2, game1 and
# first (yes, backwards — 'first' is started last on purpose, it is the core the
# players' client connects to and it wants its two siblings already up), then
# game99 at the end.
# ---------------------------------------------------------------
#  Stopping the server
# ---------------------------------------------------------------
# Needed by the rate changer: the numbers below live in mob_proto and the drop
# tables, which the cores read once at startup, so they only take effect after a
# full stop and start. Without this hook the panel could change the rates but
# would have to ask the user to restart by hand.
#
# These files ship their own close.sh, so we prefer it — it is what the author
# intended and it stops the cores in the order they expect. If it is missing or
# leaves something behind we fall back to pkill.
# The login server is launched from a program called 'auth' but renames its own
# process title to "game" once running, so in practice 'game' and 'db' cover
# everything. 'auth' is kept in the list anyway: it costs one no-op pkill, and it
# means we still clean up correctly if a future build stops renaming itself.
P_CORE_PROCS="game auth db"

p_any_core_running() {
    for p_p in $P_CORE_PROCS; do
        p_running "$p_p" && return 0
    done
    return 1
}

pack_stop_server() {
    p_gd="${GAME_DIR:-/usr/metin2/server}"
    if ! p_any_core_running; then
        ok "The server was not running — nothing to stop"
        return 0
    fi
    if [ -f "$p_gd/close.sh" ]; then
        ( cd "$p_gd" && run sh close.sh )
        sleep 3
    fi
    if ! command -v pkill >/dev/null 2>&1; then
        if p_any_core_running; then
            warn "This system has no 'pkill' and close.sh did not stop everything"
            return 1
        fi
        ok "The server was stopped"
        return 0
    fi
    # channels, game99 and auth first; the database core last — the game cores
    # save the players they are holding through it on the way out.
    p_running game && pkill -x game >/dev/null 2>&1
    p_running auth && pkill -x auth >/dev/null 2>&1
    sleep 2
    p_running db && pkill -x db >/dev/null 2>&1
    p_i=0
    while [ "$p_i" -lt 30 ]; do
        if ! p_any_core_running; then
            ok "The server was stopped"
            return 0
        fi
        sleep 1
        p_i=$((p_i + 1))
    done
    warn "The cores are taking their time — ending them the hard way"
    for p_p in $P_CORE_PROCS; do
        pkill -9 -x "$p_p" >/dev/null 2>&1
    done
    sleep 3
    if p_any_core_running; then
        warn "Some cores are still running and could not be stopped"
        return 1
    fi
    ok "The server was stopped"
    return 0
}

pack_start_server() {
    p_gd="${GAME_DIR:-/usr/metin2/server}"
    if [ ! -d "$p_gd" ]; then
        warn "The server folder ($p_gd) is not there — there is nothing to start"
        return 1
    fi
    # Only 'game' and 'db' are checked, and that is deliberate. The login server
    # is STARTED from a program called 'auth', but once running it renames its own
    # process title to "game" (confirmed on a live server: the process listening on
    # port 11000 reports as 'game'). So `pgrep -x auth` never matches anything, and
    # including it here would make this test always false — every re-run would then
    # start a second full set of cores on top of the ones already running.
    if p_running game && p_running db; then
        ok "The server is already running — leaving it exactly as it is"
        return 0
    fi
    p_ch=${CHANNELS:-2}
    case "$p_ch" in 1|2|3|4) : ;; *) p_ch=2 ;; esac

    # Worth saying out loud, because it is the single biggest difference to other
    # server files: a channel here is not one program but THREE (first, game1,
    # game2), each holding its own share of the map data. So 2 channels means
    # 6 game processes plus auth and db — roughly three times the memory a
    # one-core-per-channel layout uses. If the machine starts swapping, run
    # fewer channels rather than a smaller one.
    warn "Note: each channel in these files runs THREE cores (first, game1, game2),"
    warn "so $p_ch channel(s) means $((p_ch * 3)) game processes plus auth and db."

    p_n=0
    # 1) the database core first, and a few seconds for it to settle. Every other
    #    core connects to it on 127.0.0.1:15000 and gives up if it is not there.
    if p_running db; then
        ok "The database core is already running"
        p_n=$((p_n + 1))
    else
        p_launch "$p_gd/db" db "db" && p_n=$((p_n + 1))
    fi
    sleep 3

    # 2) the login server. Its program is called 'auth', NOT 'game' — it is the
    #    same binary as share/bin/game but installed under a different name (see
    #    auth/run.sh: "./auth &"). Passing "game" here silently skips the login
    #    server, and the whole install then hangs waiting for port 11000.
    #    It also means pgrep has to look for 'auth' as well as 'game'.
    p_launch "$p_gd/auth" auth "auth" && p_n=$((p_n + 1))
    sleep 1

    # 3) the channels, in start.sh's order
    p_i=1
    while [ "$p_i" -le "$p_ch" ]; do
        for p_core in game2 game1 first; do
            p_launch "$p_gd/channel$p_i/$p_core" game "channel$p_i-$p_core" && p_n=$((p_n + 1))
            sleep 1
        done
        p_i=$((p_i + 1))
    done

    # 4) game99 — a special-purpose core (events and a handful of maps). Players
    #    never pick it from the channel list, so it comes last and its port is
    #    deliberately not part of the "is the server up?" check.
    p_launch "$p_gd/game99" game "game99" && p_n=$((p_n + 1))

    if [ "$p_n" -eq 0 ]; then
        warn "Not one core could be started — see $LOG"
        return 1
    fi
    ok "$p_n core(s) started: db + auth + $p_ch channel(s) x 3 + game99"
    [ "$p_ch" -lt 4 ] && ok "Channels $((p_ch + 1))-4 were deliberately left off to save memory"
    return 0
}

# ---------------------------------------------------------------
#  Ports, schema names, start hint
# ---------------------------------------------------------------
# 22 = SSH, 11000 = auth (the address players type in), 13000:13099 = every
# channel core plus game99 — one range covers 13000-13032 and 13099 in one go.
# The P2P ports (12000 and 14000-14099) are how the cores talk to EACH OTHER on
# this one machine and are deliberately NOT opened: TMP4's own router guide
# (Router-ports-for-root.png, and the FAQ next to it) lists only "the auth,
# game99, and channels ports".
pack_ports() { echo "22 $P_AUTH_PORT 13000:13099"; }

# The server is only really up when the DATABASE core is up too. Port 15000 is
# the db core (BIND_PORT in db/conf.txt) and it MUST be in this list: without it
# the game cores still bind their ports and look perfectly healthy from outside
# while no player can log in. Leaving it out once meant the installer cheerfully
# reported success while the db core was crash-looping on a bad password — and
# this pack's own FAQ describes exactly that symptom ("socket_connect: HOST
# 127.0.0.1:15000, could not connect").
# The auth port stays FIRST because the engine shows the first port as the
# address players connect to. Only each channel's "first" core is listed: that
# is the port the client dials, game1/game2 take over behind the scenes, and
# game99 is not something a player ever picks.
pack_ready_ports() {
    p_out="$P_AUTH_PORT $P_DB_PORT"
    p_i=1
    while [ "$p_i" -le "${CHANNELS:-2}" ]; do
        p_out="$p_out $(p_ch_port "$p_i")"
        p_i=$((p_i + 1))
    done
    echo "$p_out"
}

# account / player / common / log — in that order. (There is a fifth schema,
# hotbackup, which the db core needs to exist but the panel never touches.)
pack_db_names() { echo "account player common log"; }

pack_start_hint() { echo "cd ${GAME_DIR:-/usr/metin2/server} && sh start.sh"; }
