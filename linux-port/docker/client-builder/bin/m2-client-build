#!/bin/sh
# =============================================================================
#  m2-client-build -- build the game client the panel gives to players.
#
#  The panel has a "Download the game" button and a /download route that serves
#  /usr/local/m2panel/client.zip.  On FreeBSD the installer produces that file
#  with pack_prepare_client().  In the Docker stack nothing did, so the button
#  was dead.  This is what fills it.
#
#  Four stages, each skipped when its output is already there:
#
#      1. acquire   the server-file archive -> /var/cache/m2client/archive/
#      2. build     unpack it, strip what players must not get, repack
#                     -> /var/cache/m2client/client.zip
#      3. patch     write serverinfo.py (this server's address) into that zip
#      4. publish   copy it to /out/client.zip, atomically
#
#  Stage 2 is the hour-long one and happens once.  Changing the address later
#  re-runs 3 and 4 only: one small file rewritten inside an existing zip, then a
#  copy.  Nothing is downloaded again.
#
#  The address itself is not written by this script.  p_write_serverinfo() in
#  the server-files profile does it -- the same function the FreeBSD installer
#  calls -- because getting that file right took a lot of reading:
#
#    * this client reads the serverinfo.py NEXT TO the .exe. A root/serverinfo.py
#      is never read, so writing one only misleads the next person.
#    * it is a _DISTRIBUTE build, so it searches pack/root.epk BEFORE loose
#      files. The profile moves that pack aside and puts the 90 unpacked
#      originals on disk, or the loose file we write would simply lose.
#    * only channels that are really running may be listed, or the client looks
#      broken to a player.
#    * every name the shipped file defines must still exist, or the client shows
#      an exception box instead of a login screen.
#
#  Nothing about that is duplicated here.  If the profile changes, this follows.
#
#  Subcommands
#      build   (default)  do whatever is still needed and publish
#      status             what is cached, how big, what address is in it
#      clean              throw the cache away (next build re-downloads)
# =============================================================================
set -u
LC_ALL=C
export LC_ALL

# ---------------------------------------------------------------------------
#  Where things live
# ---------------------------------------------------------------------------
# Fixed, not configurable. The cache is a mount point: to put it somewhere else,
# mount a different volume there. Making it a variable would break the one thing
# that has to line up -- pack_prepare_client() writes to /usr/local/m2panel and
# takes no argument, and /usr/local/m2panel is a symlink to this directory.
CACHE=/var/cache/m2client
ARCHIVE_DIR="$CACHE/archive"
WORK_DIR="$CACHE/work"
META="$CACHE/archive.meta"
BUILT="$CACHE/client.zip"          # == /usr/local/m2panel/client.zip
STAMP="$CACHE/client.meta"

OUT="${M2_CLIENT_OUT:-/out/client.zip}"
OUT_DIR=$(dirname "$OUT")
OUT_TMP="$OUT_DIR/.client.zip.new"

DROP_DIR="${M2_CLIENT_DROP:-/archive}"
PACK="${M2_CLIENT_PACK:-/opt/m2client/pack/pack.sh}"

LOG="$CACHE/build.log"

# ---------------------------------------------------------------------------
#  Settings
# ---------------------------------------------------------------------------
# The address baked into the client. M2_PUBLIC_ADDRESS is accepted as a fallback
# so that a plain `docker run' with the stack's own .env does the right thing.
ADDRESS="${M2_CLIENT_ADDRESS:-${M2_PUBLIC_ADDRESS:-}}"
CHANNELS_WANT="${M2_CLIENT_CHANNELS:-${M2_CHANNELS:-1}}"
AUTH_PORT_WANT="${M2_CLIENT_AUTH_PORT:-${M2_AUTH_PORT:-11000}}"
SERVER_NAME_WANT="${M2_CLIENT_SERVER_NAME:-}"

ARCHIVE_URL="${M2_CLIENT_ARCHIVE_URL:-}"
# The same archive somewhere else, tried in turn when the one above will not
# come. install.sh and install.ps1 fill these from artifacts.json.
ARCHIVE_URL_FALLBACK="${M2_CLIENT_ARCHIVE_URL_FALLBACK:-}"
ARCHIVE_URL_FALLBACK2="${M2_CLIENT_ARCHIVE_URL_FALLBACK2:-}"
ARCHIVE_GIVEN="${M2_CLIENT_ARCHIVE:-}"
ARCHIVE_SHA="${M2_CLIENT_ARCHIVE_SHA256:-}"

FORCE="${M2_CLIENT_FORCE:-}"           # rebuild | redownload | (empty)
KEEP_ARCHIVE="${M2_CLIENT_KEEP_ARCHIVE:-1}"
VERIFY="${M2_CLIENT_VERIFY:-quick}"    # quick | full
MIN_FREE_MB="${M2_CLIENT_MIN_FREE_MB:-7000}"
PANEL_UID="${M2_CLIENT_OWNER_UID:-2001}"
PANEL_GID="${M2_CLIENT_OWNER_GID:-2001}"

# ---------------------------------------------------------------------------
#  Talking to the operator
# ---------------------------------------------------------------------------
# Everything goes to stdout, which is what `docker compose run' shows, and to a
# log on the cache volume, which is what survives to be read afterwards.
say()  { printf '%s [client] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$*"; }
note() { say "$*"; say "$*" >>"$LOG" 2>/dev/null; }
step() { note ""; note "== $*"; }
ok()   { note "  [ ok ] $*"; }
warn() { note "  [ !! ] $*"; }
fail() { note "  [ XX ] $*"; }
run()  { "$@" >>"$LOG" 2>&1; }
ask()  { ANSWER="${2:-}"; }        # nothing here can ask a question

# The profile calls its own hooks through this, so that a set of server files
# that does not implement one is skipped rather than fatal. Same contract as
# install.sh's version: run the hook if it exists, pass its exit status on.
pack_call() {
    _hook="$1"; shift
    command -v "$_hook" >/dev/null 2>&1 || {
        warn "These server files have no '$_hook' step -- skipped"
        return 0
    }
    "$_hook" "$@"
}

die() {
    fail "$1"
    shift
    for _l in "$@"; do note "         $_l"; done
    exit 1
}

human() { # human BYTES
    awk -v b="${1:-0}" 'BEGIN{
        split("B KB MB GB TB", u, " "); i=1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        printf (i==1 ? "%d %s\n" : "%.1f %s\n"), b, u[i]
    }'
}

fsize() { # fsize FILE -> bytes, 0 when absent
    [ -f "$1" ] || { echo 0; return; }
    wc -c < "$1" 2>/dev/null | tr -d ' ' || echo 0
}

free_mb() { # free_mb DIR -> free megabytes on that filesystem
    df -Pm "$1" 2>/dev/null | awk 'END{print $4+0}'
}

# ---------------------------------------------------------------------------
#  Heartbeat
# ---------------------------------------------------------------------------
# Unpacking and repacking a 1.3 GB client takes minutes with nothing at all to
# show for it. A run that prints nothing for ten minutes is indistinguishable
# from a run that has hung, and an operator who cannot tell the difference kills
# it -- so a line goes out every 30 seconds saying how far along the file being
# written is.
HEARTBEAT_PID=""
heartbeat_start() { # heartbeat_start LABEL FILE_OR_GLOB [TOTAL_BYTES]
    _hb_label="$1"; _hb_target="$2"; _hb_total="${3:-0}"
    [ -n "${HEARTBEAT_PID:-}" ] && heartbeat_stop
    (
        _t0=$(date +%s)
        while :; do
            sleep 30
            _now=$(date +%s)
            _el=$(( _now - _t0 ))
            # shellcheck disable=SC2086
            _f=$(ls -1 $_hb_target 2>/dev/null | head -1)
            _b=0
            [ -n "$_f" ] && _b=$(wc -c < "$_f" 2>/dev/null | tr -d ' ')
            [ -n "$_b" ] || _b=0
            if [ "$_hb_total" -gt 0 ] 2>/dev/null && [ "$_b" -gt 0 ]; then
                printf '%s [client]        %s: %s of %s (%d%%), %dm%02ds elapsed\n' \
                    "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$_hb_label" \
                    "$(human "$_b")" "$(human "$_hb_total")" \
                    "$(( _b * 100 / _hb_total ))" "$(( _el / 60 ))" "$(( _el % 60 ))"
            elif [ "$_b" -gt 0 ]; then
                printf '%s [client]        %s: %s so far, %dm%02ds elapsed\n' \
                    "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$_hb_label" \
                    "$(human "$_b")" "$(( _el / 60 ))" "$(( _el % 60 ))"
            else
                printf '%s [client]        %s: %dm%02ds elapsed\n' \
                    "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$_hb_label" \
                    "$(( _el / 60 ))" "$(( _el % 60 ))"
            fi
        done
    ) &
    HEARTBEAT_PID=$!
}
heartbeat_stop() {
    [ -n "${HEARTBEAT_PID:-}" ] || return 0
    kill "$HEARTBEAT_PID" 2>/dev/null
    wait "$HEARTBEAT_PID" 2>/dev/null
    HEARTBEAT_PID=""
}

# ---------------------------------------------------------------------------
#  Cleanup
# ---------------------------------------------------------------------------
# The half-written copy in the panel's volume is the one thing that must never
# survive this script: the panel serves whatever is called client.zip, so a
# truncated file is a broken download for every player. It is written under a
# dotted name and only renamed at the very end, and removed here whichever way
# we leave -- success, failure, or Ctrl-C.
#
# The download in progress is deliberately NOT removed. megatools keeps it in
# .megatmp.<id> and resumes from it, which is the whole point of interrupting
# being cheap.
cleanup() {
    _rc=$?
    heartbeat_stop
    rm -f "$OUT_TMP" 2>/dev/null
    rm -rf "$WORK_DIR/patch" 2>/dev/null
    exit "$_rc"
}

# Ctrl-C has to work, and getting that right needs one deliberate arrangement.
# A shell does not run a trap while a foreground command is still going: send
# SIGINT to this script while megatools has the terminal and nothing happens
# until megatools finishes -- which, for a 1.4 GB download, is not an answer.
# So every long-running step is started in the background and waited for, which
# is interruptible, and the handler kills it.
CHILD_PID=""
supervised() { # supervised CMD [ARG...] -- run it so that a signal can reach us
    "$@" &
    CHILD_PID=$!
    wait "$CHILD_PID"
    _sv_rc=$?
    CHILD_PID=""
    return "$_sv_rc"
}

on_signal() {
    [ -n "${CHILD_PID:-}" ] && kill -TERM "$CHILD_PID" 2>/dev/null
    heartbeat_stop
    note ""
    warn "Interrupted. Nothing was published, so the panel is unchanged."
    warn "A download in progress is kept and the next run continues it."
    exit 130
}

trap cleanup EXIT
trap on_signal INT TERM

# ---------------------------------------------------------------------------
#  The server-files profile
# ---------------------------------------------------------------------------
load_pack() {
    [ -f "$PACK" ] || die \
        "The server-files profile is not in this image ($PACK)." \
        "It is staged into the build context by prepare-context.sh:" \
        "    ./prepare-context.sh --panel ../../files" \
        "    docker compose build client-builder"
    # A profile is a library: assignments and function definitions, no side
    # effects. That contract is what makes sourcing it safe. See PACKS.md.
    # shellcheck disable=SC1090
    . "$PACK"
    command -v pack_prepare_client >/dev/null 2>&1 || die \
        "These server files have no pack_prepare_client() -- there is no client to build."
    command -v p_write_serverinfo >/dev/null 2>&1 || die \
        "These server files have no p_write_serverinfo() -- the address cannot be written."

    # The profile's own defaults, overridden only where this stack differs.
    [ -n "$SERVER_NAME_WANT" ] && PACK_SERVER_NAME="$SERVER_NAME_WANT"
    P_AUTH_PORT="$AUTH_PORT_WANT"

    # What pack_apply_ip reads.
    PUB_IP="$ADDRESS"
    CHANNELS="$CHANNELS_WANT"
    export PUB_IP CHANNELS
}

# ---------------------------------------------------------------------------
#  Sanity
# ---------------------------------------------------------------------------
check_settings() {
    case "$CHANNELS_WANT" in
        1|2|3|4) : ;;
        *) warn "M2_CLIENT_CHANNELS='$CHANNELS_WANT' is not 1-4 -- using 1"
           CHANNELS_WANT=1 ;;
    esac
    case "$AUTH_PORT_WANT" in
        ''|*[!0-9]*) warn "M2_CLIENT_AUTH_PORT='$AUTH_PORT_WANT' is not a number -- using 11000"
                     AUTH_PORT_WANT=11000 ;;
    esac
    [ -n "$ADDRESS" ] || die \
        "M2_CLIENT_ADDRESS is empty, so there is no address to write into the client." \
        "Set it to the address players will type:" \
        "  a server on the internet : your public IP or a hostname pointing at it" \
        "  a server on this machine : 127.0.0.1" \
        "It is normally taken from M2_PUBLIC_ADDRESS in .env."
    case "$ADDRESS" in
        0.0.0.0|localhost|*' '*)
            die "M2_CLIENT_ADDRESS='$ADDRESS' cannot work in a client." \
                "0.0.0.0 is a bind address, not a destination, and the client's" \
                "Python does no name lookup on 'localhost' in every build." \
                "Use a real IP address or a hostname; 127.0.0.1 for a local install." ;;
    esac

    # The symlink the profile depends on. If someone mounts a volume over
    # /usr/local/m2panel this stops being the cache, and pack_prepare_client
    # would write the client straight into it -- worth catching loudly.
    _resolved=$(cd /usr/local/m2panel 2>/dev/null && pwd -P)
    [ "$_resolved" = "$CACHE" ] || die \
        "/usr/local/m2panel does not resolve to $CACHE (it is '$_resolved')." \
        "Do not mount anything over /usr/local/m2panel in this container:" \
        "it is where the profile writes the client, and it must be the cache" \
        "volume, not the panel's."
}

check_tools() {
    _missing=""
    for _t in zip unzip 7z megatools curl awk; do
        command -v "$_t" >/dev/null 2>&1 || _missing="$_missing $_t"
    done
    [ -z "$_missing" ] || die "This image is missing:$_missing"
}

check_space() { # check_space NEED_MB WHERE WHAT
    _need="$1"; _where="$2"; _what="$3"
    _free=$(free_mb "$_where")
    [ -n "$_free" ] || return 0
    [ "$_free" -ge "$_need" ] && return 0
    die "Not enough disk space for $_what." \
        "Needed: about ${_need} MB free on $_where" \
        "Free:   ${_free} MB" \
        "Free some space and run this again. Nothing has been changed." \
        "(Lower the requirement with M2_CLIENT_MIN_FREE_MB if you know better;" \
        " 'm2-client-build status' shows what is already cached.)"
}

# ---------------------------------------------------------------------------
#  STAGE 1 -- the archive
# ---------------------------------------------------------------------------
# One MEGA link holds Client/ and Server/ in a single archive of well over a
# gigabyte. Everything here exists so that it is fetched at most once, ever.

archive_kind() { # archive_kind FILE -> zip | rar | 7z | unknown, from the magic bytes
    _sig=$(od -An -c -N6 "$1" 2>/dev/null | tr -d ' \n')
    case "$_sig" in
        PK*)   echo zip ;;
        Rar!*) echo rar ;;
        7z*)   echo 7z ;;
        *)     echo unknown ;;
    esac
}

archive_lists_ok() { # archive_lists_ok FILE -> 0 when the archive can be read to its end
    # This is the cheap truth test. A download that stopped half way, or a file
    # that was copied off a full disk, fails to list: the directory of a zip is
    # at the end, and a rar or 7z stream runs out mid-entry. It costs one pass
    # over the file and catches every truncation, which is the failure that
    # actually happens.
    7z l -ba -- "$1" >/dev/null 2>>"$LOG"
}

archive_verify() { # archive_verify FILE -> 0 when it may be used
    _f="$1"
    [ -f "$_f" ] || return 1
    _have=$(fsize "$_f")
    [ "$_have" -gt 1048576 ] || { warn "$(basename "$_f") is only $(human "$_have") -- too small to be the server files"; return 1; }

    # archive.meta describes the file WE downloaded, and only that file. An
    # archive the operator supplied is a different file that is supposed to be
    # different, so comparing it against those numbers would reject a perfectly
    # good one -- which is exactly the situation this tool exists to rescue.
    _from_cache=0
    case "$_f" in "$ARCHIVE_DIR"/*) _from_cache=1 ;; esac

    if [ -n "$ARCHIVE_SHA" ]; then
        note "  checking the archive against the checksum you gave..."
        _sum=$(sha256sum "$_f" 2>/dev/null | awk '{print $1}')
        if [ "$_sum" != "$ARCHIVE_SHA" ]; then
            warn "checksum mismatch: expected $ARCHIVE_SHA"
            warn "                   got      $_sum"
            return 1
        fi
        ok "checksum matches"
    elif [ "$_from_cache" = 1 ] && [ "$VERIFY" = "full" ] && [ -f "$META" ]; then
        _want=$(awk -F= '$1=="sha256"{print $2}' "$META" 2>/dev/null)
        if [ -n "$_want" ]; then
            note "  re-checking the cached archive (M2_CLIENT_VERIFY=full)..."
            _sum=$(sha256sum "$_f" 2>/dev/null | awk '{print $1}')
            [ "$_sum" = "$_want" ] || { warn "the cached archive no longer matches its recorded checksum"; return 1; }
            ok "checksum matches what was recorded when it was downloaded"
        fi
    fi

    if [ "$_from_cache" = 1 ] && [ -f "$META" ]; then
        _wantb=$(awk -F= '$1=="bytes"{print $2}' "$META" 2>/dev/null)
        case "${_wantb:-x}" in
            ''|*[!0-9]*) : ;;
            *) [ "$_have" = "$_wantb" ] || {
                   warn "the cached archive is $(human "$_have") but was $(human "$_wantb") when it was downloaded"
                   return 1
               } ;;
        esac
    fi

    archive_lists_ok "$_f" || { warn "$(basename "$_f") cannot be read to the end -- it is incomplete or damaged"; return 1; }
    return 0
}

archive_record() { # archive_record FILE URL
    {
        printf 'name=%s\n'   "$(basename "$1")"
        printf 'bytes=%s\n'  "$(fsize "$1")"
        printf 'url=%s\n'    "${2:-}"
        printf 'sha256=%s\n' "$(sha256sum "$1" 2>/dev/null | awk '{print $1}')"
        printf 'when=%s\n'   "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    } > "$META"
}

cached_archive() { # cached_archive [DIR] -> the finished archive there, if any
    # A download in progress is NOT one of these: megatools keeps it in
    # .megatmp.<id> and renames it only when it is complete, so filtering those
    # names out is what stops a half-downloaded file being taken for the server
    # files.
    _ca_dir="${1:-$ARCHIVE_DIR}"
    [ -d "$_ca_dir" ] || return 0
    find "$_ca_dir" -maxdepth 1 -type f ! -name '.megatmp.*' ! -name '*.part' \
         ! -name '*.tmp' 2>/dev/null | grep -iv 'vs22' | sort | head -1
}

dropped_archive() { # -> path of an archive the operator put in /archive
    [ -d "$DROP_DIR" ] || return 0
    # ClientVS22.zip is filtered out by name here as well as everywhere else it
    # could get in. It is the client's C++ source, it sits right next to
    # Client.zip in the server files, and somebody copying "the client zip" over
    # will sooner or later copy that one. It is not an archive we can build
    # anything from, and it must never reach a player.
    find "$DROP_DIR" -maxdepth 1 -type f \
         \( -iname '*.rar' -o -iname '*.zip' -o -iname '*.7z' \) 2>/dev/null \
         | grep -iv 'vs22' | sort | head -1
}

url_is_mega() { # from install.sh, unchanged
    case "$1" in
        *mega.nz*|*mega.co.nz*) return 0 ;;
        *) return 1 ;;
    esac
}

# MEGA links come in two flavours:
#   modern : https://mega.nz/file/<id>#<key>      (megatools 1.11+)
#   legacy : https://mega.nz/#!<id>!<key>         (all that 1.9/1.10 knows)
# Ubuntu ships 1.11, so the modern form is tried first and this is the retry.
# Copied from install.sh rather than shared, because that file runs a live
# FreeBSD server and is not ours to touch.
mega_legacy_url() {
    printf '%s' "$1" | sed -e 's,/file/,/#!,' -e 's,/folder/,/#F!,' \
                           -e 's,#!\([^#]*\)#,#!\1!,' -e 's,#F!\([^#]*\)#,#F!\1!,'
}

# megatools exits 0 on a link it will not even try -- a malformed or revoked
# share prints "WARNING: Skipping invalid Mega download link" and returns
# success. Trusting its exit status would turn a dead link into "the download
# reported success but there is no file", which tells the operator nothing. So
# an attempt counts only if a file actually landed.
mega_attempt() { # mega_attempt URL DEST_DIR -> 0 only when a real file appeared
    _ma_u="$1"; _ma_d="$2"
    if [ -t 1 ]; then
        supervised megatools dl --path "$_ma_d" "$_ma_u"
    else
        heartbeat_start "downloading" "$_ma_d/.megatmp.*"
        supervised megatools dl --no-progress --path "$_ma_d" "$_ma_u"
        _ma_rc=$?
        heartbeat_stop
        [ "$_ma_rc" = 0 ] || return 1
    fi
    [ -n "$(cached_archive "$_ma_d")" ]
}

download_mega() { # download_mega URL DEST_DIR -> 0 and the file is in DEST_DIR
    _u="$1"; _d="$2"
    mkdir -p "$_d" || return 1

    # megatools writes the partial download to .megatmp.<id> and only renames it
    # to the real name when it is complete, and it resumes from that file by
    # default. So the directory is never wiped between attempts -- that is what
    # makes an interrupted 1.4 GB download cost nothing to retry. (install.sh
    # downloads into a fresh temp dir each time; it has no resume requirement.)
    _existing=$(find "$_d" -maxdepth 1 -name '.megatmp.*' -type f 2>/dev/null | head -1)
    if [ -n "$_existing" ]; then
        note "  resuming an interrupted download ($(human "$(fsize "$_existing")") already here)"
    fi

    # On a terminal megatools draws its own progress bar; without one it would
    # only spam the log, so we print our own line every 30 seconds instead.
    mega_attempt "$_u" "$_d" && return 0

    _legacy=$(mega_legacy_url "$_u")
    if [ "$_legacy" != "$_u" ]; then
        warn "MEGA would not give us that link -- retrying with the older link format"
        mega_attempt "$_legacy" "$_d" && return 0
    fi
    return 1
}

download_direct() { # download_direct URL DEST_DIR
    _u="$1"; _d="$2"
    mkdir -p "$_d" || return 1
    _name=$(basename "$_u" | sed -e 's/[?#].*$//')
    case "$_name" in
        *.rar|*.zip|*.7z) ;;
        *) _name="m2files.download" ;;
    esac
    # -C - resumes a partial file; --retry rides out a dropped connection.
    if [ -t 1 ]; then
        supervised curl -fL --progress-bar --retry 5 --retry-delay 5 -C - -o "$_d/$_name" "$_u" || return 1
    else
        heartbeat_start "downloading" "$_d/$_name"
        supervised curl -fsSL --retry 5 --retry-delay 5 -C - -o "$_d/$_name" "$_u"
        _rc=$?
        heartbeat_stop
        [ "$_rc" = 0 ] || return 1
    fi
    # A download whose URL carried no useful extension: name it after what it is.
    case "$_name" in
        *.rar|*.zip|*.7z) ;;
        *) _k=$(archive_kind "$_d/$_name")
           [ "$_k" = unknown ] && _k=rar
           mv -f "$_d/$_name" "$_d/m2files.$_k" || return 1 ;;
    esac
    return 0
}

dead_link_advice() {
    note ""
    note "  This project supplies no native client archive or default mirror."
    note "  Provide a compatible client that you are authorised to use:"
    note ""
    note "    1. An explicit direct or MEGA link:"
    note "         M2_CLIENT_ARCHIVE_URL=https://... docker compose run --rm client-builder"
    note ""
    note "    2. The file itself. Download it on your own PC, copy it next to"
    note "       docker-compose.yml in the ./client-archive folder, and run this"
    note "       again -- it is picked up from there and nothing is fetched:"
    note "         docker compose run --rm client-builder"
    note ""
    note "  A file that is already a finished client.zip works too: put it"
    note "  straight into the panel instead and you do not need this tool at all:"
    note "    docker compose cp ./client.zip panel:/usr/local/m2panel/client.zip"
    note ""
    note "  Meanwhile the server itself is completely fine. Only the download"
    note "  button on the panel is not."
}

acquire_archive() { # -> ARCHIVE
    ARCHIVE=""

    # 1. An explicit path always wins: the operator said exactly what to use.
    if [ -n "$ARCHIVE_GIVEN" ]; then
        [ -f "$ARCHIVE_GIVEN" ] || die "M2_CLIENT_ARCHIVE=$ARCHIVE_GIVEN is not a file in this container." \
            "Mount it in, for example:" \
            "  docker compose run --rm -v /path/to/files.rar:/archive/files.rar client-builder"
        note "  using the archive you named: $ARCHIVE_GIVEN"
        archive_verify "$ARCHIVE_GIVEN" || die "That archive did not pass its integrity check (see above)."
        ARCHIVE="$ARCHIVE_GIVEN"; return 0
    fi

    # 2. Something dropped into ./client-archive on the host. Used where it lies:
    #    copying 1.4 GB into the cache to read it once would be a waste.
    _drop=$(dropped_archive)
    if [ -n "$_drop" ]; then
        note "  found an archive you provided: $_drop"
        if archive_verify "$_drop"; then
            ARCHIVE="$_drop"; return 0
        fi
        warn "that file did not pass its integrity check -- falling back to the download"
    fi

    # 3. Already downloaded once.
    _cached=$(cached_archive)
    if [ -n "$_cached" ] && [ "$FORCE" != "redownload" ]; then
        note "  an archive is already in the cache: $(basename "$_cached") ($(human "$(fsize "$_cached")"))"
        if archive_verify "$_cached"; then
            ok "cached archive is intact -- nothing to download"
            ARCHIVE="$_cached"; return 0
        fi
        warn "the cached copy is not usable; it will be fetched again"
        rm -f "$_cached"
    elif [ -n "$_cached" ]; then
        note "  M2_CLIENT_FORCE=redownload -- discarding the cached archive"
        rm -f "$_cached" "$META"
    fi

    # 4. Fetch it. One archive, several places it might be: each fallback is
    # the same file elsewhere, which is what turns MEGA's "509 over quota" --
    # somebody else's daily allowance, spent -- from a wait of hours into a
    # wait of seconds. Anything that is not a link is skipped here, so an
    # unfilled setting simply is not an entry in the list.
    _dlurls=""
    for _dlc in "$ARCHIVE_URL" "$ARCHIVE_URL_FALLBACK" "$ARCHIVE_URL_FALLBACK2" "${PACK_URL:-}"; do
        case "$_dlc" in https://*|http://*) _dlurls="${_dlurls:+$_dlurls }$_dlc" ;; esac
    done
    [ -n "$_dlurls" ] || { dead_link_advice; die "There is no download link to try (M2_CLIENT_ARCHIVE_URL is empty and these server files define no PACK_URL)."; }

    check_space "$MIN_FREE_MB" "$CACHE" "downloading and unpacking the client"

    note "  fetching the server files. This is well over a gigabyte and takes"
    note "  a while -- please let it run. Interrupting is safe: it resumes."

    _dln=0; _dlok=0; _url=""
    for _dlu in $_dlurls; do
        _dln=$((_dln + 1))
        if [ "$_dln" -gt 1 ]; then
            note ""
            note "  trying another copy of the same archive"
            # .megatmp.* is resume state for one particular link. Kept, it
            # would be mistaken for progress against the next one.
            find "$ARCHIVE_DIR" -maxdepth 1 -name '.megatmp.*' -exec rm -f {} + 2>/dev/null || true
        fi
        note "  from: $_dlu"
        if url_is_mega "$_dlu"; then
            download_mega "$_dlu" "$ARCHIVE_DIR" && { _url="$_dlu"; _dlok=1; break; }
        else
            download_direct "$_dlu" "$ARCHIVE_DIR" && { _url="$_dlu"; _dlok=1; break; }
        fi
    done
    [ "$_dlok" = 1 ] || { dead_link_advice; die "Could not download the server files."; }

    _got=$(cached_archive)
    [ -n "$_got" ] || { dead_link_advice; die "The download finished but there is no archive in $ARCHIVE_DIR."; }

    # megatools keeps the remote name, which may have no extension at all.
    # 7z sniffs the format itself, but a name that says what the file is makes
    # every later message readable.
    case "$_got" in
        *.rar|*.zip|*.7z) ;;
        *) _k=$(archive_kind "$_got")
           if [ "$_k" != unknown ]; then
               mv -f "$_got" "$_got.$_k" && _got="$_got.$_k"
           fi ;;
    esac

    ok "downloaded: $(basename "$_got") ($(human "$(fsize "$_got")"))"
    archive_record "$_got" "$_url"
    archive_verify "$_got" || die "The downloaded archive did not pass its integrity check." \
        "Run this again -- the download resumes rather than starting over."
    ARCHIVE="$_got"
    return 0
}

# ---------------------------------------------------------------------------
#  STAGE 2 -- the client
# ---------------------------------------------------------------------------
# The archive holds the whole server-file folder. The client inside it is a zip
# of its own, Client/Client.zip. Its sibling ClientVS22.zip is the client's C++
# SOURCE and must never reach a player -- it is what someone would use to build
# a cheat client against this exact server -- so it is matched by exact name and
# never by a wildcard.

INNER_CLIENT=""
find_inner_client() { # find_inner_client ARCHIVE -> sets INNER_CLIENT
    _a="$1"
    INNER_CLIENT=""

    # Is the archive already the client itself? Somebody who was given a
    # Client.zip directly should not have to repackage it.
    if unzip -Z1 "$_a" 2>/dev/null | grep -qiE '(^|/)metin2[^/]*\.exe$'; then
        note "  this archive is the client itself"
        INNER_CLIENT="$_a"
        return 0
    fi

    note "  looking for the client inside the archive..."
    _list=$(7z l -ba -slt -- "$_a" 2>>"$LOG" | sed -n 's/^Path = //p' | tr '\\' '/')
    _n=$(printf '%s\n' "$_list" | grep -icE '(^|/)client\.zip$')
    if [ "${_n:-0}" -lt 1 ]; then
        warn "there is no Client.zip in this archive. What it does contain:"
        printf '%s\n' "$_list" | head -20 | while IFS= read -r _e; do note "         $_e"; done
        return 1
    fi
    [ "$_n" -gt 1 ] && warn "the archive holds $_n files called Client.zip -- taking the first"

    mkdir -p "$WORK_DIR" || return 1
    rm -f "$WORK_DIR/Client.zip"
    check_space 3000 "$CACHE" "extracting the client out of the archive"
    note "  extracting it (a gigabyte of copying, a couple of minutes)"
    heartbeat_start "extracting Client.zip" "$WORK_DIR/Client.zip"
    # -r with a bare name matches the file at any depth; ClientVS22.zip has a
    # different name and is not matched. -o puts it flat in the work directory.
    supervised 7z e -y -bso0 -bsp0 -o"$WORK_DIR" -r -- "$_a" "Client.zip" >>"$LOG" 2>&1
    _rc=$?
    heartbeat_stop
    [ "$_rc" = 0 ] || { warn "7z could not extract Client.zip -- see $LOG"; return 1; }
    [ -f "$WORK_DIR/Client.zip" ] || { warn "Client.zip did not appear in $WORK_DIR"; return 1; }
    unzip -Z1 "$WORK_DIR/Client.zip" >/dev/null 2>&1 || { warn "the extracted Client.zip cannot be read"; return 1; }
    ok "client archive extracted ($(human "$(fsize "$WORK_DIR/Client.zip")"))"
    INNER_CLIENT="$WORK_DIR/Client.zip"
    return 0
}

build_client() {
    step "Building the client"

    find_inner_client "$ARCHIVE" || die \
        "Could not get the client out of the archive." \
        "If you already have a finished client.zip, the panel takes it directly:" \
        "  docker compose cp ./client.zip panel:/usr/local/m2panel/client.zip"
    _inner="$INNER_CLIENT"

    # pack_prepare_client() needs about two and a half times the client zip on
    # top of what is already there: the unpacked tree and the new zip exist at
    # the same time. It checks this itself and bows out politely, which for us
    # would be a silent no-op -- so it is checked here too, loudly.
    _need_mb=$(( $(fsize "$_inner") / 1048576 * 5 / 2 + 500 ))
    check_space "$_need_mb" "$CACHE" "unpacking and repacking the client"

    # Hand it to the profile. From here everything -- the unpack, moving
    # pack/root.epk aside, putting the 90 unpacked scripts on disk, writing
    # serverinfo.py, dropping the Eternexus tool folder, the start-here readme,
    # the repack -- is the FreeBSD installer's own code, running unmodified.
    P_CLIENT_ZIP="$_inner"
    export P_CLIENT_ZIP
    # How long this takes is almost entirely the disk. On an NVMe machine it is
    # under a minute; on a small VPS with slow storage it can be half an hour.
    # Saying "a few minutes" to someone on the second kind is how you get a
    # build killed half way, so say both.
    note "  unpacking, patching and repacking. A couple of minutes on a fast"
    note "  disk, up to half an hour on a slow VPS. It happens once."
    heartbeat_start "repacking" "$BUILT"
    supervised pack_prepare_client
    heartbeat_stop

    [ -f "$BUILT" ] || die \
        "The client could not be built. The log is on the cache volume:" \
        "  docker compose run --rm --entrypoint cat client-builder $LOG"

    ok "client built: $(human "$(fsize "$BUILT")")"

    # The inner copy has done its job; it is a gigabyte of nothing now.
    rm -f "$WORK_DIR/Client.zip"

    if [ "$KEEP_ARCHIVE" = "0" ]; then
        _c=$(cached_archive)
        if [ -n "$_c" ]; then
            rm -f "$_c"
            ok "cached archive removed (M2_CLIENT_KEEP_ARCHIVE=0), $(human "$(fsize "$BUILT")") of cache left"
            warn "a future rebuild -- not a re-address, that is free -- will download it again"
        fi
    fi
}

# ---------------------------------------------------------------------------
#  STAGE 3 -- this server's address
# ---------------------------------------------------------------------------
# The one member of the zip that depends on where the server is. Replacing it
# inside the existing archive is what makes changing the address a ten-second
# job instead of an hour: zip rewrites the one entry and leaves the other 4000
# alone.
patch_address() {
    step "Writing the server address into the client"

    rm -rf "$WORK_DIR/patch"
    mkdir -p "$WORK_DIR/patch" || die "Could not create $WORK_DIR/patch"

    # p_write_serverinfo reads $PUB_IP, $P_AUTH_PORT, $PACK_SERVER_NAME and
    # p_ch_port(); load_pack() has set all of them.
    p_write_serverinfo "$WORK_DIR/patch/serverinfo.py" "$CHANNELS_WANT" \
        || die "serverinfo.py could not be written -- see $LOG"
    [ -s "$WORK_DIR/patch/serverinfo.py" ] || die "serverinfo.py came out empty -- see $LOG"

    # The entry has to land at the top level of the zip, next to the .exe: it is
    # the only copy this client reads. `zip ARCHIVE serverinfo.py' from a
    # directory that contains just that file stores exactly that name and
    # replaces the entry already there.
    ( cd "$WORK_DIR/patch" && zip -q "$BUILT" serverinfo.py ) \
        || die "Could not write serverinfo.py into $BUILT"

    {
        printf 'address=%s\n'  "$ADDRESS"
        printf 'channels=%s\n' "$CHANNELS_WANT"
        printf 'auth_port=%s\n' "$AUTH_PORT_WANT"
        printf 'name=%s\n'     "${PACK_SERVER_NAME:-}"
        printf 'when=%s\n'     "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    } > "$STAMP"

    rm -rf "$WORK_DIR/patch"
    ok "address written: $ADDRESS, login port $AUTH_PORT_WANT, $CHANNELS_WANT channel(s)"
}

# ---------------------------------------------------------------------------
#  The language the client starts in
# ---------------------------------------------------------------------------
#  The client picks its menus, its item names and its fonts from
#  pack/locale_XY.epk, and which one it takes is decided by locale.cfg sitting
#  next to the .exe -- fifteen bytes reading "10000 1252 en".  Every language's
#  pack and every language's cfg are already inside this zip, so making the
#  download match the server is a matter of putting the right one in place.
#
#  Which language that is comes from the server itself, not from a setting
#  here: m2-lang writes lang.status into the spool whenever the operator
#  switches, and that is the only value that cannot go stale.  M2_CLIENT_LANG
#  overrides it for somebody building a client for a different server.
#
#  There is no locale_en.cfg in the pack -- the plain locale.cfg IS English,
#  exactly as item_names.txt is on the server side.  So the first time this
#  replaces it, the original is added to the zip AS locale_en.cfg.  That makes
#  switching back possible, and it gives players the file the panel's
#  instructions tell them to rename.
# ---------------------------------------------------------------------------
LANG_STATUS="${M2_LANG_STATUS:-/opt/m2spool/lang.status}"

patch_language() {
    _want="${M2_CLIENT_LANG:-}"
    if [ -z "$_want" ] && [ -f "$LANG_STATUS" ]; then
        _want=$(sed -n 's/^lang=//p' "$LANG_STATUS" 2>/dev/null | head -1 | tr -d ' \r\n')
    fi
    [ -n "$_want" ] || _want=en

    case "$_want" in
        [a-z][a-z]) : ;;
        *) warn "'$_want' is not a language code -- the client keeps the language it has"
           return 0 ;;
    esac

    step "Setting the client's language to '$_want'"

    rm -rf "$WORK_DIR/lang"
    mkdir -p "$WORK_DIR/lang" || die "Could not create $WORK_DIR/lang"

    # Keep the shipped English one under a name of its own, once.
    if ! unzip -l "$BUILT" locale_en.cfg >/dev/null 2>&1; then
        if unzip -p "$BUILT" locale.cfg > "$WORK_DIR/lang/locale_en.cfg" 2>/dev/null \
           && [ -s "$WORK_DIR/lang/locale_en.cfg" ]; then
            ( cd "$WORK_DIR/lang" && zip -q "$BUILT" locale_en.cfg ) \
                || warn "could not keep a copy of the English locale.cfg"
            rm -f "$WORK_DIR/lang/locale_en.cfg"
        else
            warn "this client has no locale.cfg -- the language is left alone"
            rm -rf "$WORK_DIR/lang"
            return 0
        fi
    fi

    if ! unzip -p "$BUILT" "locale_${_want}.cfg" > "$WORK_DIR/lang/locale.cfg" 2>/dev/null \
       || [ ! -s "$WORK_DIR/lang/locale.cfg" ]; then
        warn "this client carries no locale_${_want}.cfg -- its language is left as it is"
        rm -rf "$WORK_DIR/lang"
        return 0
    fi

    ( cd "$WORK_DIR/lang" && zip -q "$BUILT" locale.cfg ) \
        || die "Could not write locale.cfg into $BUILT"
    rm -rf "$WORK_DIR/lang"

    ok "the client will start in '$_want'"
}

# ---------------------------------------------------------------------------
#  STAGE 4 -- hand it to the panel
# ---------------------------------------------------------------------------
verify_built() {
    step "Checking the finished client"

    unzip -l "$BUILT" >/dev/null 2>>"$LOG" || return 1
    _entries=$(unzip -Z1 "$BUILT" 2>/dev/null)

    # Exactly one serverinfo.py, at the top level. Two would mean the update
    # added a second entry under a different name instead of replacing the
    # first, and the client would read whichever it found -- possibly the old
    # one, which is the most confusing failure there is.
    _n=$(printf '%s\n' "$_entries" | grep -cx 'serverinfo.py')
    [ "$_n" = 1 ] || { fail "the zip has $_n top-level serverinfo.py entries, expected 1"; return 1; }

    _exe=$(printf '%s\n' "$_entries" | grep -iE '^metin2[^/]*\.exe$' | head -1)
    [ -n "$_exe" ] || { fail "there is no launcher .exe at the top level of the zip"; return 1; }
    ok "serverinfo.py sits next to $_exe -- which is the copy this client reads"

    # The two things players must never receive.
    if printf '%s\n' "$_entries" | grep -qi '^Eternexus/'; then
        fail "the Eternexus folder is still in the zip -- it holds the pack-building"
        fail "tool and every language's raw files, several hundred MB nobody needs"
        return 1
    fi
    if printf '%s\n' "$_entries" | grep -qi 'ClientVS22'; then
        fail "ClientVS22.zip -- the client's C++ SOURCE -- is in the zip. Refusing to"
        fail "publish it: that is what a cheat client would be built from."
        return 1
    fi
    ok "the source archive and the Eternexus tool folder are not in it"

    _si=$(unzip -p "$BUILT" serverinfo.py 2>/dev/null)
    printf '%s\n' "$_si" | grep -q "^SERVER_IP  *= *\"$ADDRESS\"" \
        || { fail "serverinfo.py in the zip does not carry SERVER_IP = \"$ADDRESS\""; return 1; }
    # Counted on "udp_port", which only the channel entries have. "tcp_port"
    # would also match MARKADDR_DICT and report one channel too many.
    _ch=$(printf '%s\n' "$_si" | grep -c '"udp_port"')
    [ "$_ch" = "$CHANNELS_WANT" ] \
        || { fail "serverinfo.py lists $_ch channel(s) but $CHANNELS_WANT were asked for"; return 1; }
    ok "it says $ADDRESS and lists $_ch channel(s) -- exactly the ones that are running"
    return 0
}

publish() {
    step "Handing it to the panel"

    [ -d "$OUT_DIR" ] || die "$OUT_DIR does not exist in this container." \
        "The panel's data volume should be mounted there. Check the" \
        "client-builder service's volumes in docker-compose.yml."

    _need_mb=$(( $(fsize "$BUILT") / 1048576 + 200 ))
    check_space "$_need_mb" "$OUT_DIR" "the copy in the panel's volume"

    # Written under a dotted name and renamed at the end. Until that rename the
    # panel sees no client.zip at all and keeps telling players the download is
    # not ready, which is the truth. A file called client.zip that is still
    # being written would be served to them as a broken game.
    rm -f "$OUT_TMP"
    heartbeat_start "copying to the panel" "$OUT_TMP" "$(fsize "$BUILT")"
    supervised cp "$BUILT" "$OUT_TMP" || { heartbeat_stop; die "Could not copy the client into $OUT_DIR"; }
    heartbeat_stop
    sync

    [ "$(fsize "$OUT_TMP")" = "$(fsize "$BUILT")" ] \
        || die "The copy in $OUT_DIR came out a different size than the original -- not publishing it."

    # The panel runs as an unprivileged user and rewrites downloads.db in this
    # directory; owning the file it serves keeps that consistent.
    chown "$PANEL_UID:$PANEL_GID" "$OUT_TMP" 2>/dev/null || true
    chmod 0644 "$OUT_TMP" 2>/dev/null || true

    mv -f "$OUT_TMP" "$OUT" || die "Could not put the client in place at $OUT"
    sync
    ok "published: $OUT ($(human "$(fsize "$OUT")"))"
}

# ---------------------------------------------------------------------------
#  Subcommands
# ---------------------------------------------------------------------------
cmd_status() {
    say "cache          $CACHE"
    _c=$(cached_archive)
    if [ -n "$_c" ]; then
        say "archive        $(basename "$_c")  $(human "$(fsize "$_c")")"
    else
        _p=$(find "$ARCHIVE_DIR" -maxdepth 1 -name '.megatmp.*' -type f 2>/dev/null | head -1)
        if [ -n "$_p" ]; then
            say "archive        an interrupted download, $(human "$(fsize "$_p")") so far (it will resume)"
        else
            say "archive        not downloaded"
        fi
    fi
    if [ -f "$BUILT" ]; then
        say "built client   $(human "$(fsize "$BUILT")")"
        if [ -f "$STAMP" ]; then
            say "               $(awk -F= '$1=="address"{print "address " $2}' "$STAMP")," \
                "$(awk -F= '$1=="channels"{print $2}' "$STAMP") channel(s), built $(awk -F= '$1=="when"{print $2}' "$STAMP")"
        fi
    else
        say "built client   not built yet"
    fi
    if [ -f "$OUT" ]; then
        say "panel copy     $OUT  $(human "$(fsize "$OUT")")"
    else
        say "panel copy     not published -- the panel is saying the download is not ready"
    fi
    say "free space     $(free_mb "$CACHE") MB on the cache, $(free_mb "$OUT_DIR") MB on the panel volume"
    [ -f "$PACK" ] && say "profile        $(md5sum "$PACK" | awk '{print $1}')  $PACK"
    return 0
}

cmd_clean() {
    say "removing the cache: the archive, the built client and the log"
    rm -rf "$ARCHIVE_DIR" "$WORK_DIR" "$BUILT" "$META" "$STAMP" "$LOG"
    say "done. The copy the panel is serving ($OUT) was NOT touched."
    say "The next build downloads the archive again."
    return 0
}

cmd_build() {
    check_tools
    check_settings
    load_pack

    step "Metin2 client for $ADDRESS"
    note "  server name    ${PACK_SERVER_NAME:-${PACK_NAME:-Metin2}}"
    note "  login port     $AUTH_PORT_WANT"
    note "  channels       $CHANNELS_WANT"
    note "  publishing to  $OUT"

    if [ "$FORCE" = "rebuild" ] || [ "$FORCE" = "redownload" ]; then
        [ -f "$BUILT" ] && { note "  M2_CLIENT_FORCE=$FORCE -- discarding the built client"; rm -f "$BUILT"; }
    fi

    if [ -f "$BUILT" ] && unzip -l "$BUILT" >/dev/null 2>&1; then
        ok "the client is already built -- only the address has to be written"
    else
        if [ -f "$BUILT" ]; then
            warn "the cached client.zip cannot be read; building it again"
            rm -f "$BUILT"
        fi
        step "Getting the server files"
        acquire_archive
        build_client
    fi

    patch_address
    patch_language

    if ! verify_built; then
        die "The finished client did not pass its checks, so it was NOT given to the panel." \
            "Whatever the panel is serving now is untouched." \
            "Build it again from scratch with:" \
            "  M2_CLIENT_FORCE=rebuild docker compose run --rm client-builder"
    fi

    publish

    note ""
    note "  Players can download it from the panel's login page now."
    note "  The panel reads the file's size and checksum once, when it starts, so"
    note "  restart it if you want those shown on the page:"
    note "      docker compose restart panel"
    note ""
    note "  Changing the address later costs seconds, not another download:"
    note "      M2_CLIENT_ADDRESS=1.2.3.4 docker compose run --rm client-builder"
    return 0
}

# ---------------------------------------------------------------------------
mkdir -p "$CACHE" 2>/dev/null
{ : >>"$LOG"; } 2>/dev/null || LOG=/dev/null

case "${1:-build}" in
    build)  cmd_build ;;
    status) cmd_status ;;
    clean)  cmd_clean ;;
    -h|--help|help)
        sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        fail "Unknown command: $1"
        say "Use one of: build (the default), status, clean"
        exit 2
        ;;
esac
