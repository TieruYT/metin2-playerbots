#!/bin/bash
# =============================================================================
#  m2-render-config -- materialise the core tree on the state volume and write
#                      every CONFIG / conf.txt from the environment.
#
#  Runs on every container start.  The core directories themselves live on the
#  state volume; everything they need from the image is reached through an
#  ABSOLUTE symlink into /opt/metin2/share.  (The shipped tree uses relative
#  symlinks -- ../../share/bin/game -- which only resolve at their original
#  depth and quietly break the moment a core is moved.)
#
#  Configuration files are rewritten every boot: they are derived state, not
#  operator state, so an .env change takes effect on `docker compose up -d'
#  with nothing to migrate.  The things players create -- guild marks, logs --
#  are never touched after first run.
# =============================================================================
set -euo pipefail

log() { printf '%s [config] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$*"; }

SHARE_DIR="${M2_SHARE_DIR:-/opt/metin2/share}"
VAR_DIR="${M2_VAR_DIR:-/opt/metin2/var}"

# -----------------------------------------------------------------------------
# Addressing.
#
# Three addresses are distinct in a container and the ported config.cpp keeps
# them apart (see the LINUX-BLOCK comments in game/src/config.{h,cpp}):
#
#   listen  what bind() gets.  0.0.0.0, because a container's address is not
#           known until it starts and Docker publishes ports by DNAT to it.
#   public  this core's own identity: p2p peer check, GD_BOOT/GD_SETUP.  Left
#           to auto-detection, which yields the container's own address -- the
#           right answer, since every core is in this container.
#   proxy   what clients are told to connect to for the channel servers.  This
#           is the one that must be the operator's public address, and the one
#           whose absence produces "login works, entering the world hangs".
# -----------------------------------------------------------------------------
CONTAINER_IP="$(getent hosts "$(hostname)" 2>/dev/null | awk '{print $1; exit}')"
[ -n "$CONTAINER_IP" ] || CONTAINER_IP="127.0.0.1"

is_ipv4() {
  local o IFS=.
  # shellcheck disable=SC2206
  local parts=($1)
  [ "${#parts[@]}" = 4 ] || return 1
  for o in "${parts[@]}"; do
    [[ "$o" =~ ^[0-9]+$ ]] || return 1
    [ "$o" -le 255 ] || return 1
  done
  return 0
}

# PROXY_IP takes either form: a literal address is used as-is, a hostname is
# resolved by config.cpp at load time (with the ported NULL guard, so a name
# that does not resolve is a warning rather than a startup crash).
PROXY_LINE=""
if [ -n "${M2_PUBLIC_ADDRESS:-}" ]; then
  PROXY_LINE="PROXY_IP: ${M2_PUBLIC_ADDRESS}"
  if is_ipv4 "$M2_PUBLIC_ADDRESS"; then
    log "advertising ${M2_PUBLIC_ADDRESS} to clients (literal address)"
  else
    log "advertising ${M2_PUBLIC_ADDRESS} to clients (resolved at core startup)"
  fi
fi

# BIND_IP: 0.0.0.0 is the wildcard path the port added; it sets the bind
# address alone and leaves this core's identity to auto-detection.  Any other
# value goes through LISTEN_IP, which does not carry BIND_IP's legacy double
# meaning of "bind here AND this is who I am".
if [ "${M2_BIND_IP:-0.0.0.0}" = "0.0.0.0" ]; then
  BIND_LINE="BIND_IP: 0.0.0.0"
else
  BIND_LINE="LISTEN_IP: ${M2_BIND_IP}"
fi

# desc_p2p.cpp's port-security test accepts a p2p connection only from this
# core's own public address.  Every core here shares the container's address so
# that already holds; the allowlist is written anyway so that an operator who
# pins M2_PUBLIC_IP to the VPS address does not silently break core-to-core
# traffic.  The token is additive -- it never removes the default peer.
P2P_ALLOW_LINE="P2P_ALLOW_IP: 127.0.0.1 ${CONTAINER_IP}"

# The game cores' *_SQL lines take an optional fifth field, the port:
#   PLAYER_SQL: <host> <user> <password> <database> [port]
# (config.cpp parses it with two_arguments/two_arguments/one_argument.)  The db
# core's conf.txt takes the port too, but in a different field order -- see
# render_db.  Both are written explicitly so M2_DB_PORT actually works.

# -----------------------------------------------------------------------------
# Map distribution.
#
# Do not merge these into one core.  Serving all 41 maps from a single game
# core pushes its main loop past the client handshake's 50 ms tolerance and NO
# client can connect -- while the idle auth core keeps answering, which makes
# it look like a protocol bug rather than a load problem.  The shipped 3-core
# split (~320/300/240 MB resident) is the tested layout.
# -----------------------------------------------------------------------------
# Keep the complete Chunjo progression path (M1 -> M2 -> easy Monkey Dungeon)
# on one core. Server-side playerbots have no real client process that could
# reconnect after a cross-core HEADER_GC_WARP, so splitting map 23 from maps 21
# and 25 would strand them at the portal. The total map count per core stays
# balanced (14/14/13).
MAPS_first="1 4 5 6 3 43 112 107 67 68 72 208 302 304"
MAPS_game1="21 23 24 25 26 108 61 63 69 70 73 216 217 303"
MAPS_game2="41 44 45 46 109 62 64 65 66 71 104 301 351"

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------

# link_into <target-under-share> <link-path>
link_into() { ln -sfn "$SHARE_DIR/$1" "$2"; }

# core_skeleton <dir>  -- directories and links every core needs
core_skeleton() {
  local d="$1"
  mkdir -p "$d/log" "$d/cores"
  link_into data    "$d/data"
  link_into locale  "$d/locale"
  link_into package "$d/package"
}

# -----------------------------------------------------------------------------
# db core
# -----------------------------------------------------------------------------
render_db() {
  local d="$VAR_DIR/db"
  mkdir -p "$d/log" "$d/cores"
  ln -sfn "$SHARE_DIR/bin/db" "$d/db"
  for f in item_proto.txt mob_proto.txt item_names.txt mob_names.txt; do
    link_into "conf/$f" "$d/$f"
  done

  # BIND_IP is deliberately absent: ClientManager.cpp defaults it to 127.0.0.1,
  # which is exactly right here.  The db core is the one thing in this stack
  # that must never be reachable from outside -- it speaks an unauthenticated
  # protocol, and a client that can reach it can rewrite any character.
  # Everything that talks to it is in this container.
  # Field order here is "host database user password port" -- note that it is
  # NOT the order the game cores use ("host user password database"). Getting
  # them the same way round produces an authentication failure that reads like
  # a wrong password.
  #
  # Config.cpp's GetWord() writes into a 256-byte buffer with no bounds check
  # at all, so a very long password is a stack smash rather than an error.
  # M2_DB_PASSWORD is length-checked in the entrypoint for that reason.
  cat > "$d/conf.txt" <<EOF
BIND_PORT = ${M2_DB_CORE_PORT}
SQL_ACCOUNT = "${M2_DB_HOST} account ${M2_DB_USER} ${M2_DB_PASSWORD} ${M2_DB_PORT}"
SQL_COMMON = "${M2_DB_HOST} common ${M2_DB_USER} ${M2_DB_PASSWORD} ${M2_DB_PORT}"
SQL_HOTBACKUP = "${M2_DB_HOST} hotbackup ${M2_DB_USER} ${M2_DB_PASSWORD} ${M2_DB_PORT}"
SQL_PLAYER = "${M2_DB_HOST} player ${M2_DB_USER} ${M2_DB_PASSWORD} ${M2_DB_PORT}"
TABLE_POSTFIX = "${M2_TABLE_POSTFIX}"
DB_SLEEP_MSEC = 10
CLIENT_HEART_FPS = 10
HASH_PLAYER_LIFE_SEC = 600
PLAYER_DELETE_LEVEL_LIMIT = ${M2_PLAYER_DELETE_LEVEL_LIMIT}
PLAYER_ID_START = 3
BACKUP_LIMIT_SEC = 3600
WELCOME_MSG = "DB Server has been started"
ITEM_ID_RANGE = 10000001 20000000
TEST_SERVER = ${M2_TEST_SERVER}
EOF
}

# -----------------------------------------------------------------------------
# auth core
#
# The auth core IS the game binary, installed under the name `auth'.  Note the
# PLAYER_SQL line points at the *account* database here, not `player' -- auth
# authenticates, it does not load characters.
# -----------------------------------------------------------------------------
render_auth() {
  local d="$VAR_DIR/auth"
  core_skeleton "$d"
  ln -sfn "$SHARE_DIR/bin/game" "$d/auth"

  cat > "$d/CONFIG" <<EOF
CHANNEL: 1
HOSTNAME: Auth01
PORT: ${M2_AUTH_PORT}
P2P_PORT: ${M2_AUTH_P2P_PORT}
DB_ADDR: 127.0.0.1
DB_PORT: ${M2_DB_CORE_PORT}
PLAYER_SQL: ${M2_DB_HOST} ${M2_DB_USER} ${M2_DB_PASSWORD} account ${M2_DB_PORT}
COMMON_SQL: ${M2_DB_HOST} ${M2_DB_USER} ${M2_DB_PASSWORD} common ${M2_DB_PORT}
LOG_SQL: ${M2_DB_HOST} ${M2_DB_USER} ${M2_DB_PASSWORD} log ${M2_DB_PORT}
TABLE_POSTFIX: ${M2_TABLE_POSTFIX}
PASSES_PER_SEC: 25
LOG_KEEP_DAYS: ${M2_LOG_KEEP_DAYS}
PING_EVENT_SECOND_CYCLE: 180
ADMINPAGE_PASSWORD: ${M2_ADMINPAGE_PASSWORD}
ADMINPAGE_IP: ${M2_ADMINPAGE_IP}
AUTH_SERVER: master
TRAFFIC_PROFILE:
TEST_SERVER: ${M2_TEST_SERVER}
${BIND_LINE}
${P2P_ALLOW_LINE}
${PROXY_LINE}
EOF
}

# -----------------------------------------------------------------------------
# a channel game core
#   render_game <channel> <role: first|game1|game2>
# -----------------------------------------------------------------------------
render_game() {
  local ch="$1" role="$2"
  local d="$VAR_DIR/channel${ch}/${role}"
  local base=$(( 13000 + (ch - 1) * 10 ))
  local p2pbase=$(( 14000 + (ch - 1) * 10 ))
  local offset hostname maps

  case "$role" in
    first) offset=0; hostname="first"; maps="$MAPS_first" ;;
    game1) offset=1; hostname="Game1"; maps="$MAPS_game1" ;;
    game2) offset=2; hostname="Game2"; maps="$MAPS_game2" ;;
    *) echo "unknown role $role" >&2; return 1 ;;
  esac

  core_skeleton "$d"
  ln -sfn "$SHARE_DIR/bin/game" "$d/game"
  link_into conf/CMD "$d/CMD"

  # Guild marks are player-created content.  Seed once, then never touch.
  if [ ! -d "$d/mark" ]; then
    mkdir -p "$d/mark"
    cp -a "$SHARE_DIR/mark-default/." "$d/mark/" 2>/dev/null || true
  fi

  # The CONFIG parser reads lines with fgets(buf, 256, fp); the longest line
  # below (MAP_ALLOW) is well inside that.  Merging channels' map lists would
  # not be -- see the warning above the MAPS_* definitions.
  cat > "$d/CONFIG" <<EOF
CHANNEL: ${ch}
HOSTNAME: ${hostname}
PORT: $(( base + offset ))
P2P_PORT: $(( p2pbase + offset ))
DB_ADDR: 127.0.0.1
DB_PORT: ${M2_DB_CORE_PORT}
MAP_ALLOW: ${maps}
PLAYER_SQL: ${M2_DB_HOST} ${M2_DB_USER} ${M2_DB_PASSWORD} player ${M2_DB_PORT}
COMMON_SQL: ${M2_DB_HOST} ${M2_DB_USER} ${M2_DB_PASSWORD} common ${M2_DB_PORT}
LOG_SQL: ${M2_DB_HOST} ${M2_DB_USER} ${M2_DB_PASSWORD} log ${M2_DB_PORT}
TABLE_POSTFIX: ${M2_TABLE_POSTFIX}
PASSES_PER_SEC: 25
LOG_KEEP_DAYS: ${M2_LOG_KEEP_DAYS}
SAVE_EVENT_SECOND_CYCLE: 180
PING_EVENT_SECOND_CYCLE: 180
VIEW_RANGE: 8000
CHECK_MULTIHACK: 0
ADMINPAGE_PASSWORD: ${M2_ADMINPAGE_PASSWORD}
ADMINPAGE_IP: ${M2_ADMINPAGE_IP}
SPEEDHACK_LIMIT_COUNT: 300
SPEEDHACK_LIMIT_BONUS: 80
PK_PROTECT_LEVEL: 15
MALL_URL: ${M2_MALL_URL}
TRAFFIC_PROFILE:
TEST_SERVER: ${M2_TEST_SERVER}
MAX_LEVEL: ${M2_MAX_LEVEL}
${BIND_LINE}
${P2P_ALLOW_LINE}
${PROXY_LINE}
EOF
}

# -----------------------------------------------------------------------------
# Render everything, and write the boot plan the supervisor follows.
#
# The plan is an ordered file rather than logic inside the supervisor so that
# `docker compose exec game cat /opt/metin2/var/boot-plan' answers "what is
# supposed to be running, in what order, on what port".
#
# Order is not cosmetic: every core dials 127.0.0.1:<db port> during boot and
# gives up if nothing answers, so db must be listening before anything else
# starts.  auth follows, then the channel cores.
# -----------------------------------------------------------------------------
mkdir -p "$VAR_DIR"
PLAN="$VAR_DIR/boot-plan"
: > "$PLAN"

render_db
# name|dir|argv0|readiness-port|kind
printf 'db|%s/db|db|%s|db\n' "$VAR_DIR" "$M2_DB_CORE_PORT" >> "$PLAN"

render_auth
printf 'auth|%s/auth|auth|%s|auth\n' "$VAR_DIR" "$M2_AUTH_PORT" >> "$PLAN"

for ch in $(seq 1 "${M2_CHANNELS}"); do
  for role in first game1 game2; do
    render_game "$ch" "$role"
    case "$role" in first) off=0 ;; game1) off=1 ;; game2) off=2 ;; esac
    printf 'ch%s-%s|%s/channel%s/%s|game|%s|game\n' \
      "$ch" "$role" "$VAR_DIR" "$ch" "$role" "$(( 13000 + (ch - 1) * 10 + off ))" >> "$PLAN"
  done
done

log "rendered $(wc -l < "$PLAN") cores across ${M2_CHANNELS} channel(s)"
log "listen=${M2_BIND_IP:-0.0.0.0} container=${CONTAINER_IP} advertised=${M2_PUBLIC_ADDRESS:-<unset>}"

# The rendered CONFIGs contain the database password.  They are on a private
# volume, but there is no reason for them to be world-readable.
chmod 0640 "$VAR_DIR"/db/conf.txt "$VAR_DIR"/auth/CONFIG 2>/dev/null || true
find "$VAR_DIR" -name CONFIG -type f -exec chmod 0640 {} + 2>/dev/null || true
