#!/bin/sh
# =============================================================================
#  m2-lang -- the language the game speaks, container side.
#
#  The pack ships every text the server sends a player in fifteen languages,
#  and switching between them is a matter of putting the right file in the
#  right place.  Languages.txt in the reference server files says to rename
#  four of them by hand:
#
#      share/conf/item_names.txt           <- item_names_XY.txt
#      share/conf/mob_names.txt            <- mob_names_XY.txt
#      share/locale/*/translate.lua        <- translate_XY.lua
#      share/locale/*/locale_string.txt    <- locale_string_XY.txt
#
#  That is what this does, from the panel instead of over SSH.
#
#  Two things had to be checked before trusting it, and both hold on this
#  build:
#
#    * The files are really read.  The db core loads item_names.txt and
#      mob_names.txt at boot and fills its item and mob tables from them
#      (db/src/ClientManagerBoot.cpp), and the game core loads translate.lua at
#      boot -- "LoadTranslate(locale/english/translate.lua), returns 0" is in
#      every core's syslog.
#    * Quests do NOT have to be recompiled, which Languages.txt warns about.
#      That warning is for a tree built from quest sources; translate.lua and
#      locale_string.txt are read at runtime, and our quest objects are already
#      compiled into the image.
#
#  What is deliberately NOT done here is the other half of Languages.txt:
#  renaming share/locale/english to share/locale/germany and changing
#  common.locale.  That changes LC_GetLocalType(), which drives character-name
#  validation, the text encoding, PK_PROTECT_LEVEL and the branch in
#  gm_new_get_level() that the panel's game master ranks depend on -- and it
#  buys nothing for a language change, because every string above lives inside
#  the english directory whatever it is called.
#
#  This only covers what the SERVER says.  The client's own menus and item
#  names come out of its pack/locale_XY.epk, chosen by the locale.cfg sitting
#  next to the .exe; m2-client-build writes that one to match, and a player who
#  already downloaded the client renames one file.  The panel explains it.
#
#  Update safety works exactly as it does for the rates: the files live in the
#  image and come back shipped-as-new whenever the container is recreated, so
#  what the operator asked for is kept on the state volume and re-applied
#  before the cores read anything.
#
#      panel container                   game container (this file)
#      ---------------                   --------------------------
#      writes $SPOOL/lang.request ---->  m2-lang poll   (every 5s)
#                                          |
#                                          v
#                                        m2-lang apply  (copies four files)
#                                          |
#                                          v
#                                        m2-supervise stops and starts the
#                                        cores, which read them at boot
#                                          |
#      reads  $SPOOL/lang.status  <------ m2-lang publish
#
#  Subcommands
#      prepare        as root at container start: state directory ownership
#      languages      the codes this pack can actually offer, one per line
#      apply          put the wanted language's files in place
#      poll           new request from the panel?  exit 10 = yes, apply it
#      publish [S M]  write the status file the panel reads
# =============================================================================
set -u
LC_ALL=C
export LC_ALL

SHARE_DIR="${M2_SHARE_DIR:-/opt/metin2/share}"
VAR_DIR="${M2_VAR_DIR:-/opt/metin2/var}"
SPOOL="${M2_RATES_SPOOL:-/opt/m2spool}"

STATE_DIR="$VAR_DIR/lang"
WANTED="$STATE_DIR/wanted"        # the code the operator asked for, kept forever
LAST_ID="$STATE_DIR/last-id"      # the request already dealt with
RESULT="$STATE_DIR/last-result"   # how the last apply went

REQUEST="$SPOOL/lang.request"
STATUS="$SPOOL/lang.status"

LOG="${M2_LANG_LOG:-/var/log/m2lang.log}"
if ! { : >>"$LOG"; } 2>/dev/null; then
    LOG="$STATE_DIR/apply.log"
    mkdir -p "$STATE_DIR" 2>/dev/null
    { : >>"$LOG"; } 2>/dev/null || LOG=/dev/null
fi

say()  { printf '%s [lang] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$1"; }
note() { say "$1"; say "$1" >>"$LOG" 2>/dev/null; }
ok()   { note "  [ ok ] $1"; }
warn() { note "  [ !! ] $1"; }
fail() { note "  [ XX ] $1"; }

kv() { sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1; }

# The locale directory. Only one ships, and it is called `english' whatever
# language is inside it -- see the note about not renaming it, above. Found
# rather than hardcoded so a tree that was renamed by hand still works.
locale_dir() {
    _d=$(find "$SHARE_DIR/locale" -maxdepth 2 -type f -name translate.lua 2>/dev/null | head -1)
    [ -n "$_d" ] && dirname "$_d"
}

# The four files, as "active-path variant-prefix variant-suffix" triples.
# Printed rather than held in an array because this is /bin/sh.
targets() {
    _loc=$(locale_dir)
    printf '%s\n' "$SHARE_DIR/conf/item_names.txt|item_names_|.txt"
    printf '%s\n' "$SHARE_DIR/conf/mob_names.txt|mob_names_|.txt"
    [ -n "$_loc" ] || return 0
    printf '%s\n' "$_loc/translate.lua|translate_|.lua"
    printf '%s\n' "$_loc/locale_string.txt|locale_string_|.txt"
}

# A language is on offer only when EVERY one of the four files exists for it.
# Half a language is worse than none: the operator would get German quests and
# English item names and no way to tell which half failed.
cmd_languages() {
    # `en' first and always: it is not a variant file, the plain shipped file
    # IS English, so it is available whenever the server files are.
    printf 'en\n'
    # Every other code is a candidate only if it has all four files, which
    # have_language is the one place that decides.
    ls "$SHARE_DIR/conf" 2>/dev/null \
        | sed -n 's/^item_names_\(..\)\.txt$/\1/p' | sort -u \
        | while read -r _c; do
              have_language "$_c" && printf '%s\n' "$_c"
          done
}

# Is this code one we can actually deliver, in full?
have_language() {
    [ "$1" = "en" ] && return 0
    targets | while IFS='|' read -r active prefix suffix; do
        [ -f "$(dirname "$active")/${prefix}$1${suffix}" ] || exit 1
    done
}

cmd_prepare() {
    mkdir -p "$STATE_DIR" 2>/dev/null
    chown metin2:metin2 "$STATE_DIR" 2>/dev/null

    # A recreated game-var volume has no remembered panel choice. Previously
    # that silently selected the English files baked into the image, which is
    # why Polish worlds started showing English monster names after a restore.
    # Persist an explicit deployment default once; later panel choices still
    # win because an existing WANTED file is never overwritten here.
    if [ ! -s "$WANTED" ]; then
        _default=$(printf '%s' "${M2_DEFAULT_GAME_LANGUAGE:-en}" | tr -d ' \r\n')
        case "$_default" in
            [a-z][a-z]) : ;;
            *) warn "M2_DEFAULT_GAME_LANGUAGE='$_default' is invalid; using en"
               _default=en ;;
        esac
        if ! have_language "$_default"; then
            warn "these server files do not carry the default '$_default'; using en"
            _default=en
        fi
        printf '%s\n' "$_default" > "$WANTED" 2>/dev/null \
            || warn "could not persist the default language '$_default'"
    fi
    chown metin2:metin2 "$WANTED" 2>/dev/null
    chmod 0640 "$WANTED" 2>/dev/null
    if [ "$LOG" != /dev/null ] && [ -f "$LOG" ]; then
        chown metin2:metin2 "$LOG" 2>/dev/null
        chmod 0640 "$LOG" 2>/dev/null
    fi
    # The four active files and the directories holding them: this runs as the
    # service account and has to be able to replace them in place.
    targets | while IFS='|' read -r active _p _s; do
        chown metin2:metin2 "$active" "$(dirname "$active")" 2>/dev/null
    done
    return 0
}

write_status() {
    _tmp="$STATUS.new.$$"
    { printf 'state=%s\n' "$1"
      printf 'lang=%s\n' "${2:-}"
      printf 'time=%s\n' "$(date +%s 2>/dev/null)"
      printf 'message=%s\n' "${3:-}"
    } > "$_tmp" 2>/dev/null || { rm -f "$_tmp"; return 1; }
    # Group-writable: the panel account overwrites it when somebody saves.
    chmod 0660 "$_tmp" 2>/dev/null
    mv "$_tmp" "$STATUS" 2>/dev/null || { rm -f "$_tmp"; return 1; }
    return 0
}

remember_result() {
    mkdir -p "$STATE_DIR" 2>/dev/null
    { printf 'state=%s\n' "$1"; printf 'lang=%s\n' "$2"; printf 'message=%s\n' "$3"; } \
        > "$RESULT.new" 2>/dev/null && mv "$RESULT.new" "$RESULT" 2>/dev/null
    return 0
}

# ---------------------------------------------------------------------------
#  apply -- put the wanted language's four files in place
# ---------------------------------------------------------------------------
cmd_apply() {
    [ -f "$WANTED" ] || return 0
    _want=$(cat "$WANTED" 2>/dev/null | tr -d ' \r\n')
    [ -n "$_want" ] || return 0

    case "$_want" in
        [a-z][a-z]) : ;;
        *) fail "'$_want' is not a language code -- nothing was changed"
           remember_result failed "$_want" "not a language code"
           write_status failed "$_want" "not a language code"
           return 1 ;;
    esac

    if ! have_language "$_want"; then
        fail "these server files carry no complete '$_want' -- nothing was changed"
        remember_result unsupported "$_want" "these server files do not carry that language"
        write_status unsupported "$_want" "these server files do not carry that language"
        return 2
    fi

    note "== Putting the game into '$_want'"

    # Every copy is made beside the target and moved over it, so a failure
    # halfway through cannot leave the server with a truncated item_names.txt
    # -- which the db core reads at boot and would take very badly.
    _failed=0
    targets | while IFS='|' read -r active prefix suffix; do
        _dir=$(dirname "$active")
        _base="$active.m2orig"

        # The shipped file is the English one, and it is the only copy of it:
        # there is no item_names_en.txt in the pack. Kept aside the first time
        # anything is replaced, so switching back is possible without pulling
        # the image again.
        if [ ! -f "$_base" ]; then
            cp -p "$active" "$_base" 2>/dev/null \
                || { fail "could not keep a copy of $(basename "$active")"; exit 1; }
        fi

        if [ "$_want" = "en" ]; then
            _src="$_base"
        else
            _src="$_dir/${prefix}${_want}${suffix}"
        fi

        if ! cp -p "$_src" "$active.new" 2>/dev/null; then
            fail "could not read $(basename "$_src")"; exit 1
        fi
        if ! mv "$active.new" "$active" 2>/dev/null; then
            rm -f "$active.new"
            fail "could not replace $(basename "$active")"; exit 1
        fi
        ok "$(basename "$active") <- $(basename "$_src")"
    done || _failed=1

    if [ "$_failed" = "1" ]; then
        remember_result failed "$_want" "the language files could not be replaced"
        write_status failed "$_want" "the language files could not be replaced"
        return 1
    fi

    # Not live yet: the cores read these while they start. The supervisor
    # publishes once they are back up.
    remember_result ok "$_want" "the game is now in this language"
    return 0
}

# ---------------------------------------------------------------------------
#  poll -- has the panel asked for a different language?
# ---------------------------------------------------------------------------
# Exit codes:  0  nothing to do
#             10  a new request was staged; the caller has to apply it and
#                 restart the cores
# ---------------------------------------------------------------------------
cmd_poll() {
    [ -f "$REQUEST" ] || return 0

    _id=$(kv "$REQUEST" id)
    [ -n "$_id" ] || return 0
    _seen=""
    [ -f "$LAST_ID" ] && _seen=$(cat "$LAST_ID" 2>/dev/null)
    [ "$_id" = "$_seen" ] && return 0

    _lang=$(kv "$REQUEST" lang | tr -d ' \r\n')

    # Remember the id before acting on it: a request that cannot be used is a
    # request that must not be read again on every five-second tick.
    mkdir -p "$STATE_DIR" 2>/dev/null
    printf '%s\n' "$_id" > "$LAST_ID" 2>/dev/null

    case "$_lang" in
        [a-z][a-z]) : ;;
        *) fail "the panel sent '$_lang', which is not a language code"
           write_status failed "$_lang" "the panel sent something that is not a language code"
           return 0 ;;
    esac

    if ! have_language "$_lang"; then
        warn "the panel asked for '$_lang', which these server files do not carry"
        write_status unsupported "$_lang" "these server files do not carry that language"
        return 0
    fi

    _now=""
    [ -f "$WANTED" ] && _now=$(cat "$WANTED" 2>/dev/null | tr -d ' \r\n')
    if [ "$_lang" = "$_now" ]; then
        # Already there. Say so rather than restarting the server for nothing.
        write_status ok "$_lang" "the game is already in this language"
        return 0
    fi

    printf '%s\n' "$_lang" > "$WANTED" 2>/dev/null || {
        fail "could not record the wanted language"
        write_status failed "$_lang" "the wanted language could not be recorded"
        return 0
    }
    write_status running "$_lang" "the language is being applied"
    return 10
}

cmd_publish() {
    _state="${1:-}"
    _msg="${2:-}"
    _lang=""
    [ -f "$WANTED" ] && _lang=$(cat "$WANTED" 2>/dev/null | tr -d ' \r\n')
    [ -n "$_lang" ] || _lang="en"
    if [ -z "$_state" ] && [ -f "$RESULT" ]; then
        _state=$(kv "$RESULT" state)
        _msg=$(kv "$RESULT" message)
    fi
    [ -n "$_state" ] || _state=ok
    write_status "$_state" "$_lang" "$_msg"
}

case "${1:-}" in
    prepare)   cmd_prepare ;;
    languages) cmd_languages ;;
    apply)     cmd_apply ;;
    poll)      cmd_poll ;;
    publish)   shift; cmd_publish "$@" ;;
    *)         printf 'usage: m2-lang prepare|languages|apply|poll|publish\n' >&2; exit 2 ;;
esac
